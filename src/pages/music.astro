---
import BackHomeLink from "../components/BackHomeLink.astro";
import MusicPlayer from "../components/MusicPlayer.astro";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { parseMusic } from "../utils/music";
import musicSource from "../data/music.md?raw";

const tracks = parseMusic(musicSource);
---

<MainGridLayout title="音乐" description="我的音乐收藏">
	<BackHomeLink />
	<MusicPlayer tracks={tracks} />
</MainGridLayout>

