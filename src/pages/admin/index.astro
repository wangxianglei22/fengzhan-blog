---
import "@fontsource/roboto/400.css";
import "@fontsource/roboto/500.css";
import "@fontsource/roboto/700.css";
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="robots" content="noindex,nofollow" />
		<link rel="icon" href="/images/avatar.svg" type="image/svg+xml" />
		<title>博客后台管理</title>
		<script is:inline>
			// 在首帧前定好深浅色，避免刷新时闪白。
			(function () {
				try {
					var stored = localStorage.getItem("admin-theme");
					var dark =
						stored === "dark" ||
						(stored !== "light" && window.matchMedia("(prefers-color-scheme: dark)").matches);
					if (dark) document.documentElement.classList.add("admin-dark");
				} catch (error) {
					/* localStorage 不可用时按浅色处理 */
				}
			})();
		</script>
	</head>
	<body class="admin-page" data-no-swup>
		<main class="admin-shell">
			<header class="admin-header">
				<a class="admin-brand" href="/" aria-label="返回博客首页">
					<span class="admin-brand-mark"><svg viewBox="100 40 320 280" aria-hidden="true" focusable="false"><path d="M256 58C268 105 280 140 296 176L340 146 376 118 352 196 330 206 400 250 330 272 300 296 256 300 212 296 182 272 112 250 182 206 160 196 136 118 172 146 216 176C232 140 244 105 256 58Z" fill="currentColor" /></svg></span>
					<span><strong>枫栈</strong><small>CONTENT STUDIO</small></span>
				</a>
				<button class="admin-theme-toggle" type="button" data-action="toggle-theme"
					aria-label="切换深浅色" title="切换深浅色">
					<svg class="admin-theme-icon admin-theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2" /><path d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2M5.4 5.4l1.6 1.6M17 17l1.6 1.6M18.6 5.4 17 7M7 17l-1.6 1.6" /></svg>
					<svg class="admin-theme-icon admin-theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.6A8.9 8.9 0 0 1 9.4 3.5a8.9 8.9 0 1 0 11.1 11.1Z" /></svg>
				</button>
			</header>
			<admin-app>
				<div class="admin-loading">正在加载后台…</div>
			</admin-app>
		</main>
		<script is:inline>
			(function () {
				var root = document.documentElement;
				var media = window.matchMedia("(prefers-color-scheme: dark)");
				var button = document.querySelector("[data-action=toggle-theme]");
				if (!button) return;
				var apply = function (theme) {
					var dark = theme === "dark" || (theme !== "light" && media.matches);
					root.classList.toggle("admin-dark", dark);
					button.setAttribute("aria-pressed", dark ? "true" : "false");
				};
				var stored = null;
				try {
					stored = localStorage.getItem("admin-theme");
				} catch (error) {
					stored = null;
				}
				apply(stored || "auto");
				button.addEventListener("click", function () {
					var current = root.classList.contains("admin-dark") ? "dark" : "light";
					var next = current === "dark" ? "light" : "dark";
					try {
						localStorage.setItem("admin-theme", next);
					} catch (error) {
						/* ignore */
					}
					apply(next);
				});
				media.addEventListener("change", function () {
					try {
						if (!localStorage.getItem("admin-theme")) apply("auto");
					} catch (error) {
						apply("auto");
					}
				});
			})();
		</script>
	</body>
</html>

<script>
	import {
		createModuleRecord,
		getModuleFields,
		normalizeModuleRecords,
		parseModuleRecords,
		serializeModuleRecords,
		validateModuleRecords,
	} from "../../utils/admin-module-forms";
	import type { AdminModule, ModuleField, ModuleRecord } from "../../utils/admin-module-forms";

	type CollectionName = "posts" | "diary";
	type Entry = {
		collection: CollectionName;
		slug: string;
		sha?: string;
		title: string;
		date: string;
		updated: string;
		draft: boolean;
		hidden: boolean;
		description: string;
		image: string;
		tags: string[];
		category: string;
		lang: string;
		mood: string;
		moodLabel: string;
		excerpt: string;
		cover: string;
		pinned: boolean;
		body: string;
	};

	const today = () => new Date().toISOString().slice(0, 10);
	/**
 * 从 /audio/xxx.mp3 里取出文件名（用于删除音频文件）。
 * 只处理单层文件名，不接受目录跳转。
 */
const audioFileName = (url: string) => {
	const raw = String(url || "").trim();
	if (!raw.startsWith("/audio/")) return "";
	const name = decodeURIComponent(raw.slice("/audio/".length));
	if (!name || name.includes("/") || name.includes("\\") || name.includes("..")) return "";
	return name;
};

const escapeHtml = (value: unknown) => String(value ?? "").replace(/[&<>"']/g, (character) => ({
		"&": "&amp;",
		"<": "&lt;",
		">": "&gt;",
		'"': "&quot;",
		"'": "&#39;",
	}[character] || character));
	const tagsFromInput = (value: string) => value.split(/[,，]/).map((tag) => tag.trim()).filter(Boolean);
	const iconPaths: Record<string, string> = {
		home: '<path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1z"/>',
		posts: '<path d="M5 3h10l4 4v14H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"/><path d="M14 3v5h5M7 12h10M7 16h10"/>',
		diary: '<rect x="4" y="4" width="16" height="17" rx="2"/><path d="M8 2v4M16 2v4M4 9h16M8 13h3M8 17h6"/>',
		logout: '<path d="M10 4H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h5M15 16l4-4-4-4M8 12h11"/>',
		back: '<path d="m15 18-6-6 6-6"/>',
		plus: '<path d="M12 5v14M5 12h14"/>',
		trash: '<path d="M4 7h16M10 3h4M6 7l1 14h10l1-14M10 11v6M14 11v6"/>',
		link: '<path d="M10 13a5 5 0 0 0 7.1 0l2-2a5 5 0 0 0-7.1-7.1l-1.2 1.2M14 11a5 5 0 0 0-7.1 0l-2 2A5 5 0 0 0 12 20.1l1.2-1.2"/>',
		music: '<path d="M9 18V5l10-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="16" cy="16" r="3"/>',
		honors: '<path d="M8 4h8v4a4 4 0 0 1-8 0zM12 12v5M8 21h8M9 17h6"/><path d="M8 6H4v2a4 4 0 0 0 4 4M16 6h4v2a4 4 0 0 1-4 4"/>',
		guestbook: '<path d="M4 5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-7l-5 4v-4H6a2 2 0 0 1-2-2z"/><path d="M8 8h8M8 12h5"/>',
		friends: '<path d="M16 20a4 4 0 0 0-8 0"/><circle cx="12" cy="8" r="3"/><path d="M20 20a4 4 0 0 0-3-3.87M17 5.13a3 3 0 0 1 0 5.74M4 20a4 4 0 0 1 3-3.87M7 5.13a3 3 0 0 0 0 5.74"/>',
	};
	const icon = (name: string) => `<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${iconPaths[name]}</svg>`;
	const moodEmojis = ["😀", "😊", "😌", "🤍", "🥰", "😎", "🤔", "😴", "🥳", "😭", "😤", "😮", "🤗", "🙃", "🌈", "✨", "🌙", "☀️", "🍀", "🎧"];

	function emptyEntry(collection: CollectionName): Entry {
		return {
			collection,
			slug: "",
			title: "",
			date: today(),
			updated: "",
			draft: true,
			hidden: false,
			description: "",
			image: "",
			tags: [],
			category: "",
			lang: "",
			mood: "😊",
			moodLabel: "今天的心情",
			excerpt: "",
			cover: "",
			pinned: false,
			body: "",
		};
	}

	class AdminApp extends HTMLElement {
		private kind: CollectionName = "posts";
		private module: AdminModule | null = null;
		private items: Entry[] = [];
		private current: Entry | null = null;
		private dataSha = "";
		/** 模块表单的当前记录（结构化 key: value），保存时序列化回 markdown。 */
		private moduleRecords: ModuleRecord[] = [];
		/** 模块页顶栏的状态提示文字。 */
		private moduleState = "配置编辑";
		/** 模块页的提示 / 错误信息。 */
		private moduleNotice = "";
		/** 音频上传区的状态文字。 */
		private uploadStatus = "";
		/** 是否正在读取模块配置。 */
		private moduleLoading = false;
		private notice = "";
		private busy = false;

		connectedCallback() {
			if (this.dataset.ready === "true") return;
			this.dataset.ready = "true";
			this.addEventListener("click", this.handleClick);
			this.addEventListener("submit", this.handleSubmit);
			this.addEventListener("input", this.handleInput);
			void this.checkSession();
		}

		private async checkSession() {
			try {
				const response = await fetch("/api/admin/session", { credentials: "same-origin" });
				const data = await response.json() as { authenticated?: boolean };
				if (data.authenticated) {
					this.renderWorkspace();
					if (this.module) await this.loadModule();
					else await this.loadItems();
				} else {
					this.renderLogin();
				}
			} catch {
				this.renderLogin("后台接口暂时无法连接，请确认 Cloudflare Pages Functions 已部署。");
			}
		}

		private renderLogin(error = "") {
			this.innerHTML = `<section class="admin-auth-panel">
				<div class="admin-auth-icon"><svg viewBox="100 40 320 280" aria-hidden="true" focusable="false"><path d="M256 58C268 105 280 140 296 176L340 146 376 118 352 196 330 206 400 250 330 272 300 296 256 300 212 296 182 272 112 250 182 206 160 196 136 118 172 146 216 176C232 140 244 105 256 58Z" fill="currentColor" /></svg></div>
				<p class="admin-eyebrow">PRIVATE WORKSPACE</p>
				<h1>进入内容后台</h1>
				<p class="admin-muted">这里用于管理文章和日记，访客不会看到这个页面。</p>
				<form id="login-form" class="admin-login-form">
					<label>管理员密码<input name="password" type="password" autocomplete="current-password" placeholder="输入后台密码" required /></label>
					<button class="admin-primary-button" type="submit">登录后台 <span aria-hidden="true">→</span></button>
				</form>
				${error ? `<p class="admin-error">${escapeHtml(error)}</p>` : ""}
				<p class="admin-auth-hint">这里是私有编辑区，访客看不到。</p>
			</section>`;
		}

		private moduleTitle() {
			return this.module === "music" ? "\u97f3\u4e50" : this.module === "honors" ? "\u8363\u8a89\u5899" : this.module === "friends" ? "\u53cb\u94fe" : "\u7559\u8a00\u677f";
		}

		private moduleDescription() {
			return this.module === "music"
				? "\u7f16\u8f91\u6b4c\u5355\u3002"
				: this.module === "honors"
					? "\u7ef4\u62a4\u9875\u9762\u4e0a\u7684\u8363\u8a89\u8bb0\u5f55\u3002"
					: this.module === "friends"
						? "\u7f16\u8f91\u597d\u53cb\u7684\u4fe1\u606f\u3002"
						: "\u4fee\u6539\u7559\u8a00\u677f\u7684\u6807\u9898\u4e0e\u8bf4\u660e\u3002";
		}

		private contentSidebar() {
			return `<div class="admin-side-intro"><p class="admin-eyebrow">CONTENT STUDIO</p><div class="admin-side-title"><h1>${this.kind === "posts" ? "\u6587\u7ae0" : "\u65e5\u8bb0"}</h1><button class="admin-new-button" data-action="new" type="button" aria-label="\u65b0\u5efa\u5185\u5bb9" title="\u65b0\u5efa\u5185\u5bb9">${icon("plus")}</button></div></div>
				<div class="admin-list-heading"><span>\u5168\u90e8\u5185\u5bb9</span></div>
				<div class="admin-list" data-list><div class="admin-list-empty">\u6b63\u5728\u8bfb\u53d6\u5185\u5bb9\u2026</div></div>
				<div class="admin-sidebar-footer"><span class="admin-status-dot"></span><span>GitHub \u5185\u5bb9\u6e90</span></div>`;
		}

		private moduleSidebar() {
			return `<div class="admin-side-intro"><p class="admin-eyebrow">SITE MODULES</p><div class="admin-side-title"><h1>${this.moduleTitle()}</h1></div><p class="admin-module-sidebar-copy">${this.moduleDescription()}</p></div>
				<div class="admin-module-side-card"><span class="admin-module-side-icon">${icon(this.module || "music")}</span><strong>\u914d\u7f6e\u6587\u4ef6</strong><small>\u4fdd\u5b58\u540e\u63d0\u4ea4\u5230 GitHub</small></div>
				<div class="admin-sidebar-footer"><span class="admin-status-dot"></span><span>GitHub \u5185\u5bb9\u6e90</span></div>`;
		}

		private renderWorkspace() {
			this.innerHTML = `<section class="admin-workspace">
				<aside class="admin-rail" aria-label="\u540e\u53f0\u5bfc\u822a">
					<button class="admin-rail-button ${!this.module && this.kind === "posts" ? "is-active" : ""}" data-kind="posts" type="button" aria-label="\u6587\u7ae0" title="\u6587\u7ae0">${icon("posts")}</button>
					<button class="admin-rail-button ${!this.module && this.kind === "diary" ? "is-active" : ""}" data-kind="diary" type="button" aria-label="\u65e5\u8bb0" title="\u65e5\u8bb0">${icon("diary")}</button>
					<button class="admin-rail-button ${this.module === "music" ? "is-active" : ""}" data-module="music" type="button" aria-label="\u97f3\u4e50" title="\u97f3\u4e50">${icon("music")}</button>
					<button class="admin-rail-button ${this.module === "honors" ? "is-active" : ""}" data-module="honors" type="button" aria-label="\u8363\u8a89\u5899" title="\u8363\u8a89\u5899">${icon("honors")}</button>
					<button class="admin-rail-button ${this.module === "friends" ? "is-active" : ""}" data-module="friends" type="button" aria-label="\u53cb\u94fe" title="\u53cb\u94fe">${icon("friends")}</button>
					<button class="admin-rail-button ${this.module === "guestbook" ? "is-active" : ""}" data-module="guestbook" type="button" aria-label="\u7559\u8a00\u677f" title="\u7559\u8a00\u677f">${icon("guestbook")}</button>
					<div class="admin-rail-spacer"></div>
					<button class="admin-rail-button" data-action="logout" type="button" aria-label="\u9000\u51fa\u767b\u5f55" title="\u9000\u51fa\u767b\u5f55">${icon("logout")}</button>
				</aside>
				<aside class="admin-sidebar">${this.module ? this.moduleSidebar() : this.contentSidebar()}</aside>
				<section class="admin-editor" data-editor></section>
			</section>`;
			if (this.module) this.renderModuleEditor();
		}

		private async loadItems() {
			this.setList(`<div class="admin-list-empty">正在读取内容…</div>`);
			try {
				const response = await fetch(`/api/admin/${this.kind}`, { credentials: "same-origin" });
				const data = await response.json() as Entry[] | { error?: string };
				if (!response.ok || !Array.isArray(data)) throw new Error((data as { error?: string }).error || "内容读取失败。");
				this.items = data;
				this.renderList();
				this.renderEditor();
			} catch (error) {
				this.setList(`<div class="admin-list-empty admin-error">${escapeHtml(error instanceof Error ? error.message : "内容读取失败。")}</div>`);
				this.renderEditor();
			}
		}

		private async loadModule() {
			const module = this.module;
			if (!module) return;
			this.moduleLoading = true;
			this.dataSha = "";
			this.moduleRecords = [];
			this.moduleNotice = "";
			this.uploadStatus = "";
			this.moduleState = "正在读取配置…";
			this.renderModuleEditor();
			try {
				const response = await fetch(`/api/admin/${module}`, { credentials: "same-origin" });
				const data = await response.json() as { source?: string; sha?: string; error?: string };
				if (!response.ok || typeof data.source !== "string") throw new Error(data.error || "配置读取失败。");
				this.dataSha = data.sha || "";
				const records = parseModuleRecords(data.source);
				this.moduleRecords = normalizeModuleRecords(module, records);
				// 解析不到记录时给一条空记录，让表单字段直接可见，用户不用先点「添加一条」。
				if (!this.moduleRecords.length) {
					this.moduleRecords = [createModuleRecord(module)];
				}
				this.moduleLoading = false;
				this.moduleState = "配置编辑";
				this.renderModuleEditor();
			} catch (error) {
				this.moduleLoading = false;
				this.moduleRecords = [createModuleRecord(module)];
				this.moduleState = "读取失败";
				this.renderModuleEditor(error instanceof Error ? error.message : "配置读取失败。");
			}
		}

		/** 渲染单个字段的输入控件。 */
		private renderModuleField(field: ModuleField, record: ModuleRecord, index: number) {
			const value = String(record[field.key] ?? "");
			const attrs = `data-module-field="${escapeHtml(field.key)}" data-record-index="${index}"`;
			const placeholder = escapeHtml(field.placeholder || "");
			let control = "";
			if (field.kind === "textarea") {
				control = `<textarea class="admin-module-textarea" ${attrs} placeholder="${placeholder}" rows="3">${escapeHtml(value)}</textarea>`;
			} else if (field.kind === "date") {
				control = `<input type="date" ${attrs} value="${escapeHtml(value)}" placeholder="${placeholder}" />`;
			} else if (field.kind === "url") {
				// 站内相对路径不是合法 URL，用 text + inputmode 避免浏览器判定输入无效。
				control = `<input type="text" inputmode="url" ${attrs} value="${escapeHtml(value)}" placeholder="${placeholder}" />`;
			} else {
				control = `<input type="text" ${attrs} value="${escapeHtml(value)}" placeholder="${placeholder}" />`;
			}
			const hint = field.hint ? `<small class="admin-field-hint">${escapeHtml(field.hint)}</small>` : "";
			const wide = field.kind === "textarea" ? ` class="admin-field-wide"` : "";
			return `<label${wide}>${escapeHtml(field.label)}${control}${hint}</label>`;
		}

		/** 渲染一条记录卡片（guestbook 只渲染一条且不带删除按钮）。 */
		private renderModuleRecord(module: AdminModule, fields: ModuleField[], record: ModuleRecord, index: number, isGuestbook: boolean) {
			const controls = fields.map((field) => this.renderModuleField(field, record, index)).join("");
			const head = isGuestbook
				? `<header class="admin-record-head"><strong>留言板配置</strong></header>`
				: `<header class="admin-record-head"><strong>第 ${index + 1} 条</strong></header>`;
			const audioFile = module === "music" ? audioFileName(record.url) : "";
			const audioButton = audioFile
				? `<button class="admin-secondary-button admin-danger-button" data-module-action="delete-audio-file" data-audio-file="${escapeHtml(audioFile)}" type="button">${icon("trash")} 删除音频文件</button>`
				: "";
			const foot = isGuestbook
				? ""
				: `<footer class="admin-record-foot">${audioButton}<button class="admin-secondary-button admin-danger-button" data-module-action="remove-record" data-record-index="${index}" type="button">${icon("trash")} 删除这条</button></footer>`;
			return `<article class="admin-record-card">${head}<div class="admin-form-grid">${controls}</div>${foot}</article>`;
		}

		private renderModuleEditor(error = "") {
			const editor = this.querySelector<HTMLElement>("[data-editor]");
			const module = this.module;
			if (!editor || !module) return;
			const fields = getModuleFields(module);
			const isGuestbook = module === "guestbook";
			const notice = error || this.moduleNotice;
			const stateText = this.moduleLoading ? "正在读取配置…" : this.moduleState;
			const guestbookAdminLink = isGuestbook
				? `<a class="admin-secondary-button admin-admin-link" href="/guestbook/?admin=1" target="_blank" rel="noopener noreferrer">管理现有留言 ↗</a>`
				: "";
			const helper = module === "music"
				? "每条记录是一首歌曲，填写歌曲名、歌手和 /audio/ 下的音频路径。"
				: module === "honors"
					? "每条记录是一项荣誉，日期用 YYYY-MM 格式。"
					: module === "friends"
						? "每条记录是一位好友，链接只允许 http(s) 地址或站内路径。"
						: "留言板只有一条配置，保存后立即生效。";
			const records = this.moduleRecords;
			const list = this.moduleLoading
				? `<div class="admin-list-empty">正在读取配置…</div>`
				: records.length
					? records.map((record, index) => this.renderModuleRecord(module, fields, record, index, isGuestbook)).join("")
					: `<div class="admin-list-empty"><strong>还没有内容</strong><span>点击下方「添加一条」开始编辑。</span></div>`;
			const addButton = isGuestbook
				? ""
				: `<div class="admin-module-add"><button class="admin-secondary-button" data-module-action="add-record" type="button">${icon("plus")} 添加一条</button></div>`;
			const upload = module === "music"
				? `<div class="admin-audio-upload"><label><span>上传本地音频</span><input type="file" accept="audio/*,.mp3,.m4a,.ogg,.wav,.flac,.aac" data-audio-file /></label><button class="admin-secondary-button" data-module-action="upload" type="button">上传并添加</button><small data-upload-status>${escapeHtml(this.uploadStatus || "将文件提交到输入目录")}</small></div>`
				: "";
			const tip = module === "music"
				? "这里只编辑歌曲名、歌手和音频文件路径。"
				: module === "honors"
					? "保存后关于页面会自动读取并分页显示，每页最多 5 项。"
					: module === "friends"
						? "url 使用 http(s) 地址；avatar 可以是 /images/ 下的本地图片或 https 图片地址。"
						: "留言内容保存后即可生效。";
			editor.innerHTML = `<div class="admin-editor-topbar admin-module-topbar">
				<span class="admin-save-state" role="status">${escapeHtml(stateText)}</span>
				<div class="admin-editor-actions">${guestbookAdminLink}<button class="admin-primary-button" data-module-action="save" type="button">保存配置</button></div>
			</div>
