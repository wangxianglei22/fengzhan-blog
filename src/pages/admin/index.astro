				<section class="admin-editor" data-editor></section>
			</section>`;
			if (this.module) this.renderModuleEditor();
			else if (this.mediaView) this.renderMedia();
		}

		private mediaSidebar() {
			return `<div class="admin-side-intro"><p class="admin-eyebrow">MEDIA LIBRARY</p><div class="admin-side-title"><h1>素材库</h1></div><p class="admin-module-sidebar-copy">所有已上传的图片和音频都放在这里，点一下路径就能复制，直接贴到封面、头像或正文里。</p></div>
				<div class="admin-module-side-card"><span class="admin-module-side-icon">${icon("media")}</span><strong>图片 ${this.mediaImages.length} 张</strong><small>public/images 下的所有图片</small></div>
				<div class="admin-module-side-card"><span class="admin-module-side-icon">${icon("music")}</span><strong>音频 ${this.mediaAudio.length} 个</strong><small>public/audio 下的所有音频</small></div>
				<div class="admin-sidebar-footer"><span class="admin-status-dot"></span><span>GitHub 内容源</span></div>`;
		}

		/** 首屏画完后，空闲时预热另一栏（切过去就能秒开，且不跟首屏抢带宽）。 */
		private prefetchOtherKind() {
			const other: CollectionName = this.kind === "posts" ? "diary" : "posts";
			if (this.module || this.mediaView) return;
			const key = `admin-items-${other}`;
			if (this.readItemsCache(key)) return;
			const run = () => {
				void fetch(`/api/admin/${other}`, { credentials: "same-origin" })
					.then(async (response) => {
						const data = await response.json() as Entry[] | { error?: string };
						if (!response.ok || !Array.isArray(data)) return;
						this.writeItemsCache(key, data);
					})
					.catch(() => {})
				;
			};
			const ric = (window as Window & { requestIdleCallback?: (cb: () => void, options?: { timeout?: number }) => number }).requestIdleCallback;
			if (typeof ric === "function") ric(run, { timeout: 3000 });
			else window.setTimeout(run, 1500);
		}

		private async loadMedia() {
			this.mediaLoading = true;
			this.mediaNotice = "";
			this.renderMedia();
			try {
				const response = await fetch("/api/admin/media", { credentials: "same-origin" });
				const data = await response.json() as { images?: MediaItem[]; audio?: MediaItem[]; error?: string };
				if (!response.ok) throw new Error(data.error || "素材读取失败。");
				this.mediaImages = Array.isArray(data.images) ? data.images : [];
				this.mediaAudio = Array.isArray(data.audio) ? data.audio : [];
			} catch (error) {
				this.mediaNotice = error instanceof Error ? error.message : "素材读取失败。";
			} finally {
				this.mediaLoading = false;
				this.renderWorkspace();
			}
		}

		private renderMedia() {
			const editor = this.querySelector<HTMLElement>("[data-editor]");
			if (!editor || !this.mediaView) return;
			const stateText = this.mediaLoading
				? "正在读取素材…"
				: `图片 ${this.mediaImages.length} 张 · 音频 ${this.mediaAudio.length} 个`;
			const notice = this.mediaNotice
				? `<p class="admin-notice">${escapeHtml(this.mediaNotice)}</p>`
				: "";
			const imageCards = this.mediaImages.map((item) => `<figure class="admin-media-card">
				<img src="${escapeHtml(item.url)}" alt="${escapeHtml(item.name)}" loading="lazy" decoding="async" />
				<figcaption>
					<strong title="${escapeHtml(item.name)}">${escapeHtml(item.name)}</strong>
					<button class="admin-media-path" data-copy="${escapeHtml(item.url)}" type="button" title="点击复制路径">${escapeHtml(item.url)}</button>
					<span class="admin-media-actions"><small>${formatBytes(item.size)}</small><button class="admin-media-link" data-copy="${escapeHtml(`![${item.name.replace(/\.[^.]+$/, "")}](${item.url})`)}" type="button">复制 Markdown</button><button class="admin-media-link admin-media-del" data-media-delete="${escapeHtml(item.path)}" type="button">删除</button></span>
				</figcaption>
			</figure>`).join("");
			const audioRows = this.mediaAudio.map((item) => `<div class="admin-media-row">
				<div class="admin-media-row-main">
					<strong>${escapeHtml(item.name)}</strong>
					<button class="admin-media-path" data-copy="${escapeHtml(item.url)}" type="button" title="点击复制路径">${escapeHtml(item.url)}</button>
					<small>${formatBytes(item.size)}</small>
				</div>
				<audio controls preload="none" src="${escapeHtml(item.url)}"></audio>
				<button class="admin-icon-button admin-danger-button" data-media-delete="${escapeHtml(item.path)}" type="button" aria-label="删除音频" title="删除音频">${icon("trash")}</button>
			</div>`).join("");
			editor.innerHTML = `<div class="admin-editor-topbar">
				<span class="admin-save-state" role="status">${escapeHtml(stateText)}</span>
				<div class="admin-editor-actions"><button class="admin-secondary-button" data-media-upload="image" type="button">${icon("upload")} 上传图片</button><button class="admin-secondary-button" data-media-upload="audio" type="button">${icon("upload")} 上传音频</button><button class="admin-secondary-button" data-media-refresh type="button">刷新列表</button><input class="admin-hidden-file" type="file" accept="image/jpeg,image/png,image/gif,image/webp,image/avif" data-media-input="image" /><input class="admin-hidden-file" type="file" accept="audio/mpeg,audio/mp4,audio/ogg,audio/wav,audio/flac,audio/aac" data-media-input="audio" /></div>
			</div>
			${notice}
			<div class="admin-media">
				<section class="admin-media-section"><h2>图片<small>点在路径上即可复制；封面、头像、正文都能直接用</small></h2>
					${this.mediaImages.length ? `<div class="admin-media-grid">${imageCards}</div>` : `<p class="admin-media-empty">还没有图片，去文章编辑器里粘贴或上传一张吧。</p>`}
				</section>
				<section class="admin-media-section"><h2>音频<small>歌单里的 url 字段填这里的路径</small></h2>
					${this.mediaAudio.length ? `<div class="admin-media-list">${audioRows}</div>` : `<p class="admin-media-empty">还没有音频，去音乐管理里上传一首吧。</p>`}
				</section>
			</div>`;
		}

		private async copyText(text: string, label = "路径") {
			try {
				await navigator.clipboard.writeText(text);
				this.showImageToast(`${label}已复制：${text}`, "info");
			} catch {
				const helper = document.createElement("textarea");
				helper.value = text;
				helper.style.position = "fixed";
				helper.style.opacity = "0";
				document.body.append(helper);
				helper.select();
				document.execCommand("copy");
				helper.remove();
				this.showImageToast(`${label}已复制：${text}`, "info");
			}
		}

		private async deleteMedia(path: string) {
			const name = path.split("/").pop() || path;
			if (!window.confirm(`确定从仓库删除「${name}」吗？这会提交一次 GitHub 删除提交，无法撤回。`)) return;
			try {
				const response = await fetch(`/api/admin/media?path=${encodeURIComponent(path)}`, { method: "DELETE", credentials: "same-origin" });
				const data = await response.json() as { deleted?: boolean; error?: string };
				if (!response.ok) throw new Error(data.error || "删除失败。");
				this.showImageToast(`已删除 ${name}`, "info");
				await this.loadMedia();
			} catch (error) {
				this.showImageToast(error instanceof Error ? error.message : "删除失败。", "error");
			}
		}

		private async loadItems(options: { fresh?: boolean } = {}) {
			const cacheKey = `admin-items-${this.kind}`;
			const cachedFirst = options.fresh ? null : this.readItemsCache(cacheKey);
			if (cachedFirst) {
				// 先把上次的结果画出来，网络慢也不至于一直盯着「正在读取内容…」
				this.items = cachedFirst;
				this.renderList();
				this.renderEditor();
				// 刚预热下来的数据就是新的，别再紧跟一次刷新（慢链路上等于白跑一趟）
				if (!options.fresh && Date.now() - this.lastWarmAt < 5000) {
					this.prefetchOtherKind();
					return;
				}
			} else {
				// 没有缓存就先铺骨架屏，别让人盯着一行灰字
				this.setList(this.renderListSkeleton());
			}
			// 预热可能还在飞：等它落地，多数时候数据已经进缓存，能省掉一次请求
			if (this.warmupPromise) await this.warmupPromise.catch(() => {});
			const cached = options.fresh ? null : (cachedFirst ?? this.readItemsCache(cacheKey));
			if (cached && !cachedFirst) {
				this.items = cached;
				this.renderList();
				this.renderEditor();
				this.prefetchOtherKind();
				return;
			}
			try {
				const query = options.fresh ? "?fresh=1" : "";
				const response = await fetch(`/api/admin/${this.kind}${query}`, { credentials: "same-origin" });
				const data = await response.json() as Entry[] | { error?: string };
				if (!response.ok || !Array.isArray(data)) throw new Error((data as { error?: string }).error || "内容读取失败。");
				this.items = data;
				this.writeItemsCache(cacheKey, data);
				this.renderList();
				this.renderEditor();
				this.prefetchOtherKind();
			} catch (error) {
				if (cached) {
					// 有缓存就先用着，别把列表整块换成错误文案
					this.setList(`<div class="admin-list-empty admin-error">刷新失败，显示的是上次的内容。</div>`);
					return;
				}
				this.setList(`<div class="admin-list-empty admin-error">${escapeHtml(error instanceof Error ? error.message : "内容读取失败。")}</div>`);
				this.renderEditor();
			}
		}
		
		/** 列表占位骨架：先把版式搭出来，比一行「正在读取内容…」的观感好很多。 */
		private renderListSkeleton(): string {
			const rows = Array.from({ length: 4 }, () => `<div class="admin-skeleton-row"><span class="admin-skeleton-dot"></span><span class="admin-skeleton-line"></span></div>`).join("");
			return `<div class="admin-list-skeleton" aria-hidden="true">${rows}</div>`;
		}
		
		/** 列表缓存放 sessionStorage：关掉标签页就失效，不会长期显示旧内容。 */
		private readItemsCache(key: string): Entry[] | null {
			try {
				const raw = window.sessionStorage.getItem(key);
				if (!raw) return null;
				const parsed = JSON.parse(raw) as { at?: number; items?: Entry[] };
				if (!parsed?.items || !Array.isArray(parsed.items)) return null;
				if (Date.now() - Number(parsed.at || 0) > ITEMS_CACHE_TTL) return null;
				return parsed.items;
			} catch {
				return null;
			}
		}
		
		private writeItemsCache(key: string, items: Entry[]) {
			try {
				window.sessionStorage.setItem(key, JSON.stringify({ at: Date.now(), items }));
			} catch {
				// 隐私模式 / 配额满：忽略即可
			}
		}


		private async loadModule() {
			const module = this.module;
			if (!module) return;
			this.moduleLoading = true;
			this.dataSha = "";
			this.moduleNotice = "";
			this.uploadStatus = "";
			this.moduleState = "正在读取配置…";
			this.moduleRecords = [];
			this.renderModuleEditor();
			try {
				const response = await fetch(`/api/admin/${module}`, { credentials: "same-origin" });
				const data = await response.json() as { source?: string; sha?: string; error?: string };
				if (!response.ok || typeof data.source !== "string") throw new Error(data.error || "配置读取失败。");
				this.dataSha = data.sha || "";
				this.moduleRecords = normalizeModuleRecords(module, parseModuleRecords(data.source));
				this.moduleLoading = false;
				this.moduleState = "配置编辑";
				this.renderModuleEditor();
			} catch (error) {
				this.moduleLoading = false;
				this.moduleState = "读取失败";
				this.renderModuleEditor(error instanceof Error ? error.message : "配置读取失败。");
			}
		}

		/** 哪些字段可以用「从素材库选」补上地址。 */
		private moduleMediaKind(module: AdminModule, field: ModuleField): "image" | "audio" | null {
			if (module === "music" && field.key === "url") return "audio";
			if (module === "friends" && field.key === "avatar") return "image";
			if (module === "honors" && field.key === "icon") return null;
			return null;
		}

		/** 单个字段控件。 */
		private renderModuleField(field: ModuleField, record: ModuleRecord, index: number) {
			const module = this.module;
			const value = String(record[field.key] ?? "");
			const wide = field.kind === "textarea" ? " admin-field-wide" : "";
			const mediaKind = module ? this.moduleMediaKind(module, field) : null;
			const audioButton = module === "music" && field.key === "url"
				? `<button class="admin-secondary-button admin-field-media" data-audio-upload data-record-index="${index}" data-record-key="${escapeHtml(field.key)}" type="button">上传音频</button>`
				: "";
			const mediaButton = mediaKind
				? `<button class="admin-secondary-button admin-field-media" data-module-action="pick-media" data-record-index="${index}" data-record-key="${escapeHtml(field.key)}" data-media-kind="${mediaKind}" type="button">从素材库选</button>`
				: "";
			const attrs = `data-record-index="${index}" data-record-key="${escapeHtml(field.key)}"`;
			const control = field.kind === "textarea"
				? `<textarea class="admin-field-input" rows="2" ${attrs} placeholder="${escapeHtml(field.placeholder || "")}">${escapeHtml(value)}</textarea>`
				: `<input class="admin-field-input" type="text" ${attrs} value="${escapeHtml(value)}" placeholder="${escapeHtml(field.placeholder || "")}" />`;
			const hint = field.hint ? `<small class="admin-field-hint">${escapeHtml(field.hint)}</small>` : "";
			const required = field.required ? `<span class="admin-field-required">必填</span>` : "";
			return `<label class="admin-field${wide}"><span class="admin-field-label">${escapeHtml(field.label)}${required}</span><span class="admin-field-row">${control}${mediaButton}${audioButton}</span>${hint}</label>`;
		}

		/** 列表型模块：一条记录一张表单卡，可上移 / 下移 / 删除。 */
		private renderModuleCards(module: AdminModule) {
			const fields = getModuleFields(module);
			if (!this.moduleRecords.length) {
				return `<div class="admin-list-empty"><strong>还没有条目</strong><span>点右上角「+ 新增一条」开始添加。</span></div>`;
			}
			const cards = this.moduleRecords.map((record, index) => {
				const summary = String(record.title || record.name || record.issuer || "").trim() || `第 ${index + 1} 条`;
				const inputs = fields.map((field) => this.renderModuleField(field, record, index)).join("");
				return `<article class="admin-record-card">
					<header class="admin-record-head">
						<span class="admin-record-index">${String(index + 1).padStart(2, "0")}</span>
						<strong>${escapeHtml(summary)}</strong>
						<div class="admin-record-actions">
							<button class="admin-icon-button" data-module-action="move-up" data-record-index="${index}" type="button" aria-label="上移"${index === 0 ? " disabled" : ""}>↑</button>
							<button class="admin-icon-button" data-module-action="move-down" data-record-index="${index}" type="button" aria-label="下移"${index === this.moduleRecords.length - 1 ? " disabled" : ""}>↓</button>
							<button class="admin-icon-button admin-record-remove" data-module-action="remove-record" data-record-index="${index}" type="button" aria-label="删除这条">✕</button>
						</div>
					</header>
					<div class="admin-form-grid">${inputs}</div>
				</article>`;
			}).join("");
			return `<div class="admin-module-cards">${cards}</div>`;
		}

		/** 留言板只有一个配置块，直接渲染成一组字段。 */
		private renderGuestbookForm(module: AdminModule) {
			const record = this.moduleRecords[0] ?? createModuleRecord(module);
			this.moduleRecords = [record];
			const fields = getModuleFields(module).map((field) => this.renderModuleField(field, record, 0)).join("");
			return `<div class="admin-form-grid">${fields}</div>`;
		}

		private renderModuleEditor(error = "") {
			const editor = this.querySelector<HTMLElement>("[data-editor]");
			const module = this.module;
			if (!editor || !module) return;
			const isGuestbook = module === "guestbook";
			const notice = error || this.moduleNotice;
			const stateText = this.moduleLoading ? "正在读取配置…" : this.moduleState;
			const guestbookAdminLink = isGuestbook
				? `<a class="admin-secondary-button admin-admin-link" href="/guestbook/?admin=1" target="_blank" rel="noopener noreferrer">管理现有留言 ↗</a>`
				: "";
			const helper = module === "music"
				? "一首歌一张卡，可以直接从素材库挑音频文件。"
				: module === "honors"
					? "一项荣誉一张卡，日期格式 YYYY-MM。"
					: module === "friends"
						? "一个网站一张卡，头像可以直接从素材库挑图片。"
						: "留言板的标题、简介和 Twikoo 服务地址。";
			const addButton = isGuestbook
				? ""
				: `<button class="admin-secondary-button" data-module-action="add-record" type="button">+ 新增一条</button>`;
			const audioFieldInput = module === "music"
				? `<input class="admin-hidden-file" type="file" accept="audio/mpeg,audio/mp4,audio/ogg,audio/wav,audio/flac,audio/aac,.mp3,.m4a,.ogg,.wav,.flac,.aac" data-audio-field />`
				: "";
			const uploadStatus = module === "music" && this.uploadStatus
				? `<small class="admin-upload-status">${escapeHtml(this.uploadStatus)}</small>`
				: "";
			const tip = module === "music"
				? "每条的「文件路径」旁边可以直接上传音频或从素材库挑；保存前确认每条都有歌曲名和文件路径。"
				: module === "honors"
					? "保存后关于页面会自动读取并分页显示，每页最多 5 项。"
					: module === "friends"
						? "链接用 http(s) 地址；头像留空时显示名称首字母。"
						: "标题和简介会显示在留言板页顶部；envId 填 /api/twikoo 走本站自带的留言后端。保存后刷新留言板页面即生效。";
			const body = this.moduleLoading
				? `<div class="admin-list-empty">正在读取配置…</div>`
				: isGuestbook
					? this.renderGuestbookForm(module)
					: this.renderModuleCards(module);
			editor.innerHTML = `<div class="admin-editor-topbar admin-module-topbar">
				<span class="admin-save-state" role="status">${escapeHtml(stateText)}</span>
				<div class="admin-editor-actions">${addButton}${guestbookAdminLink}<button class="admin-primary-button" data-module-action="save" type="button">保存配置</button></div>
			</div>
			${notice ? `<p class="admin-notice" data-module-notice>${escapeHtml(notice)}</p>` : `<p class="admin-notice" data-module-notice hidden></p>`}
			<div class="admin-module-editor">
				<div class="admin-module-heading"><div class="admin-module-heading-icon">${icon(module)}</div><div><p class="admin-eyebrow">${module.toUpperCase()} SETTINGS</p><h2>${this.moduleTitle()}</h2><p>${helper}</p></div></div>
				<div class="admin-module-body" data-module-body>
					${body}${audioFieldInput}
					${uploadStatus}
				</div>
				<div class="admin-module-tip"><strong>保存前检查</strong><span>${tip}</span></div>
			</div>`;
			if (this.recordDraft) editor.insertAdjacentHTML("beforeend", this.renderRecordDraftModal());
			// 素材库选择器最后插入，层级才盖在「新增一条」弹窗之上。
			if (this.mediaPicker) editor.insertAdjacentHTML("beforeend", this.renderMediaPicker());
		}

		/** 新建一条的弹窗：填好确认后才会进列表。 */
		private renderRecordDraftModal() {
			const module = this.module;
			const draft = this.recordDraft;
			if (!module || !draft) return "";
			const fields = getModuleFields(module).map((field) => this.renderModuleField(field, draft, -1)).join("");
			return `<div class="admin-modal-backdrop" data-modal-backdrop>
				<div class="admin-modal admin-modal-wide" role="dialog" aria-modal="true" aria-label="新增一条">
					<header class="admin-modal-head"><strong>新增一条${this.moduleTitle()}</strong><button class="admin-icon-button" data-module-action="add-record-cancel" type="button" aria-label="关闭">✕</button></header>
					<div class="admin-modal-body"><div class="admin-form-grid" data-draft-form>${fields}</div></div>
					<footer class="admin-modal-foot"><button class="admin-secondary-button" data-module-action="add-record-cancel" type="button">取消</button><button class="admin-primary-button" data-module-action="add-record-confirm" type="button">添加这条</button></footer>
				</div>
			</div>`;
		}

		/** 草稿确认：必填校验通过后追加到列表，并滚到新卡片。 */
		private async commitRecordDraft() {
			const module = this.module;
			const draft = this.recordDraft;
			if (!module || !draft) return;
			const missing = getModuleFields(module).find((field) => field.required && !String(draft[field.key] ?? "").trim());
			if (missing) {
				this.showImageToast(`请先填写「${missing.label}」`, "error");
				return;
			}
			this.moduleRecords.push(draft);
			this.recordDraft = null;
			this.moduleState = "未保存";
			this.moduleNotice = "";
			this.renderModuleEditor();
			const cards = this.querySelectorAll<HTMLElement>(".admin-module-cards .admin-record-card");
			const last = cards[cards.length - 1];
			if (last) {
				last.classList.add("is-new");
				last.scrollIntoView({ block: "center", behavior: "smooth" });
			}
		}

		/** 手动输入或粘贴音频路径后，也按「歌名 - 歌手」把空的标题和歌手补上。 */
		private fillMusicFromPath(input: HTMLInputElement) {
			if (this.module !== "music" || input.dataset.recordKey !== "url") return;
			const index = Number(input.dataset.recordIndex);
			const record = index < 0 ? this.recordDraft : this.moduleRecords[index];
			const value = input.value.trim();
			if (!record || !value) return;
			let name = value.split("/").pop() || "";
			try {
				name = decodeURIComponent(name);
			} catch {
				// 路径里有不合法转义时保持原样，不影响其它逻辑。
			}
			const { title, artist } = splitAudioFileName(name);
			let changed = false;
			if (!String(record.title || "").trim() && title) {
				record.title = title;
				changed = true;
			}
			if (!String(record.artist || "").trim() && artist) {
				record.artist = artist;
				changed = true;
			}
			if (changed) {
				this.moduleState = "未保存";
				// change 事件发生在失焦之后，这里重渲染不会抢走光标。
				this.renderModuleEditor();
			}
		}

		/** 素材库里的文件输入变化 → 直接上传。 */
		private handleChange(event: Event) {
			if (!(event.target instanceof HTMLInputElement)) return;
			if (event.target.dataset.recordKey === "url") {
				this.fillMusicFromPath(event.target);
				return;
			}
			if (event.target.dataset.audioField !== undefined) {
				const picked = event.target.files?.[0] ?? null;
				event.target.value = "";
				if (picked) void this.uploadAudioToField(picked);
				return;
			}
			const kind = event.target.dataset.mediaInput as "image" | "audio" | undefined;
			if (!kind) return;
			const file = event.target.files?.[0] ?? null;
			event.target.value = "";
			if (file) void this.uploadMediaFile(kind, file);
		}

		private async uploadMediaFile(kind: "image" | "audio", file: File) {
			if (this.mediaUploading) return;
			const limit = kind === "image" ? 20 * 1024 * 1024 : 25 * 1024 * 1024;
			if (file.size > limit) {
				this.mediaNotice = `文件 ${(file.size / 1024 / 1024).toFixed(1)} MiB，超过 ${kind === "image" ? "10" : "25"} MiB 上限，请压缩后再上传。`;
				this.renderMedia();
				return;
			}
			this.mediaUploading = kind;
			this.mediaNotice = `正在上传 ${file.name}…`;
			this.renderMedia();
			try {
				const form = new FormData();
				form.append("file", file);
				const response = await fetch(kind === "image" ? "/api/admin/images" : "/api/admin/music", { method: "POST", credentials: "same-origin", body: form });
				const data = (await response.json()) as { uploaded?: boolean; name?: string; url?: string; error?: string };
				if (!response.ok || !data.uploaded || !data.url) throw new Error(data.error || "上传失败。");
				await this.loadMedia();
				// loadMedia 会清空 mediaNotice，所以提示放在它之后写。
				this.mediaNotice = `已上传 ${data.name || file.name}。新文件要等下次构建完成后才能在页面里访问。`;
				this.renderMedia();
			} catch (error) {
				this.mediaNotice = error instanceof Error ? error.message : "上传失败。";
				this.renderMedia();
			} finally {
				this.mediaUploading = "";
			}
		}

		/** 素材库选择弹窗。 */
		private renderMediaPicker() {
			const picker = this.mediaPicker;
			if (!picker) return "";
			const items = picker.kind === "audio" ? this.pickerAudio : this.pickerImages;
			const list = this.pickerLoading
				? `<p class="admin-upload-hint">正在读取素材库…</p>`
				: items.length
					? `<div class="admin-picker-grid">${items.map((item) => `<button class="admin-picker-item" data-module-action="pick-url" data-pick-url="${escapeHtml(item.url)}" type="button" title="${escapeHtml(item.name)}"><span class="admin-picker-thumb">${picker.kind === "image" ? `<img src="${escapeHtml(item.url)}" alt="" loading="lazy" />` : "♪"}</span><span class="admin-picker-name">${escapeHtml(item.name)}</span></button>`).join("")}</div>`
					: `<p class="admin-upload-hint">素材库里还没有${picker.kind === "image" ? "图片" : "音频"}，先去左边的「素材库」上传。</p>`;
			return `<div class="admin-modal-backdrop" data-modal-backdrop>
				<div class="admin-modal admin-modal-wide" role="dialog" aria-modal="true" aria-label="从素材库选择">
					<header class="admin-modal-head"><strong>从素材库选择${picker.kind === "image" ? "图片" : "音频"}</strong><button class="admin-icon-button" data-module-action="close-picker" type="button" aria-label="关闭">✕</button></header>
					<div class="admin-modal-body">${list}</div>
				</div>
			</div>`;
		}

		private async openMediaPicker(kind: "image" | "audio", index: number, key: string) {
			this.mediaPicker = { kind, index, key };
			this.pickerLoading = true;
			this.pickerImages = [];
			this.pickerAudio = [];
			this.renderModuleEditor();
			try {
				const response = await fetch("/api/admin/media", { credentials: "same-origin" });
				const data = await response.json() as { images?: MediaItem[]; audio?: MediaItem[]; error?: string };
				if (!response.ok) throw new Error(data.error || "素材库读取失败。");
				this.pickerImages = Array.isArray(data.images) ? data.images : [];
				this.pickerAudio = Array.isArray(data.audio) ? data.audio : [];
			} catch (error) {
				this.mediaPicker = null;
				this.moduleNotice = error instanceof Error ? error.message : "素材库读取失败。";
			} finally {
				this.pickerLoading = false;
				this.renderModuleEditor();
			}
		}

		/** 选中素材后把地址写回字段；音乐模块顺手补上歌曲名。 */
		private applyPickedUrl(url: string) {
			const picker = this.mediaPicker;
			if (!picker || !url) return;
			const record = picker.index < 0 ? this.recordDraft : this.moduleRecords[picker.index];
			if (record) {
				record[picker.key] = url;
				if (this.module === "music" && picker.key === "url") {
					const name = decodeURIComponent(url.split("/").pop() || "");
					const { title, artist } = splitAudioFileName(name);
					// 只填空字段，用户手填过的值不动。
					if (!String(record.title || "").trim()) record.title = title;
					if (!String(record.artist || "").trim()) record.artist = artist;
				}
			}
			this.mediaPicker = null;
			this.moduleState = "未保存";
			this.renderModuleEditor();
		}

		/** 把表单里当前的值同步回 moduleRecords（保存前兜底）。 */
		private syncModuleFromForm() {
			this.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("input[data-record-index][data-record-key], textarea[data-record-index][data-record-key]").forEach((input) => {
				const index = Number(input.dataset.recordIndex);
				const key = input.dataset.recordKey || "";
				const record = index < 0 ? this.recordDraft : this.moduleRecords[index];
				if (record && key && index >= 0) record[key] = input.value;
			});
		}

		private setList(html: string) {
			const list = this.querySelector<HTMLElement>("[data-list]");
			if (list) list.innerHTML = html;
		}

		private renderList() {
			const list = this.querySelector<HTMLElement>("[data-list]");
			if (!list) return;
			if (!this.items.length) {
				list.innerHTML = `<div class="admin-list-empty"><strong>还没有内容</strong><span>点击上方“新建”开始写作。</span></div>`;
				return;
			}
			list.innerHTML = this.items.map((item) => `<button class="admin-list-item ${this.current?.slug === item.slug ? "is-selected" : ""}" data-action="edit" data-slug="${escapeHtml(item.slug)}" type="button">
