		private async handleSubmit(event: Event) {
			event.preventDefault();
			const form = event.target as HTMLFormElement;
			if (form.id === "login-form") {
				const password = new FormData(form).get("password");
				this.setBusy(true);
				try {
					const response = await fetch("/api/admin/login", { method: "POST", headers: { "content-type": "application/json" }, credentials: "same-origin", body: JSON.stringify({ password }) });
					const data = await response.json() as { error?: string };
					if (!response.ok) throw new Error(data.error || "登录失败。");
					this.renderWorkspace();
					await this.loadItems();
				} catch (error) {
					this.renderLogin(error instanceof Error ? error.message : "登录失败。");
				} finally {
					this.setBusy(false);
				}
				return;
			}
			if (form.id === "module-form") return;
			if (form.id !== "editor-form" || this.busy) return;
			const data = new FormData(form);
			const submitter = (event as SubmitEvent).submitter as HTMLButtonElement | null;
			const payload: Record<string, unknown> = {
				title: data.get("title"),
				slug: data.get("slug"),
				[this.kind === "posts" ? "published" : "date"]: data.get("date"),
				draft: submitter?.dataset.publish !== "true",
				hidden: data.get("hidden") === "on",
				updated: data.get("updated") || "",
				tags: tagsFromInput(String(data.get("tags") || "")),
				body: data.get("body"),
			};
			if (this.kind === "posts") Object.assign(payload, { description: data.get("description"), image: data.get("image"), category: data.get("category"), lang: data.get("lang") });
			else Object.assign(payload, { mood: data.get("mood"), moodLabel: data.get("moodLabel"), excerpt: data.get("excerpt"), cover: data.get("cover"), pinned: false });
			this.setBusy(true);
			const state = this.querySelector<HTMLElement>(".admin-save-state");
			if (state) state.textContent = "正在提交…";
			try {
				const editing = Boolean(this.current?.sha);
				const slug = this.current?.slug || "";
				const response = await fetch(editing ? `/api/admin/${this.kind}/${encodeURIComponent(slug)}` : `/api/admin/${this.kind}`, {
					method: editing ? "PUT" : "POST",
					headers: { "content-type": "application/json" },
					credentials: "same-origin",
					body: JSON.stringify(payload),
				});
				const result = await response.json() as Entry | { error?: string };
				if (!response.ok || !("slug" in result)) throw new Error((result as { error?: string }).error || "保存失败。");
				this.current = result;
				this.notice = "已保存，Cloudflare Pages 会自动构建网站。";
				await this.loadItems();
			} catch (error) {
				this.notice = error instanceof Error ? error.message : "保存失败。";
				if (state) state.textContent = "保存失败";
				const notice = this.querySelector<HTMLElement>(".admin-notice");
				if (notice) {
					notice.textContent = this.notice;
					notice.hidden = false;
				}
			} finally {
				this.setBusy(false);
			}
		}

		private handleInput(event: Event) {
			if (!(event.target instanceof Element)) return;
			const field = event.target.closest<HTMLElement>("[data-module-field]");
			if (field) {
				// 表单输入直接写回结构化记录，只改状态文字，不重渲染（避免丢焦点）。
				const index = Number(field.dataset.recordIndex);
				const key = field.dataset.moduleField;
				if (key && Number.isInteger(index) && this.moduleRecords[index]) {
					this.moduleRecords[index][key] = (field as HTMLInputElement).value;
				}
				this.moduleState = "未保存";
				this.moduleNotice = "";
				const state = this.querySelector<HTMLElement>(".admin-save-state");
				if (state) state.textContent = "未保存";
				const notice = this.querySelector<HTMLElement>("[data-module-notice]");
				if (notice) {
					notice.textContent = "";
					notice.hidden = true;
				}
				return;
			}
			if (!event.target.closest("#editor-form")) return;
			const state = this.querySelector<HTMLElement>(".admin-save-state");
			if (state) state.textContent = "未保存";
			const notice = this.querySelector<HTMLElement>(".admin-notice");
			if (notice) notice.hidden = true;
		}

		private async saveModule() {
			const module = this.module;
			if (!module || this.busy) return;
			// 保存前先做基础校验，避免错误内容进入构建阶段。
			const problems = validateModuleRecords(module, this.moduleRecords);
			if (problems.length) {
				this.moduleState = "请修正后重试";
				this.moduleNotice = problems.join(" ");
				this.renderModuleEditor();
				return;
			}
			const source = serializeModuleRecords(this.moduleRecords, module);
			if (!source.trim()) {
				this.moduleState = "请修正后重试";
				this.moduleNotice = "内容不能为空，请至少填写一条记录。";
				this.renderModuleEditor();
				return;
			}
			this.setBusy(true);
			const state = this.querySelector<HTMLElement>(".admin-save-state");
			if (state) state.textContent = "正在保存…";
			try {
				const response = await fetch(`/api/admin/${module}`, {
					method: "POST",
					headers: { "content-type": "application/json" },
					credentials: "same-origin",
					body: JSON.stringify({ source, sha: this.dataSha }),
				});
				const data = await response.json() as { saved?: boolean; sha?: string; error?: string };
				if (!response.ok || !data.saved) throw new Error(data.error || "保存配置失败。");
				this.dataSha = data.sha || this.dataSha;
				this.moduleState = "已保存";
				this.moduleNotice = "已保存，Cloudflare Pages 会自动构建网站。";
				this.renderModuleEditor();
			} catch (error) {
				this.moduleState = "保存失败";
				this.moduleNotice = error instanceof Error ? error.message : "保存配置失败。";
				this.renderModuleEditor();
			} finally {
				this.setBusy(false);
			}
		}

		private async uploadAudio() {
			if (this.module !== "music" || this.busy) return;
			const input = this.querySelector<HTMLInputElement>("[data-audio-file]");
			const file = input?.files?.[0];
			if (!file) {
				this.uploadStatus = "请选择音频文件。";
				this.renderModuleEditor();
				return;
			}
			// Cloudflare Pages 单文件上限 25 MiB，超出会在构建阶段被拒绝部署。
			const MAX_AUDIO_BYTES = 25 * 1024 * 1024;
			if (file.size > MAX_AUDIO_BYTES) {
				this.uploadStatus = `文件 ${(file.size / 1024 / 1024).toFixed(1)} MiB，超过 Cloudflare Pages 的 25 MiB 上限。请先转成 MP3 或压缩后再上传。`;
				this.renderModuleEditor();
				return;
			}
			this.setBusy(true);
			this.uploadStatus = "正在上传…";
			this.renderModuleEditor();
			try {
				const form = new FormData();
				form.append("file", file);
				const response = await fetch("/api/admin/music", { method: "POST", credentials: "same-origin", body: form });
				const data = await response.json() as { uploaded?: boolean; url?: string; name?: string; error?: string };
				if (!response.ok || !data.uploaded || !data.url) throw new Error(data.error || "音频上传失败。");
				// 上传成功后直接往结构化记录里追加一条，歌手留空等用户补。
				const title = file.name.replace(/\.[^.]+$/, "");
				this.moduleRecords.push({
					title,
					artist: "",
					url: data.url,
				});
				this.moduleRecords = normalizeModuleRecords(this.module, this.moduleRecords);
				this.moduleState = "未保存";
				this.uploadStatus = `已上传 ${data.name || file.name}，已添加一条，点保存生效。`;
				this.renderModuleEditor();
			} catch (error) {
				this.uploadStatus = error instanceof Error ? error.message : "音频上传失败。";
				this.renderModuleEditor();
			} finally {
				this.setBusy(false);
			}
		}

		/** 删除已上传的音频文件（同时把它从歌单记录里去掉）。 */
		private async deleteAudioFile(fileName: string) {
			if (!fileName || this.busy) return;
			if (!confirm(`确定删除音频文件“${fileName}”吗？此操作会提交 GitHub 删除文件。`)) return;
			this.setBusy(true);
			this.uploadStatus = "正在删除音频文件…";
			this.renderModuleEditor();
			try {
				const response = await fetch(`/api/admin/music?file=${encodeURIComponent(fileName)}`, {
					method: "DELETE",
					credentials: "same-origin",
				});
				const data = await response.json() as { deleted?: boolean; error?: string };
				if (!response.ok) throw new Error(data.error || "音频文件删除失败。");
				// 文件已经没了，这条记录也就没有意义，直接从列表里去掉。
				this.moduleRecords = this.moduleRecords.filter((record) => audioFileName(record.url) !== fileName);
				this.moduleState = "未保存";
				this.uploadStatus = data.deleted
					? `已删除音频文件 ${fileName}，并从歌单里移除了这条记录。点保存生效。`
					: `仓库里没有找到 ${fileName}，已从歌单里移除了这条记录。点保存生效。`;
				this.renderModuleEditor();
			} catch (error) {
				this.uploadStatus = error instanceof Error ? error.message : "音频文件删除失败。";
				this.renderModuleEditor();
			} finally {
				this.setBusy(false);
			}
		}

		private insertMarkdown(format: string) {
			const area = this.querySelector<HTMLTextAreaElement>(".admin-body-input");
			if (!area) return;
			const start = area.selectionStart;
			const end = area.selectionEnd;
			const selected = area.value.slice(start, end);
			const snippets: Record<string, string> = {
				heading: `## ${selected || "标题"}`,
				bold: `**${selected || "加粗文字"}**`,
				italic: `*${selected || "斜体文字"}*`,
				quote: `> ${selected || "引用内容"}`,
				list: `- ${selected || "列表项"}`,
				link: `[${selected || "链接文字"}](https://)`,
				code: `\`\`\`\n${selected || "const hello = \"world\";"}\n\`\`\``,
				image: `![${selected || "????"}](/images/example.jpg)`,
				table: `| ?? | ?? |\n| --- | --- |\n| ${selected || "??"} | ?? |`,
				rule: "\n---\n",
			};
			if (!snippets[format]) return;
			area.setRangeText(snippets[format], start, end, "end");
			area.focus();
			area.dispatchEvent(new Event("input", { bubbles: true }));
		}

		private toggleEmojiMenu(button: HTMLButtonElement) {
			const menu = button.parentElement?.querySelector<HTMLElement>("[data-emoji-menu]");
			if (menu) menu.hidden = !menu.hidden;
		}

		private chooseEmoji(value: string, button?: HTMLButtonElement) {
			const moodInput = this.querySelector<HTMLInputElement>("input[name='mood']");
			const moodPicker = this.querySelector<HTMLElement>("[data-mood-picker]");
			if (moodPicker && button?.closest("[data-mood-picker]")) {
				if (moodInput) moodInput.value = value;
				moodPicker.querySelector<HTMLElement>("[data-emoji-menu]")?.setAttribute("hidden", "true");
				moodInput?.dispatchEvent(new Event("input", { bubbles: true }));
				return;
			}
			const area = this.querySelector<HTMLTextAreaElement>(".admin-body-input");
			if (!area) return;
			area.setRangeText(value, area.selectionStart, area.selectionEnd, "end");
			area.focus();
			area.dispatchEvent(new Event("input", { bubbles: true }));
			this.querySelector<HTMLElement>("[data-emoji-menu]")?.setAttribute("hidden", "true");
		}

		private async handleClick(event: Event) {
			const target = event.target;
			if (!(target instanceof Element)) return;
			const button = target.closest<HTMLButtonElement>("button[data-action], button[data-kind], button[data-module], button[data-module-action], button[data-format], button[data-emoji]");
			if (!button || this.busy) return;
			if (button.dataset.emoji) {
				this.chooseEmoji(button.dataset.emoji, button);
				return;
			}
			if (button.dataset.format) {
				if (button.dataset.format === "emoji") {
					this.toggleEmojiMenu(button);
					return;
				}
				this.insertMarkdown(button.dataset.format);
				return;
			}
			if (button.dataset.module) {
				this.module = button.dataset.module as AdminModule;
				this.current = null;
				this.notice = "";
				this.renderWorkspace();
				await this.loadModule();
				return;
			}
			if (button.dataset.moduleAction === "save") {
				await this.saveModule();
				return;
			}
			if (button.dataset.moduleAction === "upload") {
				await this.uploadAudio();
				return;
			}
			if (button.dataset.moduleAction === "add-record") {
				if (!this.module) return;
				this.moduleRecords.push(createModuleRecord(this.module));
				this.moduleState = "未保存";
				this.moduleNotice = "";
				this.renderModuleEditor();
				return;
			}
			if (button.dataset.moduleAction === "delete-audio-file") {
				await this.deleteAudioFile(button.dataset.audioFile || "");
				return;
			}
			if (button.dataset.moduleAction === "remove-record") {
				const index = Number(button.dataset.recordIndex);
				if (!this.module || !Number.isInteger(index) || index < 0 || index >= this.moduleRecords.length) return;
				this.moduleRecords.splice(index, 1);
				this.moduleState = "未保存";
				this.moduleNotice = "";
				this.renderModuleEditor();
				return;
			}
			if (button.dataset.kind) {
				this.module = null;
				this.kind = button.dataset.kind as CollectionName;
				this.current = null;
				this.notice = "";
				this.renderWorkspace();
				await this.loadItems();
				return;
			}
			switch (button.dataset.action) {
				case "new":
					this.current = emptyEntry(this.kind);
					this.notice = "";
					this.renderList();
					this.renderEditor();
					break;
				case "edit":
					this.current = this.items.find((item) => item.slug === button.dataset.slug) || null;
					this.notice = "";
					this.renderList();
					this.renderEditor();
					break;
				case "cancel":
					this.current = null;
					this.notice = "";
					this.renderList();
					this.renderEditor();
					break;
				case "delete":
					await this.deleteCurrent();
					break;
				case "logout":
					await fetch("/api/admin/logout", { method: "POST", credentials: "same-origin" });
					this.current = null;
					this.renderLogin();
					break;
			}
		}

		private async deleteCurrent() {
			if (!this.current?.slug || !confirm(`确定删除“${this.current.title}”吗？此操作会提交 GitHub 删除记录。`)) return;
			this.setBusy(true);
			try {
				const response = await fetch(`/api/admin/${this.kind}/${encodeURIComponent(this.current.slug)}`, { method: "DELETE", credentials: "same-origin" });
				const data = await response.json() as { error?: string };
				if (!response.ok) throw new Error(data.error || "删除失败。");
				this.current = null;
				this.notice = "内容已删除。";
				await this.loadItems();
			} catch (error) {
				this.notice = error instanceof Error ? error.message : "删除失败。";
				this.renderEditor();
			} finally {
				this.setBusy(false);
			}
		}

		private setBusy(value: boolean) {
			this.busy = value;
			this.classList.toggle("is-busy", value);
		}
	}

	if (!customElements.get("admin-app")) customElements.define("admin-app", AdminApp);
</script>

