---
import "@fontsource/roboto/400.css";
import "@fontsource/roboto/500.css";
import "@fontsource/roboto/700.css";
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="robots" content="noindex,nofollow" />
		<link rel="icon" href="/images/avatar.svg" type="image/svg+xml" />
		<title>博客后台管理</title>
		<script is:inline>
			// 在首帧前定好深浅色，避免刷新时闪白。
			(function () {
				try {
					var stored = localStorage.getItem("admin-theme");
					var dark =
						stored === "dark" ||
						(stored !== "light" && window.matchMedia("(prefers-color-scheme: dark)").matches);
					if (dark) document.documentElement.classList.add("admin-dark");
				} catch (error) {
					/* localStorage 不可用时按浅色处理 */
				}
			})();
		</script>
	</head>
	<body class="admin-page" data-no-swup>
		<main class="admin-shell">
			<header class="admin-header">
				<a class="admin-brand" href="/" aria-label="返回博客首页">
					<span class="admin-brand-mark"><svg viewBox="100 40 320 280" aria-hidden="true" focusable="false"><path d="M256 58C268 105 280 140 296 176L340 146 376 118 352 196 330 206 400 250 330 272 300 296 256 300 212 296 182 272 112 250 182 206 160 196 136 118 172 146 216 176C232 140 244 105 256 58Z" fill="currentColor" /></svg></span>
					<span><strong>枫栈</strong><small>CONTENT STUDIO</small></span>
				</a>
				<button class="admin-theme-toggle" type="button" data-action="toggle-theme"
					aria-label="切换深浅色" title="切换深浅色">
					<svg class="admin-theme-icon admin-theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2" /><path d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2M5.4 5.4l1.6 1.6M17 17l1.6 1.6M18.6 5.4 17 7M7 17l-1.6 1.6" /></svg>
					<svg class="admin-theme-icon admin-theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.6A8.9 8.9 0 0 1 9.4 3.5a8.9 8.9 0 1 0 11.1 11.1Z" /></svg>
				</button>
			</header>
			<admin-app>
				<div class="admin-loading">正在加载后台…</div>
			</admin-app>
		</main>
		<script is:inline>
			(function () {
				var root = document.documentElement;
				var media = window.matchMedia("(prefers-color-scheme: dark)");
				var button = document.querySelector("[data-action=toggle-theme]");
				if (!button) return;
				var apply = function (theme) {
					var dark = theme === "dark" || (theme !== "light" && media.matches);
					root.classList.toggle("admin-dark", dark);
					button.setAttribute("aria-pressed", dark ? "true" : "false");
				};
				var stored = null;
				try {
					stored = localStorage.getItem("admin-theme");
				} catch (error) {
					stored = null;
				}
				apply(stored || "auto");
				button.addEventListener("click", function () {
					var current = root.classList.contains("admin-dark") ? "dark" : "light";
					var next = current === "dark" ? "light" : "dark";
					try {
						localStorage.setItem("admin-theme", next);
					} catch (error) {
						/* ignore */
					}
					apply(next);
				});
				media.addEventListener("change", function () {
					try {
						if (!localStorage.getItem("admin-theme")) apply("auto");
					} catch (error) {
						apply("auto");
					}
				});
			})();
		</script>
	</body>
</html>

<script>
	import {
		createModuleRecord,
		getModuleFields,
		isBlankRecord,
		normalizeModuleRecords,
		parseModuleRecords,
		serializeModuleRecords,
		validateModuleRecords,
		type AdminModule,
		type ModuleField,
		type ModuleRecord,
	} from "../../utils/admin-module-forms";

	type CollectionName = "posts" | "diary";
	type Entry = {
		collection: CollectionName;
		slug: string;
		sha?: string;
		title: string;
		date: string;
		updated: string;
		draft: boolean;
		hidden: boolean;
		description: string;
		image: string;
		tags: string[];
		category: string;
		lang: string;
		mood: string;
		moodLabel: string;
		excerpt: string;
		cover: string;
		pinned: boolean;
		body: string;
	};

	const today = () => new Date().toISOString().slice(0, 10);
const escapeHtml = (value: unknown) => String(value ?? "").replace(/[&<>"']/g, (character) => ({
		"&": "&amp;",
		"<": "&lt;",
		">": "&gt;",
		'"': "&quot;",
		"'": "&#39;",
	}[character] || character));
	const tagsFromInput = (value: string) => value.split(/[,，]/).map((tag) => tag.trim()).filter(Boolean);
	type MediaItem = { name: string; path: string; url: string; size: number };

const formatBytes = (bytes: number) => {
	if (!bytes) return "0 KB";
	if (bytes < 1024) return `${bytes} B`;
	if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(0)} KB`;
	return `${(bytes / 1024 / 1024).toFixed(1)} MB`;
};

const iconPaths: Record<string, string> = {
		home: '<path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1z"/>',
		posts: '<path d="M5 3h10l4 4v14H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"/><path d="M14 3v5h5M7 12h10M7 16h10"/>',
		diary: '<rect x="4" y="4" width="16" height="17" rx="2"/><path d="M8 2v4M16 2v4M4 9h16M8 13h3M8 17h6"/>',
		logout: '<path d="M10 4H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h5M15 16l4-4-4-4M8 12h11"/>',
		back: '<path d="m15 18-6-6 6-6"/>',
		plus: '<path d="M12 5v14M5 12h14"/>',
		trash: '<path d="M4 7h16M10 3h4M6 7l1 14h10l1-14M10 11v6M14 11v6"/>',
		link: '<path d="M10 13a5 5 0 0 0 7.1 0l2-2a5 5 0 0 0-7.1-7.1l-1.2 1.2M14 11a5 5 0 0 0-7.1 0l-2 2A5 5 0 0 0 12 20.1l1.2-1.2"/>',
		music: '<path d="M9 18V5l10-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="16" cy="16" r="3"/>',
		honors: '<path d="M8 4h8v4a4 4 0 0 1-8 0zM12 12v5M8 21h8M9 17h6"/><path d="M8 6H4v2a4 4 0 0 0 4 4M16 6h4v2a4 4 0 0 1-4 4"/>',
		guestbook: '<path d="M4 5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-7l-5 4v-4H6a2 2 0 0 1-2-2z"/><path d="M8 8h8M8 12h5"/>',
		friends: '<path d="M16 20a4 4 0 0 0-8 0"/><circle cx="12" cy="8" r="3"/><path d="M20 20a4 4 0 0 0-3-3.87M17 5.13a3 3 0 0 1 0 5.74M4 20a4 4 0 0 1 3-3.87M7 5.13a3 3 0 0 0 0 5.74"/>',
	upload: '<path d="M12 16V4M7 9l5-5 5 5M4 20h16"/>',
	media: '<rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="8.5" cy="9.5" r="1.5"/><path d="m4 17 5-4 4 3 3-2 4 3"/>',
	};
	const icon = (name: string) => `<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${iconPaths[name]}</svg>`;
	const moodEmojis = ["😀", "😊", "😌", "🤍", "🥰", "😎", "🤔", "😴", "🥳", "😭", "😤", "😮", "🤗", "🙃", "🌈", "✨", "🌙", "☀️", "🍀", "🎧"];

	function emptyEntry(collection: CollectionName): Entry {
		return {
			collection,
			slug: "",
			title: "",
			date: today(),
			updated: "",
			draft: true,
			hidden: false,
			description: "",
			image: "",
			tags: [],
			category: "",
			lang: "",
			mood: "😊",
			moodLabel: "今天的心情",
			excerpt: "",
			cover: "",
			pinned: false,
			body: "",
		};
	}

	class AdminApp extends HTMLElement {
		private kind: CollectionName = "posts";
		/** 素材库是独立视图，不参与文章/日记的 kind 切换。 */
		private mediaView = false;
		private mediaImages: MediaItem[] = [];
		private mediaAudio: MediaItem[] = [];
		private mediaLoading = false;
		private mediaNotice = "";
		private module: AdminModule | null = null;
		private items: Entry[] = [];
		private current: Entry | null = null;
		private dataSha = "";
		/** 模块页顶栏的状态提示文字。 */
		private moduleState = "配置编辑";
		/** 模块页的提示 / 错误信息。 */
		private moduleNotice = "";
		/** 音频上传区的状态文字。 */
		private uploadStatus = "";
		/** 上传音频弹窗是否打开。 */
		private uploadModalOpen = false;
		/** 图片上传弹窗的用途：插入正文 / 回填文章封面 / 回填日记封面。 */
		private imageTarget: "body" | "image" | "cover" = "body";
		/** 图片上传弹窗里的状态文字。 */
		private imageStatus = "";
		/** 打开图片弹窗时正文里的选区，用来把图片插回原来的位置。 */
		private imageInsertRange: [number, number] | null = null;
		/** 是否正在读取模块配置。 */
		private moduleLoading = false;
		/** 模块表单里的记录（音乐 / 荣誉墙 / 常用网站 / 留言板）。 */
		private moduleRecords: ModuleRecord[] = [];
		/** 素材库选择弹窗：选中后写回哪条记录的哪个字段。 */
		private mediaPicker: { kind: "image" | "audio"; index: number; key: string } | null = null;
		private pickerImages: MediaItem[] = [];
		private pickerAudio: MediaItem[] = [];
		private pickerLoading = false;
		private notice = "";
		private busy = false;

		connectedCallback() {
			if (this.dataset.ready === "true") return;
			this.dataset.ready = "true";
			this.addEventListener("click", this.handleClick);
			this.addEventListener("submit", this.handleSubmit);
			this.addEventListener("input", this.handleInput);
			this.addEventListener("paste", this.handlePaste);
			this.addEventListener("dragover", this.handleDragOver);
			this.addEventListener("drop", this.handleDrop);
			void this.checkSession();
		}

		private async checkSession() {
			try {
				const response = await fetch("/api/admin/session", { credentials: "same-origin" });
				const data = await response.json() as { authenticated?: boolean };
				if (data.authenticated) {
					this.renderWorkspace();
					if (this.module) await this.loadModule();
					else await this.loadItems();
				} else {
					this.renderLogin();
				}
			} catch {
				this.renderLogin("后台接口暂时无法连接，请确认 Cloudflare Pages Functions 已部署。");
			}
		}

		private renderLogin(error = "") {
			this.innerHTML = `<section class="admin-auth-panel">
				<div class="admin-auth-icon"><svg viewBox="100 40 320 280" aria-hidden="true" focusable="false"><path d="M256 58C268 105 280 140 296 176L340 146 376 118 352 196 330 206 400 250 330 272 300 296 256 300 212 296 182 272 112 250 182 206 160 196 136 118 172 146 216 176C232 140 244 105 256 58Z" fill="currentColor" /></svg></div>
				<p class="admin-eyebrow">PRIVATE WORKSPACE</p>
				<h1>进入内容后台</h1>
				<p class="admin-muted">这里用于管理文章和日记，访客不会看到这个页面。</p>
				<form id="login-form" class="admin-login-form">
					<label>管理员密码<input name="password" type="password" autocomplete="current-password" placeholder="输入后台密码" required /></label>
					<button class="admin-primary-button" type="submit">登录后台 <span aria-hidden="true">→</span></button>
				</form>
				${error ? `<p class="admin-error">${escapeHtml(error)}</p>` : ""}
				<p class="admin-auth-hint">这里是私有编辑区，访客看不到。</p>
			</section>`;
		}

		private moduleTitle() {
			return this.module === "music" ? "音乐" : this.module === "honors" ? "荣誉墙" : this.module === "friends" ? "常用网站" : "留言板";
		}

		private moduleDescription() {
			return this.module === "music"
				? "编辑歌单。"
				: this.module === "honors"
					? "维护页面上的荣誉记录。"
					: this.module === "friends"
						? "编辑常用网站的链接与头像。"
						: "修改留言板的标题与说明。";
		}

		private contentSidebar() {
			return `<div class="admin-side-intro"><p class="admin-eyebrow">CONTENT STUDIO</p><div class="admin-side-title"><h1>${this.kind === "posts" ? "\u6587\u7ae0" : "\u65e5\u8bb0"}</h1><button class="admin-new-button" data-action="new" type="button" aria-label="\u65b0\u5efa\u5185\u5bb9" title="\u65b0\u5efa\u5185\u5bb9">${icon("plus")}</button></div></div>
				<div class="admin-list-heading"><span>\u5168\u90e8\u5185\u5bb9</span></div>
				<div class="admin-list" data-list><div class="admin-list-empty">\u6b63\u5728\u8bfb\u53d6\u5185\u5bb9\u2026</div></div>
				<div class="admin-sidebar-footer"><span class="admin-status-dot"></span><span>GitHub \u5185\u5bb9\u6e90</span></div>`;
		}

		private moduleSidebar() {
			return `<div class="admin-side-intro"><p class="admin-eyebrow">SITE MODULES</p><div class="admin-side-title"><h1>${this.moduleTitle()}</h1></div><p class="admin-module-sidebar-copy">${this.moduleDescription()}</p></div>
				<div class="admin-module-side-card"><span class="admin-module-side-icon">${icon(this.module || "music")}</span><strong>\u914d\u7f6e\u6587\u4ef6</strong><small>\u4fdd\u5b58\u540e\u63d0\u4ea4\u5230 GitHub</small></div>
				<div class="admin-sidebar-footer"><span class="admin-status-dot"></span><span>GitHub \u5185\u5bb9\u6e90</span></div>`;
		}

		private renderWorkspace() {
			this.innerHTML = `<section class="admin-workspace">
				<aside class="admin-rail" aria-label="\u540e\u53f0\u5bfc\u822a">
					<button class="admin-rail-button ${!this.module && !this.mediaView && this.kind === "posts" ? "is-active" : ""}" data-kind="posts" type="button" aria-label="\u6587\u7ae0" title="\u6587\u7ae0">${icon("posts")}</button>
					<button class="admin-rail-button ${!this.module && !this.mediaView && this.kind === "diary" ? "is-active" : ""}" data-kind="diary" type="button" aria-label="\u65e5\u8bb0" title="\u65e5\u8bb0">${icon("diary")}</button>
					<button class="admin-rail-button ${this.module === "music" ? "is-active" : ""}" data-module="music" type="button" aria-label="\u97f3\u4e50" title="\u97f3\u4e50">${icon("music")}</button>
					<button class="admin-rail-button ${this.module === "honors" ? "is-active" : ""}" data-module="honors" type="button" aria-label="\u8363\u8a89\u5899" title="\u8363\u8a89\u5899">${icon("honors")}</button>
					<button class="admin-rail-button ${this.module === "friends" ? "is-active" : ""}" data-module="friends" type="button" aria-label="\u5e38\u7528\u7f51\u7ad9" title="\u5e38\u7528\u7f51\u7ad9">${icon("friends")}</button>
					<button class="admin-rail-button ${this.module === "guestbook" ? "is-active" : ""}" data-module="guestbook" type="button" aria-label="\u7559\u8a00\u677f" title="\u7559\u8a00\u677f">${icon("guestbook")}</button>
					<button class="admin-rail-button ${this.mediaView ? "is-active" : ""}" data-kind="media" type="button" aria-label="素材库" title="素材库">${icon("media")}</button>
					<div class="admin-rail-spacer"></div>
					<button class="admin-rail-button" data-action="logout" type="button" aria-label="\u9000\u51fa\u767b\u5f55" title="\u9000\u51fa\u767b\u5f55">${icon("logout")}</button>
				</aside>
				<aside class="admin-sidebar">${this.module ? this.moduleSidebar() : this.mediaView ? this.mediaSidebar() : this.contentSidebar()}</aside>
				<section class="admin-editor" data-editor></section>
			</section>`;
			if (this.module) this.renderModuleEditor();
			else if (this.mediaView) this.renderMedia();
		}

		private mediaSidebar() {
			return `<div class="admin-side-intro"><p class="admin-eyebrow">MEDIA LIBRARY</p><div class="admin-side-title"><h1>素材库</h1></div><p class="admin-module-sidebar-copy">所有已上传的图片和音频都放在这里，点一下路径就能复制，直接贴到封面、头像或正文里。</p></div>
				<div class="admin-module-side-card"><span class="admin-module-side-icon">${icon("media")}</span><strong>图片 ${this.mediaImages.length} 张</strong><small>public/images 下的所有图片</small></div>
				<div class="admin-module-side-card"><span class="admin-module-side-icon">${icon("music")}</span><strong>音频 ${this.mediaAudio.length} 个</strong><small>public/audio 下的所有音频</small></div>
				<div class="admin-sidebar-footer"><span class="admin-status-dot"></span><span>GitHub 内容源</span></div>`;
		}

		private async loadMedia() {
			this.mediaLoading = true;
			this.mediaNotice = "";
			this.renderMedia();
			try {
				const response = await fetch("/api/admin/media", { credentials: "same-origin" });
				const data = await response.json() as { images?: MediaItem[]; audio?: MediaItem[]; error?: string };
				if (!response.ok) throw new Error(data.error || "素材读取失败。");
				this.mediaImages = Array.isArray(data.images) ? data.images : [];
				this.mediaAudio = Array.isArray(data.audio) ? data.audio : [];
			} catch (error) {
				this.mediaNotice = error instanceof Error ? error.message : "素材读取失败。";
			} finally {
				this.mediaLoading = false;
				this.renderWorkspace();
			}
		}

		private renderMedia() {
			const editor = this.querySelector<HTMLElement>("[data-editor]");
			if (!editor || !this.mediaView) return;
			const stateText = this.mediaLoading
				? "正在读取素材…"
				: `图片 ${this.mediaImages.length} 张 · 音频 ${this.mediaAudio.length} 个`;
			const notice = this.mediaNotice
				? `<p class="admin-notice">${escapeHtml(this.mediaNotice)}</p>`
				: "";
			const imageCards = this.mediaImages.map((item) => `<figure class="admin-media-card">
				<img src="${escapeHtml(item.url)}" alt="${escapeHtml(item.name)}" loading="lazy" decoding="async" />
				<figcaption>
					<strong title="${escapeHtml(item.name)}">${escapeHtml(item.name)}</strong>
					<button class="admin-media-path" data-copy="${escapeHtml(item.url)}" type="button" title="点击复制路径">${escapeHtml(item.url)}</button>
					<span class="admin-media-actions"><small>${formatBytes(item.size)}</small><button class="admin-media-link" data-copy="${escapeHtml(`![${item.name.replace(/\.[^.]+$/, "")}](${item.url})`)}" type="button">复制 Markdown</button><button class="admin-media-link admin-media-del" data-media-delete="${escapeHtml(item.path)}" type="button">删除</button></span>
				</figcaption>
			</figure>`).join("");
			const audioRows = this.mediaAudio.map((item) => `<div class="admin-media-row">
				<div class="admin-media-row-main">
					<strong>${escapeHtml(item.name)}</strong>
					<button class="admin-media-path" data-copy="${escapeHtml(item.url)}" type="button" title="点击复制路径">${escapeHtml(item.url)}</button>
					<small>${formatBytes(item.size)}</small>
				</div>
				<audio controls preload="none" src="${escapeHtml(item.url)}"></audio>
				<button class="admin-icon-button admin-danger-button" data-media-delete="${escapeHtml(item.path)}" type="button" aria-label="删除音频" title="删除音频">${icon("trash")}</button>
			</div>`).join("");
			editor.innerHTML = `<div class="admin-editor-topbar">
				<span class="admin-save-state" role="status">${escapeHtml(stateText)}</span>
				<div class="admin-editor-actions"><button class="admin-secondary-button" data-media-refresh type="button">刷新列表</button></div>
			</div>
			${notice}
			<div class="admin-media">
				<section class="admin-media-section"><h2>图片<small>点在路径上即可复制；封面、头像、正文都能直接用</small></h2>
					${this.mediaImages.length ? `<div class="admin-media-grid">${imageCards}</div>` : `<p class="admin-media-empty">还没有图片，去文章编辑器里粘贴或上传一张吧。</p>`}
				</section>
				<section class="admin-media-section"><h2>音频<small>歌单里的 url 字段填这里的路径</small></h2>
					${this.mediaAudio.length ? `<div class="admin-media-list">${audioRows}</div>` : `<p class="admin-media-empty">还没有音频，去音乐管理里上传一首吧。</p>`}
				</section>
			</div>`;
		}

		private async copyText(text: string, label = "路径") {
			try {
				await navigator.clipboard.writeText(text);
				this.showImageToast(`${label}已复制：${text}`, "info");
			} catch {
				const helper = document.createElement("textarea");
				helper.value = text;
				helper.style.position = "fixed";
				helper.style.opacity = "0";
				document.body.append(helper);
				helper.select();
				document.execCommand("copy");
				helper.remove();
				this.showImageToast(`${label}已复制：${text}`, "info");
			}
		}

		private async deleteMedia(path: string) {
			const name = path.split("/").pop() || path;
			if (!window.confirm(`确定从仓库删除「${name}」吗？这会提交一次 GitHub 删除提交，无法撤回。`)) return;
			try {
				const response = await fetch(`/api/admin/media?path=${encodeURIComponent(path)}`, { method: "DELETE", credentials: "same-origin" });
				const data = await response.json() as { deleted?: boolean; error?: string };
				if (!response.ok) throw new Error(data.error || "删除失败。");
				this.showImageToast(`已删除 ${name}`, "info");
				await this.loadMedia();
			} catch (error) {
				this.showImageToast(error instanceof Error ? error.message : "删除失败。", "error");
			}
		}

		private async loadItems() {
			this.setList(`<div class="admin-list-empty">正在读取内容…</div>`);
			try {
				const response = await fetch(`/api/admin/${this.kind}`, { credentials: "same-origin" });
				const data = await response.json() as Entry[] | { error?: string };
				if (!response.ok || !Array.isArray(data)) throw new Error((data as { error?: string }).error || "内容读取失败。");
				this.items = data;
				this.renderList();
				this.renderEditor();
			} catch (error) {
				this.setList(`<div class="admin-list-empty admin-error">${escapeHtml(error instanceof Error ? error.message : "内容读取失败。")}</div>`);
				this.renderEditor();
			}
		}

		private async loadModule() {
			const module = this.module;
			if (!module) return;
			this.moduleLoading = true;
			this.dataSha = "";
			this.moduleNotice = "";
			this.uploadStatus = "";
			this.moduleState = "正在读取配置…";
			this.moduleRecords = [];
			this.renderModuleEditor();
			try {
				const response = await fetch(`/api/admin/${module}`, { credentials: "same-origin" });
				const data = await response.json() as { source?: string; sha?: string; error?: string };
				if (!response.ok || typeof data.source !== "string") throw new Error(data.error || "配置读取失败。");
				this.dataSha = data.sha || "";
				this.moduleRecords = normalizeModuleRecords(module, parseModuleRecords(data.source));
				this.moduleLoading = false;
				this.moduleState = "配置编辑";
				this.renderModuleEditor();
			} catch (error) {
				this.moduleLoading = false;
				this.moduleState = "读取失败";
				this.renderModuleEditor(error instanceof Error ? error.message : "配置读取失败。");
			}
		}

		/** 哪些字段可以用「从素材库选」补上地址。 */
		private moduleMediaKind(module: AdminModule, field: ModuleField): "image" | "audio" | null {
			if (module === "music" && field.key === "url") return "audio";
			if (module === "friends" && field.key === "avatar") return "image";
			if (module === "honors" && field.key === "icon") return null;
			return null;
		}

		/** 单个字段控件。 */
		private renderModuleField(field: ModuleField, record: ModuleRecord, index: number) {
			const module = this.module;
			const value = String(record[field.key] ?? "");
			const wide = field.kind === "textarea" ? " admin-field-wide" : "";
			const mediaKind = module ? this.moduleMediaKind(module, field) : null;
			const mediaButton = mediaKind
				? `<button class="admin-secondary-button admin-field-media" data-module-action="pick-media" data-record-index="${index}" data-record-key="${escapeHtml(field.key)}" data-media-kind="${mediaKind}" type="button">从素材库选</button>`
				: "";
			const attrs = `data-record-index="${index}" data-record-key="${escapeHtml(field.key)}"`;
			const control = field.kind === "textarea"
				? `<textarea class="admin-field-input" rows="2" ${attrs} placeholder="${escapeHtml(field.placeholder || "")}">${escapeHtml(value)}</textarea>`
				: `<input class="admin-field-input" type="text" ${attrs} value="${escapeHtml(value)}" placeholder="${escapeHtml(field.placeholder || "")}" />`;
			const hint = field.hint ? `<small class="admin-field-hint">${escapeHtml(field.hint)}</small>` : "";
			const required = field.required ? `<span class="admin-field-required">必填</span>` : "";
			return `<label class="admin-field${wide}"><span class="admin-field-label">${escapeHtml(field.label)}${required}</span><span class="admin-field-row">${control}${mediaButton}</span>${hint}</label>`;
		}

		/** 列表型模块：一条记录一张表单卡，可上移 / 下移 / 删除。 */
		private renderModuleCards(module: AdminModule) {
			const fields = getModuleFields(module);
			if (!this.moduleRecords.length) {
				return `<div class="admin-list-empty"><strong>还没有条目</strong><span>点右上角「+ 新增一条」开始添加。</span></div>`;
			}
			const cards = this.moduleRecords.map((record, index) => {
				const summary = String(record.title || record.name || record.issuer || "").trim() || `第 ${index + 1} 条`;
				const inputs = fields.map((field) => this.renderModuleField(field, record, index)).join("");
				return `<article class="admin-record-card">
					<header class="admin-record-head">
						<span class="admin-record-index">${String(index + 1).padStart(2, "0")}</span>
						<strong>${escapeHtml(summary)}</strong>
						<div class="admin-record-actions">
							<button class="admin-icon-button" data-module-action="move-up" data-record-index="${index}" type="button" aria-label="上移"${index === 0 ? " disabled" : ""}>↑</button>
							<button class="admin-icon-button" data-module-action="move-down" data-record-index="${index}" type="button" aria-label="下移"${index === this.moduleRecords.length - 1 ? " disabled" : ""}>↓</button>
							<button class="admin-icon-button admin-record-remove" data-module-action="remove-record" data-record-index="${index}" type="button" aria-label="删除这条">✕</button>
						</div>
					</header>
					<div class="admin-form-grid">${inputs}</div>
				</article>`;
			}).join("");
			return `<div class="admin-module-cards">${cards}</div>`;
		}

		/** 留言板只有一个配置块，直接渲染成一组字段。 */
		private renderGuestbookForm(module: AdminModule) {
			const record = this.moduleRecords[0] ?? createModuleRecord(module);
			this.moduleRecords = [record];
			const fields = getModuleFields(module).map((field) => this.renderModuleField(field, record, 0)).join("");
			return `<div class="admin-form-grid">${fields}</div>`;
		}

		private renderModuleEditor(error = "") {
			const editor = this.querySelector<HTMLElement>("[data-editor]");
			const module = this.module;
			if (!editor || !module) return;
			const isGuestbook = module === "guestbook";
			const notice = error || this.moduleNotice;
			const stateText = this.moduleLoading ? "正在读取配置…" : this.moduleState;
			const guestbookAdminLink = isGuestbook
				? `<a class="admin-secondary-button admin-admin-link" href="/guestbook/?admin=1" target="_blank" rel="noopener noreferrer">管理现有留言 ↗</a>`
				: "";
			const helper = module === "music"
				? "一首歌一张卡，可以直接从素材库挑音频文件。"
				: module === "honors"
					? "一项荣誉一张卡，日期格式 YYYY-MM。"
					: module === "friends"
						? "一个网站一张卡，头像可以直接从素材库挑图片。"
						: "留言板的标题、简介和 Twikoo 服务地址。";
			const uploadButton = module === "music"
				? `<button class="admin-secondary-button" data-module-action="upload" type="button">${icon("upload")} 上传音频</button>`
				: "";
			const addButton = isGuestbook
				? ""
				: `<button class="admin-secondary-button" data-module-action="add-record" type="button">+ 新增一条</button>`;
			const uploadStatus = module === "music" && this.uploadStatus
				? `<small class="admin-upload-status">${escapeHtml(this.uploadStatus)}</small>`
				: "";
			const tip = module === "music"
				? "音频上传后会作为新的一条加到最后；保存前确认每条都有歌曲名和文件路径。"
				: module === "honors"
					? "保存后关于页面会自动读取并分页显示，每页最多 5 项。"
					: module === "friends"
						? "链接用 http(s) 地址；头像留空时显示名称首字母。"
						: "标题和简介会显示在留言板页顶部；envId 填 /api/twikoo 走本站自带的留言后端。保存后刷新留言板页面即生效。";
			const body = this.moduleLoading
				? `<div class="admin-list-empty">正在读取配置…</div>`
				: isGuestbook
					? this.renderGuestbookForm(module)
					: this.renderModuleCards(module);
			editor.innerHTML = `<div class="admin-editor-topbar admin-module-topbar">
				<span class="admin-save-state" role="status">${escapeHtml(stateText)}</span>
				<div class="admin-editor-actions">${uploadButton}${addButton}${guestbookAdminLink}<button class="admin-primary-button" data-module-action="save" type="button">保存配置</button></div>
			</div>
			${notice ? `<p class="admin-notice" data-module-notice>${escapeHtml(notice)}</p>` : `<p class="admin-notice" data-module-notice hidden></p>`}
			<div class="admin-module-editor">
				<div class="admin-module-heading"><div class="admin-module-heading-icon">${icon(module)}</div><div><p class="admin-eyebrow">${module.toUpperCase()} SETTINGS</p><h2>${this.moduleTitle()}</h2><p>${helper}</p></div></div>
				<div class="admin-module-body" data-module-body>
					${body}
					${uploadStatus}
				</div>
				<div class="admin-module-tip"><strong>保存前检查</strong><span>${tip}</span></div>
			</div>`;
			if (this.mediaPicker) editor.insertAdjacentHTML("beforeend", this.renderMediaPicker());
			if (this.uploadModalOpen) editor.insertAdjacentHTML("beforeend", this.renderUploadModal());
		}

		/** 素材库选择弹窗。 */
		private renderMediaPicker() {
			const picker = this.mediaPicker;
			if (!picker) return "";
			const items = picker.kind === "audio" ? this.pickerAudio : this.pickerImages;
			const list = this.pickerLoading
				? `<p class="admin-upload-hint">正在读取素材库…</p>`
				: items.length
					? `<div class="admin-picker-grid">${items.map((item) => `<button class="admin-picker-item" data-module-action="pick-url" data-pick-url="${escapeHtml(item.url)}" type="button" title="${escapeHtml(item.name)}"><span class="admin-picker-thumb">${picker.kind === "image" ? `<img src="${escapeHtml(item.url)}" alt="" loading="lazy" />` : "♪"}</span><span class="admin-picker-name">${escapeHtml(item.name)}</span></button>`).join("")}</div>`
					: `<p class="admin-upload-hint">素材库里还没有${picker.kind === "image" ? "图片" : "音频"}，先去左边的「素材库」上传。</p>`;
			return `<div class="admin-modal-backdrop" data-modal-backdrop>
				<div class="admin-modal admin-modal-wide" role="dialog" aria-modal="true" aria-label="从素材库选择">
					<header class="admin-modal-head"><strong>从素材库选择${picker.kind === "image" ? "图片" : "音频"}</strong><button class="admin-icon-button" data-module-action="close-picker" type="button" aria-label="关闭">✕</button></header>
					<div class="admin-modal-body">${list}</div>
				</div>
			</div>`;
		}

		private async openMediaPicker(kind: "image" | "audio", index: number, key: string) {
			this.mediaPicker = { kind, index, key };
			this.pickerLoading = true;
			this.pickerImages = [];
			this.pickerAudio = [];
			this.renderModuleEditor();
			try {
				const response = await fetch("/api/admin/media", { credentials: "same-origin" });
				const data = await response.json() as { images?: MediaItem[]; audio?: MediaItem[]; error?: string };
				if (!response.ok) throw new Error(data.error || "素材库读取失败。");
				this.pickerImages = Array.isArray(data.images) ? data.images : [];
				this.pickerAudio = Array.isArray(data.audio) ? data.audio : [];
			} catch (error) {
				this.mediaPicker = null;
				this.moduleNotice = error instanceof Error ? error.message : "素材库读取失败。";
			} finally {
				this.pickerLoading = false;
				this.renderModuleEditor();
			}
		}

		/** 选中素材后把地址写回字段；音乐模块顺手补上歌曲名。 */
		private applyPickedUrl(url: string) {
			const picker = this.mediaPicker;
			if (!picker || !url) return;
			const record = this.moduleRecords[picker.index];
			if (record) {
				record[picker.key] = url;
				if (this.module === "music" && picker.key === "url" && !String(record.title || "").trim()) {
					const name = decodeURIComponent(url.split("/").pop() || "");
					record.title = name.replace(/\.[^.]+$/, "");
				}
			}
			this.mediaPicker = null;
			this.moduleState = "未保存";
			this.renderModuleEditor();
		}

		/** 把表单里当前的值同步回 moduleRecords（保存前兜底）。 */
		private syncModuleFromForm() {
			this.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("input[data-record-index][data-record-key], textarea[data-record-index][data-record-key]").forEach((input) => {
				const index = Number(input.dataset.recordIndex);
				const key = input.dataset.recordKey || "";
				const record = this.moduleRecords[index];
				if (record && key) record[key] = input.value;
			});
		}

		private setList(html: string) {
			const list = this.querySelector<HTMLElement>("[data-list]");
			if (list) list.innerHTML = html;
		}

		private renderList() {
			const list = this.querySelector<HTMLElement>("[data-list]");
			if (!list) return;
			if (!this.items.length) {
				list.innerHTML = `<div class="admin-list-empty"><strong>还没有内容</strong><span>点击上方“新建”开始写作。</span></div>`;
				return;
			}
			list.innerHTML = this.items.map((item) => `<button class="admin-list-item ${this.current?.slug === item.slug ? "is-selected" : ""}" data-action="edit" data-slug="${escapeHtml(item.slug)}" type="button">
				<span class="admin-list-item-icon">${this.kind === "posts" ? "✎" : escapeHtml(item.mood || "☼")}</span>
				<span class="admin-list-item-copy"><strong>${escapeHtml(item.title)}</strong><small>${escapeHtml(item.date || "暂无日期")} · ${item.draft ? "草稿" : item.hidden ? "已隐藏" : "已发布"}</small></span>
				<span class="admin-list-item-arrow">›</span>
			</button>`).join("");
		}

