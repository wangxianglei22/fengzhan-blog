		private async handleSubmit(event: Event) {
			event.preventDefault();
			const form = event.target as HTMLFormElement;
			if (form.id === "login-form") {
				const password = new FormData(form).get("password");
				this.setBusy(true);
				try {
					const response = await fetch("/api/admin/login", { method: "POST", headers: { "content-type": "application/json" }, credentials: "same-origin", body: JSON.stringify({ password }) });
					const data = await response.json() as { error?: string };
					if (!response.ok) throw new Error(data.error || "登录失败。");
					this.renderWorkspace();
					await this.loadItems();
				} catch (error) {
					this.renderLogin(error instanceof Error ? error.message : "登录失败。");
				} finally {
					this.setBusy(false);
				}
				return;
			}
			if (form.id === "module-form") return;
			if (form.id !== "editor-form" || this.busy) return;
			const data = new FormData(form);
			const submitter = (event as SubmitEvent).submitter as HTMLButtonElement | null;
			const payload: Record<string, unknown> = {
				title: data.get("title"),
				slug: data.get("slug"),
				[this.kind === "posts" ? "published" : "date"]: data.get("date"),
				draft: submitter?.dataset.publish !== "true",
				hidden: data.get("hidden") === "on",
				updated: data.get("updated") || "",
				tags: tagsFromInput(String(data.get("tags") || "")),
				body: data.get("body"),
			};
			if (this.kind === "posts") Object.assign(payload, { description: data.get("description"), image: data.get("image"), category: data.get("category"), lang: data.get("lang") });
			else Object.assign(payload, { mood: data.get("mood"), moodLabel: data.get("moodLabel"), excerpt: data.get("excerpt"), cover: data.get("cover"), pinned: data.get("pinned") === "on" });
			this.setBusy(true);
			const state = this.querySelector<HTMLElement>(".admin-save-state");
			if (state) state.textContent = "正在提交…";
			try {
				const editing = Boolean(this.current?.sha);
				const slug = this.current?.slug || "";
				const response = await fetch(editing ? `/api/admin/${this.kind}/${encodeURIComponent(slug)}` : `/api/admin/${this.kind}`, {
					method: editing ? "PUT" : "POST",
					headers: { "content-type": "application/json" },
					credentials: "same-origin",
					body: JSON.stringify(payload),
				});
				const result = await response.json() as Entry | { error?: string };
				if (!response.ok || !("slug" in result)) throw new Error((result as { error?: string }).error || "保存失败。");
				this.current = result;
				this.notice = "已保存，Cloudflare Pages 会自动构建网站。";
				await this.loadItems();
			} catch (error) {
				this.notice = error instanceof Error ? error.message : "保存失败。";
				if (state) state.textContent = "保存失败";
				const notice = this.querySelector<HTMLElement>(".admin-notice");
				if (notice) {
					notice.textContent = this.notice;
					notice.hidden = false;
				}
			} finally {
				this.setBusy(false);
			}
		}

		private handleInput(event: Event) {
			if (!(event.target instanceof Element)) return;
			const recordInput = event.target.closest<HTMLInputElement | HTMLTextAreaElement>("[data-record-index][data-record-key]");
			if (recordInput) {
				const index = Number(recordInput.dataset.recordIndex);
				const key = recordInput.dataset.recordKey || "";
				const record = this.moduleRecords[index];
				if (record && key) {
					record[key] = recordInput.value;
					this.moduleState = "未保存";
					this.moduleNotice = "";
					const moduleState = this.querySelector<HTMLElement>(".admin-save-state");
					if (moduleState) moduleState.textContent = "未保存";
					const moduleNotice = this.querySelector<HTMLElement>("[data-module-notice]");
					if (moduleNotice) {
						moduleNotice.textContent = "";
						moduleNotice.hidden = true;
					}
				}
				return;
			}
			if (!event.target.closest("#editor-form")) return;
			const state = this.querySelector<HTMLElement>(".admin-save-state");
			if (state) state.textContent = "未保存";
			const notice = this.querySelector<HTMLElement>(".admin-notice");
			if (notice) notice.hidden = true;
			this.schedulePreview();
		}

		private async saveModule() {
			const module = this.module;
			if (!module || this.busy) return;
			// 刚打完字直接点保存时，输入框的值可能还没进状态，先读一遍表单。
			this.syncModuleFromForm();
			const blankIndexes = this.moduleRecords
				.map((record, index) => (isBlankRecord(record) ? index : -1))
				.filter((index) => index >= 0);
			const problems = validateModuleRecords(module, this.moduleRecords, { skipIndexes: blankIndexes });
			if (problems.length) {
				this.moduleState = "请修正后重试";
				this.moduleNotice = problems.slice(0, 3).join(" ");
				this.renderModuleEditor();
				return;
			}
			const source = serializeModuleRecords(this.moduleRecords, module);
			if (!source.trim()) {
				this.moduleState = "请修正后重试";
				this.moduleNotice = "内容不能为空。";
				this.renderModuleEditor();
				return;
			}
			this.setBusy(true);
			const state = this.querySelector<HTMLElement>(".admin-save-state");
			if (state) state.textContent = "正在保存…";
			try {
				const response = await fetch(`/api/admin/${module}`, {
					method: "POST",
					headers: { "content-type": "application/json" },
					credentials: "same-origin",
					body: JSON.stringify({ source, sha: this.dataSha }),
				});
				const data = await response.json() as { saved?: boolean; sha?: string; error?: string };
				if (!response.ok || !data.saved) throw new Error(data.error || "保存配置失败。");
				this.dataSha = data.sha || this.dataSha;
				this.moduleRecords = normalizeModuleRecords(module, parseModuleRecords(source));
				this.moduleState = "已保存";
				this.moduleNotice = "已保存，Cloudflare Pages 会自动构建网站。";
				this.renderModuleEditor();
			} catch (error) {
				this.moduleState = "保存失败";
				this.moduleNotice = error instanceof Error ? error.message : "保存配置失败。";
				this.renderModuleEditor();
			} finally {
				this.setBusy(false);
			}
		}

		private async uploadAudio() {
			if (this.module !== "music" || this.busy) return;
			const input = this.querySelector<HTMLInputElement>("input[data-audio-file]");
			const file = input?.files?.[0];
			if (!file) {
				this.uploadStatus = "请先选择一个音频文件。";
				this.renderModuleEditor();
				return;
			}
			// Cloudflare Pages 单文件上限 25 MiB，超出会在构建阶段被拒绝部署。
			const MAX_AUDIO_BYTES = 25 * 1024 * 1024;
			if (file.size > MAX_AUDIO_BYTES) {
				this.uploadStatus = `文件 ${(file.size / 1024 / 1024).toFixed(1)} MiB，超过 Cloudflare Pages 的 25 MiB 上限。请先转成 MP3 或压缩后再上传。`;
				this.renderModuleEditor();
				return;
			}
			this.setBusy(true);
			this.uploadStatus = "正在上传…";
			this.renderModuleEditor();
			try {
				const form = new FormData();
				form.append("file", file);
				const response = await fetch("/api/admin/music", { method: "POST", credentials: "same-origin", body: form });
				const data = await response.json() as { uploaded?: boolean; url?: string; name?: string; error?: string };
				if (!response.ok || !data.uploaded || !data.url) throw new Error(data.error || "音频上传失败。");
				// 上传成功后往配置文本末尾追加一条记录，歌手留空等用户自己补。
				const title = file.name.replace(/\.[^.]+$/, "");
				this.moduleRecords.push({ title, artist: "未知歌手", url: data.url });
				this.moduleState = "未保存";
				this.uploadStatus = `已上传 ${data.name || file.name}，已作为新条目加到最后，确认后点保存生效。`;
				if (input) input.value = "";
				this.uploadModalOpen = false;
				this.renderModuleEditor();
			} catch (error) {
				this.uploadStatus = error instanceof Error ? error.message : "音频上传失败。";
				this.renderModuleEditor();
			} finally {
				this.setBusy(false);
			}
		}

		/** 上传音频弹窗：选择文件 → 开始上传。 */
		private renderUploadModal() {
			return `<div class="admin-modal-backdrop" data-modal-backdrop>
				<div class="admin-modal" role="dialog" aria-modal="true" aria-label="上传音频">
					<header class="admin-modal-head"><strong>上传音频</strong><button class="admin-icon-button" data-upload-action="cancel" type="button" aria-label="关闭">✕</button></header>
					<div class="admin-modal-body">
						<label class="admin-upload-file-label">选择音频文件<input type="file" accept="audio/*,.mp3,.m4a,.ogg,.wav,.flac,.aac" data-audio-file /></label>
						<small class="admin-upload-hint">支持 mp3 / m4a / ogg / wav / flac / aac，单个文件不超过 25 MiB。上传后自动生成一条歌曲记录。</small>
						<small class="admin-upload-status" data-upload-status>${escapeHtml(this.uploadStatus || "")}</small>
					</div>
					<footer class="admin-modal-foot"><button class="admin-secondary-button" data-upload-action="cancel" type="button">取消</button><button class="admin-primary-button" data-upload-action="confirm" type="button">开始上传</button></footer>
				</div>
			</div>`;
		}

		/** 图片上传弹窗：选好文件后上传，正文模式插入 Markdown，封面模式回填地址。 */
		private renderImageModal() {
			const titles: Record<string, string> = { body: "插入本地图片", image: "上传封面图片", cover: "上传封面图片" };
			const title = titles[this.imageTarget] || "上传图片";
			return `<div class="admin-modal-backdrop" data-image-modal-root>
				<div class="admin-modal" role="dialog" aria-modal="true" aria-label="${title}">
					<header class="admin-modal-head"><strong>${title}</strong><button class="admin-icon-button" data-image-action="cancel" type="button" aria-label="关闭">✕</button></header>
					<div class="admin-modal-body">
						<label class="admin-upload-file-label">选择图片文件<input type="file" accept="image/jpeg,image/png,image/gif,image/webp,image/avif,.jpg,.jpeg,.png,.gif,.webp,.avif" data-image-file /></label>
						<small class="admin-upload-hint">支持 jpg / png / gif / webp / avif，单个文件不超过 10 MiB。图片会提交到仓库的 public/images/uploads/，等下次构建完成后才能访问。</small>
						<small class="admin-upload-status" data-image-status role="status">${escapeHtml(this.imageStatus)}</small>
					</div>
					<footer class="admin-modal-foot"><button class="admin-secondary-button" data-image-action="cancel" type="button">取消</button><button class="admin-primary-button" data-image-action="confirm" type="button">开始上传</button></footer>
				</div>
			</div>`;
		}

		/** 打开图片弹窗。弹窗挂在组件外层，避免重渲染把没保存的正文冲掉。 */
		private openImageModal(target: "body" | "image" | "cover") {
			if (this.busy) return;
			this.imageTarget = target;
			this.imageStatus = "";
			if (target === "body") {
				const area = this.querySelector<HTMLTextAreaElement>(".admin-body-input");
				this.imageInsertRange = area ? [area.selectionStart, area.selectionEnd] : null;
			} else {
				this.imageInsertRange = null;
			}
			this.querySelector("[data-image-modal-root]")?.remove();
			this.insertAdjacentHTML("beforeend", this.renderImageModal());
			this.querySelector<HTMLInputElement>("input[data-image-file]")?.focus();
		}

		private closeImageModal() {
			this.querySelector("[data-image-modal-root]")?.remove();
			this.imageStatus = "";
			this.imageInsertRange = null;
		}

		private setImageStatus(message: string) {
			this.imageStatus = message;
			const status = this.querySelector<HTMLElement>("[data-image-status]");
			if (status) status.textContent = message;
		}

		private async uploadImage() {
			if (this.busy) return;
			const modal = this.querySelector<HTMLElement>("[data-image-modal-root]");
			if (!modal) return;
			const input = modal.querySelector<HTMLInputElement>("input[data-image-file]");
			const file = input?.files?.[0];
			if (!file) {
				this.setImageStatus("请先选择一张图片。");
				return;
			}
			const MAX_IMAGE_BYTES = 10 * 1024 * 1024;
			if (file.size > MAX_IMAGE_BYTES) {
				this.setImageStatus(`图片 ${(file.size / 1024 / 1024).toFixed(1)} MiB，超过 10 MiB 上限。请压缩或转成 WebP 后再上传。`);
				return;
			}
			const target = this.imageTarget;
			const range = this.imageInsertRange;
			this.setBusy(true);
			this.setImageStatus("正在上传…");
			try {
				const form = new FormData();
				form.append("file", file);
				const response = await fetch("/api/admin/images", { method: "POST", credentials: "same-origin", body: form });
				const data = await response.json() as { uploaded?: boolean; url?: string; name?: string; error?: string };
				if (!response.ok || !data.uploaded || !data.url) throw new Error(data.error || "图片上传失败。");
				const url = data.url;
				this.closeImageModal();
				if (target === "body") {
					const area = this.querySelector<HTMLTextAreaElement>(".admin-body-input");
					if (area) {
						const start = range ? Math.min(range[0], area.value.length) : area.value.length;
						const end = range ? Math.min(range[1], area.value.length) : area.value.length;
						const alt = file.name.replace(/\.[^.]+$/, "");
						this.uploadedImages.set(url, URL.createObjectURL(file));
						area.setRangeText(`![${alt}](${url})`, start, end, "end");
						area.focus();
						area.dispatchEvent(new Event("input", { bubbles: true }));
					}
				} else {
					const field = this.querySelector<HTMLInputElement>(target === "cover" ? "input[name='cover']" : "input[name='image']");
					if (field) {
						field.value = url;
						field.dispatchEvent(new Event("input", { bubbles: true }));
						field.focus();
					}
				}
				const state = this.querySelector<HTMLElement>(".admin-save-state");
				if (state) state.textContent = "未保存";
			} catch (error) {
				this.setImageStatus(error instanceof Error ? error.message : "图片上传失败。");
			} finally {
				this.setBusy(false);
			}
		}

		private previewTimer = 0;
		// 宽屏下预览默认常显，用 is-collapsed 记住用户的手动收起。
		private previewCollapsed = false;
		// 同一张图拖入两次时复用已上传的地址，避免重复占仓库体积。
		private uploadedFiles = new Map<string, string>();
	// 刚上传的图片还没随仓库构建上线，先用本地 object URL 让预览立即可见。
	private uploadedImages = new Map<string, string>();

	private schedulePreview() {
		window.clearTimeout(this.previewTimer);
		this.previewTimer = window.setTimeout(() => this.updatePreview(), 120);
	}

	private updatePreview() {
		const area = this.querySelector<HTMLTextAreaElement>(".admin-body-input");
		const target = this.querySelector<HTMLElement>("[data-preview]");
		if (!area || !target) return;
		target.innerHTML = this.previewHtml(area.value);
	}

	// 极简 Markdown → HTML：先转义再还原受支持的语法，只用于后台预览，不参与发布。
	private previewHtml(source: string): string {
		const stash: string[] = [];
		const keep = (html: string): string => `\u0000${stash.push(html) - 1}\u0000`;
		const inline = (raw: string): string => {
			let text = escapeHtml(raw);
			text = text.replace(/`([^`]+)`/g, (_match, code: string) => keep(`<code>${code}</code>`));
			text = text.replace(
				/!\[([^\]]*)\]\(([^)\s]+)\)/g,
				(_match, alt: string, src: string) => keep(`<img src="${src}" alt="${alt}" loading="lazy" />`),
			);
			text = text.replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>');
			text = text.replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>");
			text = text.replace(/(^|[^*])\*([^*]+)\*/g, "$1<em>$2</em>");
			return text;
		};
		const lines = source.replace(/\r\n?/g, "\n").split("\n");
		const out: string[] = [];
		let paragraph: string[] = [];
		let listType: "ul" | "ol" | null = null;
		let inCode = false;
		let codeLang = "";
		let codeLines: string[] = [];
		const flushParagraph = () => {
			if (!paragraph.length) return;
			out.push(`<p>${inline(paragraph.join(" "))}</p>`);
			paragraph = [];
		};
		const closeList = () => {
			if (!listType) return;
			out.push(`</${listType}>`);
			listType = null;
		};
		const openList = (type: "ul" | "ol") => {
			if (listType === type) return;
			closeList();
			out.push(`<${type}>`);
			listType = type;
		};
		for (const line of lines) {
			const trimmed = line.trim();
			const fence = /^```(.*)$/.exec(trimmed);
			if (!inCode && fence) {
				flushParagraph();
				closeList();
				inCode = true;
				codeLang = fence[1].trim();
				codeLines = [];
				continue;
			}
			if (inCode) {
				if (trimmed === "```") {
					out.push(`<pre><code${codeLang ? ` class="language-${escapeHtml(codeLang)}"` : ""}>${escapeHtml(codeLines.join("\n"))}</code></pre>`);
					inCode = false;
					codeLines = [];
					codeLang = "";
				} else {
					codeLines.push(line);
				}
				continue;
			}
			if (!trimmed) {
				flushParagraph();
				closeList();
				continue;
			}
			const heading = /^(#{1,4})\s+(.*)$/.exec(trimmed);
			if (heading) {
				flushParagraph();
				closeList();
				const level = Math.min(heading[1].length, 4);
				out.push(`<h${level}>${inline(heading[2])}</h${level}>`);
				continue;
			}
			if (/^(-{3,}|\*{3,})$/.test(trimmed)) {
				flushParagraph();
				closeList();
				out.push("<hr />");
				continue;
			}
			const quote = /^>\s?(.*)$/.exec(trimmed);
			if (quote) {
				flushParagraph();
				closeList();
				out.push(`<blockquote>${inline(quote[1])}</blockquote>`);
				continue;
			}
			const bullet = /^[-*+]\s+(.*)$/.exec(trimmed);
			if (bullet) {
				flushParagraph();
				openList("ul");
				out.push(`<li>${inline(bullet[1])}</li>`);
				continue;
			}
			const ordered = /^\d+\.\s+(.*)$/.exec(trimmed);
			if (ordered) {
				flushParagraph();
				openList("ol");
				out.push(`<li>${inline(ordered[1])}</li>`);
				continue;
			}
			closeList();
			paragraph.push(trimmed);
		}
		flushParagraph();
		closeList();
		if (inCode && codeLines.length) {
			out.push(`<pre><code${codeLang ? ` class="language-${escapeHtml(codeLang)}"` : ""}>${escapeHtml(codeLines.join("\n"))}</code></pre>`);
		}
		const html = out.join("");
		if (!html) return '<p class="admin-preview-empty">粘贴或输入正文后，这里会实时显示排版效果，图片也会直接显示出来。</p>';
		let restored = html.replace(/\u0000(\d+)\u0000/g, (_match, index: string) => stash[Number(index)] ?? "");
		// 占位符还原之后再换成本地预览地址，否则图片 URL 还藏在 stash 里替换不到。
		this.uploadedImages.forEach((blobUrl, remoteUrl) => {
			restored = restored.split(remoteUrl).join(blobUrl);
		});
		return restored;
	}

	private showImageToast(message: string, tone: "info" | "error") {
		let toast = this.querySelector<HTMLElement>("[data-image-toast]");
		if (!toast) {
			toast = document.createElement("div");
			toast.className = "admin-image-toast";
			toast.setAttribute("data-image-toast", "");
			this.append(toast);
		}
		toast.textContent = message;
		toast.dataset.tone = tone;
		toast.hidden = false;
		window.clearTimeout(this.toastTimer);
		const delay = tone === "error" ? 8000 : 2600;
		this.toastTimer = window.setTimeout(() => {
			if (toast) toast.hidden = true;
		}, delay);
	}

	private toastTimer = 0;

	// 把粘贴 / 拖入的图片直接上传，成功后按当前光标插入 Markdown。
	private async uploadInlineImage(file: File) {
		const allowed = ["image/jpeg", "image/png", "image/gif", "image/webp", "image/avif"];
		if (!allowed.includes(file.type)) {
			this.showImageToast("只支持 jpg / png / gif / webp / avif 图片。", "error");
			return;
		}
		if (file.size > 10 * 1024 * 1024) {
			this.showImageToast(`图片 ${(file.size / 1024 / 1024).toFixed(1)} MiB，超过 10 MiB 上限，请压缩后再粘贴。`, "error");
			return;
		}
		const area = this.querySelector<HTMLTextAreaElement>(".admin-body-input");
		const range: [number, number] = area ? [area.selectionStart, area.selectionEnd] : [0, 0];
		const cacheKey = `${file.name}:${file.size}:${file.lastModified}`;
		const cached = this.uploadedFiles.get(cacheKey);
		if (cached) {
			this.insertUploadedImage(cached, file, range);
			return;
		}
		this.showImageToast("正在上传图片…", "info");
		this.setBusy(true);
		try {
			const form = new FormData();
			form.append("file", file);
			const response = await fetch("/api/admin/images", { method: "POST", credentials: "same-origin", body: form });
			const data = await response.json() as { uploaded?: boolean; url?: string; error?: string };
			if (!response.ok || !data.uploaded || !data.url) throw new Error(data.error || "图片上传失败。");
			this.uploadedFiles.set(cacheKey, data.url);
			this.insertUploadedImage(data.url, file, range);
		} catch (error) {
			this.showImageToast(error instanceof Error ? error.message : "图片上传失败。", "error");
		} finally {
			this.setBusy(false);
		}
	}

	// 按记录的光标位置把图片插进正文；预览用本地地址，避免等下次构建。
	private insertUploadedImage(url: string, file: File, range: [number, number]) {
		const target = this.querySelector<HTMLTextAreaElement>(".admin-body-input");
		if (!target) return;
		const alt = (file.name || "粘贴的图片").replace(/\.[^.]+$/, "");
		const start = Math.min(range[0], target.value.length);
		const end = Math.min(range[1], target.value.length);
		this.uploadedImages.set(url, URL.createObjectURL(file));
		target.setRangeText(`![${alt}](${url})`, start, end, "end");
		target.focus();
		target.dispatchEvent(new Event("input", { bubbles: true }));
		this.updatePreview();
		this.showImageToast("图片已插入正文。", "info");
	}

	private handlePaste = (event: ClipboardEvent) => {
		const target = event.target;
		if (!(target instanceof HTMLTextAreaElement) || !target.closest("#editor-form")) return;
		const items = event.clipboardData?.items;
		if (!items) return;
		for (const item of items) {
			if (item.kind !== "file" || !item.type.startsWith("image/")) continue;
			const file = item.getAsFile();
			if (!file) continue;
			event.preventDefault();
			void this.uploadInlineImage(file);
			return;
		}
	};

	private handleDragOver = (event: DragEvent) => {
		const target = event.target;
		if (!(target instanceof Element) || !target.closest("#editor-form")) return;
		if (!event.dataTransfer || !event.dataTransfer.types.includes("Files")) return;
		event.preventDefault();
		event.dataTransfer.dropEffect = "copy";
	};

	private handleDrop = (event: DragEvent) => {
		const target = event.target;
		if (!(target instanceof Element) || !target.closest("#editor-form")) return;
		const files = event.dataTransfer?.files;
		if (!files || !files.length) return;
		const file = Array.from(files).find((candidate) => candidate.type.startsWith("image/"));
		if (!file) return;
		event.preventDefault();
		void this.uploadInlineImage(file);
	};

	private insertMarkdown(format: string) {
			const area = this.querySelector<HTMLTextAreaElement>(".admin-body-input");
			if (!area) return;
			const start = area.selectionStart;
			const end = area.selectionEnd;
			const selected = area.value.slice(start, end);
			const snippets: Record<string, string> = {
				heading: `## ${selected || "标题"}`,
				bold: `**${selected || "加粗文字"}**`,
				italic: `*${selected || "斜体文字"}*`,
				quote: `> ${selected || "引用内容"}`,
				list: `- ${selected || "列表项"}`,
				link: `[${selected || "链接文字"}](https://)`,
				code: `\`\`\`\n${selected || "const hello = \"world\";"}\n\`\`\``,
				image: `![${selected || "图片说明"}](/images/example.jpg)`,
				table: `| 表头 | 表头 |\n| --- | --- |\n| ${selected || "内容"} | 内容 |`,
				rule: "\n---\n",
			};
			if (!snippets[format]) return;
			area.setRangeText(snippets[format], start, end, "end");
			area.focus();
			area.dispatchEvent(new Event("input", { bubbles: true }));
		}

		private toggleEmojiMenu(button: HTMLButtonElement) {
			// 心情选择器的触发按钮在 .admin-mood-input 里、菜单是它的兄弟节点，
			// 只查 parentElement 永远找不到菜单（心情表情打不开的根因），
			// 所以先向上找到最近的容器（心情选择器 / 工具栏表情包装）再找菜单。
			const scope = button.closest("[data-mood-picker], .admin-emoji-wrap") ?? button.parentElement;
			const menu = scope?.querySelector<HTMLElement>("[data-emoji-menu]");
			if (!menu) return;
			const willOpen = menu.hidden;
			// 同一时间只保留一个表情菜单打开
			this.querySelectorAll<HTMLElement>("[data-emoji-menu]").forEach((other) => {
				other.hidden = true;
			});
			menu.hidden = !willOpen;
		}

		private chooseEmoji(value: string, button?: HTMLButtonElement) {
			const moodInput = this.querySelector<HTMLInputElement>("input[name='mood']");
			const moodPicker = this.querySelector<HTMLElement>("[data-mood-picker]");
			if (moodPicker && button?.closest("[data-mood-picker]")) {
				if (moodInput) moodInput.value = value;
				moodPicker.querySelector<HTMLElement>("[data-emoji-menu]")?.setAttribute("hidden", "true");
				moodInput?.dispatchEvent(new Event("input", { bubbles: true }));
				return;
			}
			const area = this.querySelector<HTMLTextAreaElement>(".admin-body-input");
			if (!area) return;
			area.setRangeText(value, area.selectionStart, area.selectionEnd, "end");
			area.focus();
			area.dispatchEvent(new Event("input", { bubbles: true }));
			// 收起的是「被点的那一组」菜单，不能一刀切收第一个（会把另一个菜单留着）
			const scope = button?.closest("[data-mood-picker], .admin-emoji-wrap") ?? this;
			scope.querySelector<HTMLElement>("[data-emoji-menu]")?.setAttribute("hidden", "true");
		}

		private async handleClick(event: Event) {
			const target = event.target;
			if (!(target instanceof Element)) return;
			const button = target.closest<HTMLButtonElement>("button[data-action], button[data-kind], button[data-module], button[data-module-action], button[data-upload-action], button[data-image-target], button[data-image-action], button[data-copy], button[data-media-delete], button[data-media-refresh], button[data-preview-toggle], button[data-format], button[data-emoji]");
			if (!button || this.busy) return;
			if (button.dataset.emoji) {
				this.chooseEmoji(button.dataset.emoji, button);
				return;
			}
			if (button.dataset.previewToggle !== undefined) {
				const preview = this.querySelector<HTMLElement>(".admin-preview");
				if (preview) {
					const wide = window.matchMedia("(min-width: 1280px)").matches;
					const className = wide ? "is-collapsed" : "is-open";
					preview.classList.toggle(className);
					const hidden = wide
						? preview.classList.contains("is-collapsed")
						: !preview.classList.contains("is-open");
					this.previewCollapsed = hidden;
					button.classList.toggle("is-active", !hidden);
				}
				return;
			}
			if (button.dataset.imageTarget) {
				const target = button.dataset.imageTarget;
				this.openImageModal(target === "image" ? "image" : target === "cover" ? "cover" : "body");
				return;
			}
			if (button.dataset.format) {
				if (button.dataset.format === "emoji") {
					this.toggleEmojiMenu(button);
					return;
				}
				this.insertMarkdown(button.dataset.format);
				return;
			}
			if (button.dataset.module) {
				this.module = button.dataset.module as AdminModule;
				this.current = null;
				this.notice = "";
				this.renderWorkspace();
				await this.loadModule();
				return;
			}
			if (button.dataset.moduleAction === "save") {
				await this.saveModule();
				return;
			}
			if (button.dataset.moduleAction === "upload") {
				// 打开上传弹窗，选好文件后点「开始上传」
				this.uploadModalOpen = true;
				this.uploadStatus = "";
				this.renderModuleEditor();
				return;
			}
			if (button.dataset.uploadAction) {
				if (button.dataset.uploadAction === "cancel") {
					this.uploadModalOpen = false;
					this.renderModuleEditor();
					return;
				}
				if (button.dataset.uploadAction === "confirm") {
					await this.uploadAudio();
					return;
				}
			}
			if (button.dataset.imageAction) {
				if (button.dataset.imageAction === "cancel") {
					this.closeImageModal();
					return;
				}
				if (button.dataset.imageAction === "confirm") {
					await this.uploadImage();
					return;
				}
			}
			if (button.dataset.moduleAction === "add-record") {
				if (!this.module) return;
				this.moduleRecords.push(createModuleRecord(this.module));
				this.moduleState = "未保存";
				this.moduleNotice = "";
				this.renderModuleEditor();
				return;
			}
			if (button.dataset.moduleAction === "remove-record") {
				const index = Number(button.dataset.recordIndex);
				if (Number.isInteger(index)) {
					this.moduleRecords.splice(index, 1);
					this.moduleState = "未保存";
					this.renderModuleEditor();
				}
				return;
			}
			if (button.dataset.moduleAction === "move-up" || button.dataset.moduleAction === "move-down") {
				const index = Number(button.dataset.recordIndex);
				const next = button.dataset.moduleAction === "move-up" ? index - 1 : index + 1;
				if (Number.isInteger(index) && next >= 0 && next < this.moduleRecords.length) {
					const [record] = this.moduleRecords.splice(index, 1);
					this.moduleRecords.splice(next, 0, record);
					this.moduleState = "未保存";
					this.renderModuleEditor();
				}
				return;
			}
			if (button.dataset.moduleAction === "pick-media") {
				const index = Number(button.dataset.recordIndex);
				const key = button.dataset.recordKey || "";
				const kind = button.dataset.mediaKind === "audio" ? "audio" : "image";
				await this.openMediaPicker(kind, index, key);
				return;
			}
			if (button.dataset.moduleAction === "pick-url") {
				this.applyPickedUrl(button.dataset.pickUrl || "");
				return;
			}
			if (button.dataset.moduleAction === "close-picker") {
				this.mediaPicker = null;
				this.renderModuleEditor();
				return;
			}
			if (button.dataset.kind) {
				this.module = null;
				if (button.dataset.kind === "media") {
					this.mediaView = true;
					this.current = null;
					this.notice = "";
					await this.loadMedia();
					return;
				}
				this.mediaView = false;
				this.kind = button.dataset.kind as CollectionName;
				this.current = null;
				this.notice = "";
				this.renderWorkspace();
				await this.loadItems();
				return;
			}
			if (button.dataset.copy) {
				await this.copyText(button.dataset.copy);
				return;
			}
			if (button.dataset.mediaDelete) {
				await this.deleteMedia(button.dataset.mediaDelete);
				return;
			}
			if (button.dataset.mediaRefresh !== undefined) {
				await this.loadMedia();
				return;
			}
			switch (button.dataset.action) {
				case "new":
					this.current = emptyEntry(this.kind);
					this.notice = "";
					this.renderList();
					this.renderEditor();
					break;
				case "edit":
					this.current = this.items.find((item) => item.slug === button.dataset.slug) || null;
					this.notice = "";
					this.renderList();
					this.renderEditor();
					break;
				case "cancel":
					this.current = null;
					this.notice = "";
					this.renderList();
					this.renderEditor();
					break;
				case "delete":
					await this.deleteCurrent();
					break;
				case "logout":
					await fetch("/api/admin/logout", { method: "POST", credentials: "same-origin" });
					this.current = null;
					this.renderLogin();
					break;
			}
		}

		private async deleteCurrent() {
			if (!this.current?.slug || !confirm(`确定删除“${this.current.title}”吗？此操作会提交 GitHub 删除记录。`)) return;
			this.setBusy(true);
			try {
				const response = await fetch(`/api/admin/${this.kind}/${encodeURIComponent(this.current.slug)}`, { method: "DELETE", credentials: "same-origin" });
				const data = await response.json() as { error?: string };
				if (!response.ok) throw new Error(data.error || "删除失败。");
				this.current = null;
				this.notice = "内容已删除。";
				await this.loadItems();
			} catch (error) {
				this.notice = error instanceof Error ? error.message : "删除失败。";
				this.renderEditor();
			} finally {
				this.setBusy(false);
			}
		}

		private setBusy(value: boolean) {
			this.busy = value;
			this.classList.toggle("is-busy", value);
		}
	}

	if (!customElements.get("admin-app")) customElements.define("admin-app", AdminApp);
</script>

