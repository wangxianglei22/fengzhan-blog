---
import { Icon } from "astro-icon/components";
import BackHomeLink from "../components/BackHomeLink.astro";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { groupFriendsByCategory, parseFriends } from "../utils/friends";
import { url } from "../utils/url-utils";
import friendsSource from "../data/friends.md?raw";

const friends = parseFriends(friendsSource);
const groups = groupFriendsByCategory(friends);
---

<MainGridLayout title="常用网站" description="常去的网站与工具">
	<div class="friends-page">
		<BackHomeLink />
		<header class="friends-heading">
			<div>
				<span class="friends-kicker">FAVORITE SITES</span>
				<h1><Icon name="fa6-brands:canadian-maple-leaf" /> 常用网站</h1>
				<p>常去的地方，顺手记在这里。</p>
			</div>
			<div class="friends-count"><strong>{friends.length}</strong><span>个站点</span></div>
		</header>

		{friends.length ? (
			<div class="friends-groups">
				{groups.map((group) => (
					<section class="friends-group">
						<div class="friends-group-heading">
							<span class="friends-group-name">{group.category}</span>
							<span class="friends-group-count">{group.items.length}</span>
						</div>
						<div class="friends-grid" role="list">
							{group.items.map((friend) => (
								<a class="friend-card" href={friend.url} target="_blank" rel="noopener noreferrer" role="listitem">
									<div class="friend-card-top">
										<div class="friend-avatar">
											{friend.avatar ? <img src={friend.avatar.startsWith("/") ? url(friend.avatar) : friend.avatar} alt={`${friend.name} 的头像`} loading="lazy" referrerpolicy="no-referrer" /> : <span aria-hidden="true">{friend.name.slice(0, 1)}</span>}
										</div>
										<Icon class="friend-arrow" name="fa6-solid:arrow-up-right-from-square" aria-hidden="true" />
									</div>
									<h2>{friend.name}</h2>
									<p>{friend.description}</p>
								</a>
							))}
						</div>
					</section>
				))}
			</div>
		) : (
			<div class="friends-empty">
				<div class="friends-empty-icon"><Icon name="fa6-brands:canadian-maple-leaf" /></div>
				<div>
					<strong>名单还在等待添加</strong>
					<p>常去的站点，都值得被记住。</p>
				</div>
			</div>
		)}

		<div class="friends-note">
			<Icon name="material-symbols:edit-note-rounded" />
			<a class="friends-note-link" href={url("guestbook/")}>想交换链接？把你的站点名称、主页地址、头像和一句简介发给我吧。</a>
		</div>
	</div>
</MainGridLayout>

<style>
	.friends-page { width: 100%; max-width: 68rem; margin: 0 auto; color: var(--deep-text); }
	.friends-heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: 1.1rem; padding: 0.4rem 0.35rem 1rem; border-bottom: 1px dashed color-mix(in srgb, var(--deep-text) 16%, transparent); }
	.friends-kicker { color: color-mix(in srgb, var(--primary) 72%, var(--deep-text)); font-size: 0.64rem; font-weight: 800; letter-spacing: 0.1em; }
	.friends-heading h1 { display: flex; align-items: center; gap: 0.45rem; margin: 0.35rem 0 0; color: var(--deep-text); font-size: clamp(1.85rem, 4.4vw, 2.6rem); font-weight: 500; letter-spacing: -0.035em; line-height: 1; }
	.friends-heading h1 :global(svg) { width: 1.45rem; height: 1.45rem; color: var(--primary); }
	.friends-heading p { margin: 0.5rem 0 0; color: color-mix(in srgb, var(--deep-text) 56%, transparent); font-size: 0.8rem; }
	.friends-count { display: grid; justify-items: end; gap: 0.15rem; padding: 0.5rem 0.7rem; border: 1px solid color-mix(in srgb, var(--primary) 20%, transparent); border-radius: 0.8rem; color: color-mix(in srgb, var(--deep-text) 50%, transparent); background: color-mix(in srgb, var(--primary) 5%, transparent); font-size: 0.6rem; }
	.friends-count strong { color: var(--primary); font-size: 1.1rem; line-height: 1; }
	.friends-groups { display: grid; gap: 1.1rem; }
	.friends-group-heading { display: flex; align-items: center; gap: 0.45rem; margin-bottom: 0.55rem; padding-left: 0.15rem; }
	.friends-group-name { color: color-mix(in srgb, var(--deep-text) 72%, transparent); font-size: 0.78rem; font-weight: 750; }
	.friends-group-count { display: inline-grid; place-items: center; min-width: 1.25rem; height: 1.25rem; padding: 0 0.35rem; border-radius: 999px; color: var(--primary); background: color-mix(in srgb, var(--primary) 12%, transparent); font-size: 0.62rem; font-weight: 800; }
	.friends-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.7rem; }
	.friend-card { position: relative; isolation: isolate; display: grid; min-width: 0; overflow: hidden; padding: 0.85rem; border: 1px solid color-mix(in srgb, var(--deep-text) 11%, transparent); border-radius: 0.85rem; color: inherit; background: color-mix(in srgb, var(--card-bg) 62%, transparent); box-shadow: 0 0.4rem 1.1rem color-mix(in srgb, var(--deep-text) 5%, transparent); text-decoration: none; transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
	}
	.friend-card:hover, .friend-card:focus-visible { transform: translateY(-3px); border-color: color-mix(in srgb, var(--primary) 34%, transparent); box-shadow: 0 0.8rem 1.6rem color-mix(in srgb, var(--deep-text) 10%, transparent); }
	.friend-card:focus-visible { outline: 2px solid var(--primary); outline-offset: 3px; }
	.friend-card-glow { position: absolute; z-index: -1; top: -5rem; right: -4rem; width: 11rem; height: 11rem; border-radius: 50%; background: color-mix(in srgb, var(--primary) 12%, transparent); filter: blur(23px); opacity: 0.7; transition: transform 220ms ease, opacity 220ms ease; }
	.friend-card:hover .friend-card-glow { transform: scale(1.2); opacity: 1; }
	.friend-card-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 0.4rem; }
	.friend-avatar { display: grid; place-items: center; width: 2.5rem; aspect-ratio: 1; overflow: hidden; border: 1.5px solid color-mix(in srgb, var(--primary) 30%, white); border-radius: 0.75rem; color: var(--primary); background: color-mix(in srgb, var(--primary) 11%, var(--card-bg)); box-shadow: 0 0.25rem 0.6rem color-mix(in srgb, var(--deep-text) 8%, transparent); font-size: 0.95rem; font-weight: 800; transition: transform 180ms ease; }
	.friend-avatar img { width: 100%; height: 100%; object-fit: cover; }
	.friend-card:hover .friend-avatar { transform: rotate(-5deg) scale(1.06); }
	.friend-arrow { width: 0.7rem; height: 0.7rem; color: color-mix(in srgb, var(--deep-text) 38%, transparent); transition: transform 180ms ease, color 180ms ease; }
	.friend-card:hover .friend-arrow { transform: translate(2px, -2px); color: var(--primary); }
	.friend-card h2 { margin: 0.6rem 0 0.15rem; overflow: hidden; color: var(--deep-text); font-size: 0.86rem; font-weight: 750; text-overflow: ellipsis; white-space: nowrap; }
	.friend-card p { display: -webkit-box; min-height: 2.1rem; overflow: hidden; margin: 0; color: color-mix(in srgb, var(--deep-text) 58%, transparent); font-size: 0.66rem; line-height: 1.5; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
	.friends-empty { display: flex; align-items: center; gap: 0.8rem; padding: 1.25rem; border: 1px dashed color-mix(in srgb, var(--primary) 28%, transparent); border-radius: 1rem; color: color-mix(in srgb, var(--deep-text) 68%, transparent); background: color-mix(in srgb, var(--primary) 5%, transparent); }
	.friends-empty-icon { display: grid; flex: 0 0 auto; place-items: center; width: 2.5rem; aspect-ratio: 1; border-radius: 0.8rem; color: var(--primary); background: color-mix(in srgb, var(--primary) 12%, transparent); }
	.friends-empty-icon :global(svg) { width: 1.25rem; height: 1.25rem; }
	.friends-empty strong { color: var(--deep-text); font-size: 0.85rem; }
	.friends-empty p { margin: 0.25rem 0 0; font-size: 0.72rem; line-height: 1.6; }
	.friends-empty code { color: var(--primary); font-size: 0.68rem; }
	.friends-note { display: flex; align-items: center; gap: 0.5rem; margin-top: 1.1rem; padding: 0.65rem 0.85rem; border: 1px solid color-mix(in srgb, var(--primary) 20%, transparent); border-radius: 0.8rem; color: color-mix(in srgb, var(--deep-text) 56%, transparent); background: color-mix(in srgb, var(--card-bg) 42%, transparent); font-size: 0.7rem; }
	.friends-note :global(svg) { flex: 0 0 auto; width: 1rem; height: 1rem; color: var(--primary); }
	.friends-note-link { color: inherit; text-decoration: none; border-bottom: 1px dashed color-mix(in srgb, var(--primary) 45%, transparent); transition: color 160ms ease, border-color 160ms ease; }
	.friends-note-link:hover, .friends-note-link:focus-visible { color: var(--primary); border-bottom-color: var(--primary); }
	@media (max-width: 1023px) {
		.friends-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
	}
	@media (max-width: 767px) {
		.friends-heading { align-items: flex-start; }
		.friends-heading h1 { font-size: 2rem; }
		.friends-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.55rem; }
		.friend-card { padding: 0.7rem; }
		.friend-avatar { width: 2.1rem; border-radius: 0.65rem; }
		.friends-note { align-items: flex-start; }
	}
	@media (max-width: 460px) {
		.friends-heading { flex-direction: column; }
		.friends-count { justify-items: start; }
		.friends-grid { grid-template-columns: 1fr; }
	}
	@media (prefers-reduced-motion: reduce) {
		.friend-card, .friend-card-glow, .friend-avatar, .friend-arrow { transition: none; }
	}
</style>
