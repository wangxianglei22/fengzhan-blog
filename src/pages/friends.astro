---
import { Icon } from "astro-icon/components";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { parseFriends } from "../utils/friends";
import { url } from "../utils/url-utils";
import friendsSource from "../data/friends.md?raw";

const friends = parseFriends(friendsSource);
---

<MainGridLayout title="友链" description="认识一些有趣的个人博客和网站">
	<div class="friends-page">
		<header class="friends-heading">
			<div>
				<span class="friends-kicker">FRIEND LINKS</span>
				<h1><Icon name="fa6-brands:canadian-maple-leaf" /> 朋友们的小站</h1>
				<p>在不同的角落，记录各自喜欢的生活。</p>
			</div>
			<div class="friends-count"><strong>{friends.length}</strong><span>个友链</span></div>
		</header>

		{friends.length ? (
			<div class="friends-grid" role="list">
				{friends.map((friend) => (
					<a class="friend-card" href={friend.url} target="_blank" rel="noopener noreferrer" role="listitem">
						<div class="friend-card-glow" aria-hidden="true"></div>
						<div class="friend-card-top">
							<div class="friend-avatar">
								{friend.avatar ? <img src={friend.avatar.startsWith("/") ? url(friend.avatar) : friend.avatar} alt={`${friend.name} 的头像`} loading="lazy" referrerpolicy="no-referrer" /> : <span aria-hidden="true">{friend.name.slice(0, 1)}</span>}
							</div>
							<Icon class="friend-arrow" name="fa6-solid:arrow-up-right-from-square" aria-hidden="true" />
						</div>
						<h2>{friend.name}</h2>
						<p>{friend.description}</p>
						<span class="friend-visit">访问小站 <Icon name="material-symbols:arrow-forward-rounded" /></span>
					</a>
				))}
			</div>
		) : (
			<div class="friends-empty">
				<div class="friends-empty-icon"><Icon name="fa6-brands:canadian-maple-leaf" /></div>
				<div>
					<strong>友链名单还在等待添加</strong>
					<p>编辑 <code>src/data/friends.md</code>，每段使用 name、url、avatar 和 description 字段。</p>
				</div>
			</div>
		)}

		<div class="friends-note">
			<Icon name="material-symbols:edit-note-rounded" />
			<span>想交换友链？把你的站点名称、主页地址、头像和一句简介发给我吧。</span>
		</div>
	</div>
</MainGridLayout>

<style>
	.friends-page { width: 100%; max-width: 68rem; margin: 0 auto; color: var(--deep-text); }
	.friends-heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: 1.35rem; padding: 0.4rem 0.35rem 1.2rem; border-bottom: 1px dashed color-mix(in srgb, var(--deep-text) 16%, transparent); }
	.friends-kicker { color: color-mix(in srgb, var(--primary) 72%, var(--deep-text)); font-size: 0.64rem; font-weight: 800; letter-spacing: 0.1em; }
	.friends-heading h1 { display: flex; align-items: center; gap: 0.45rem; margin: 0.35rem 0 0; color: var(--deep-text); font-size: clamp(2rem, 5vw, 3.1rem); font-weight: 500; letter-spacing: -0.035em; line-height: 1; }
	.friends-heading h1 :global(svg) { width: 1.6rem; height: 1.6rem; color: var(--primary); }
	.friends-heading p { margin: 0.55rem 0 0; color: color-mix(in srgb, var(--deep-text) 56%, transparent); font-size: 0.82rem; }
	.friends-count { display: grid; justify-items: end; gap: 0.15rem; padding: 0.55rem 0.75rem; border: 1px solid color-mix(in srgb, var(--primary) 20%, transparent); border-radius: 0.8rem; color: color-mix(in srgb, var(--deep-text) 50%, transparent); background: color-mix(in srgb, var(--primary) 5%, transparent); font-size: 0.62rem; }
	.friends-count strong { color: var(--primary); font-size: 1.25rem; line-height: 1; }
	.friends-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.9rem; }
	.friend-card { position: relative; isolation: isolate; min-width: 0; overflow: hidden; padding: 1.15rem; border: 1px solid color-mix(in srgb, var(--deep-text) 11%, transparent); border-radius: 1rem; color: inherit; background: color-mix(in srgb, var(--card-bg) 62%, transparent); box-shadow: 0 0.6rem 1.6rem color-mix(in srgb, var(--deep-text) 5%, transparent); text-decoration: none; transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
	}
	.friend-card:hover, .friend-card:focus-visible { transform: translateY(-4px); border-color: color-mix(in srgb, var(--primary) 34%, transparent); box-shadow: 0 1rem 2rem color-mix(in srgb, var(--deep-text) 10%, transparent); }
	.friend-card:focus-visible { outline: 2px solid var(--primary); outline-offset: 3px; }
	.friend-card-glow { position: absolute; z-index: -1; top: -5rem; right: -4rem; width: 11rem; height: 11rem; border-radius: 50%; background: color-mix(in srgb, var(--primary) 12%, transparent); filter: blur(23px); opacity: 0.7; transition: transform 220ms ease, opacity 220ms ease; }
	.friend-card:hover .friend-card-glow { transform: scale(1.2); opacity: 1; }
	.friend-card-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 0.6rem; }
	.friend-avatar { display: grid; place-items: center; width: 3.65rem; aspect-ratio: 1; overflow: hidden; border: 2px solid color-mix(in srgb, var(--primary) 30%, white); border-radius: 1.1rem; color: var(--primary); background: color-mix(in srgb, var(--primary) 11%, var(--card-bg)); box-shadow: 0 0.35rem 0.9rem color-mix(in srgb, var(--deep-text) 8%, transparent); font-size: 1.25rem; font-weight: 800; transition: transform 180ms ease; }
	.friend-avatar img { width: 100%; height: 100%; object-fit: cover; }
	.friend-card:hover .friend-avatar { transform: rotate(-5deg) scale(1.06); }
	.friend-arrow { width: 0.8rem; height: 0.8rem; color: color-mix(in srgb, var(--deep-text) 38%, transparent); transition: transform 180ms ease, color 180ms ease; }
	.friend-card:hover .friend-arrow { transform: translate(2px, -2px); color: var(--primary); }
	.friend-card h2 { margin: 1rem 0 0.3rem; overflow: hidden; color: var(--deep-text); font-size: 1rem; font-weight: 750; text-overflow: ellipsis; white-space: nowrap; }
	.friend-card p { display: -webkit-box; min-height: 2.9rem; overflow: hidden; margin: 0; color: color-mix(in srgb, var(--deep-text) 58%, transparent); font-size: 0.72rem; line-height: 1.55; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
	.friend-visit { display: inline-flex; align-items: center; gap: 0.3rem; margin-top: 0.95rem; color: color-mix(in srgb, var(--primary) 78%, var(--deep-text)); font-size: 0.66rem; font-weight: 750; }
	.friend-visit :global(svg) { width: 0.8rem; height: 0.8rem; transition: transform 160ms ease; }
	.friend-card:hover .friend-visit :global(svg) { transform: translateX(3px); }
	.friends-empty { display: flex; align-items: center; gap: 0.8rem; padding: 1.25rem; border: 1px dashed color-mix(in srgb, var(--primary) 28%, transparent); border-radius: 1rem; color: color-mix(in srgb, var(--deep-text) 68%, transparent); background: color-mix(in srgb, var(--primary) 5%, transparent); }
	.friends-empty-icon { display: grid; flex: 0 0 auto; place-items: center; width: 2.5rem; aspect-ratio: 1; border-radius: 0.8rem; color: var(--primary); background: color-mix(in srgb, var(--primary) 12%, transparent); }
	.friends-empty-icon :global(svg) { width: 1.25rem; height: 1.25rem; }
	.friends-empty strong { color: var(--deep-text); font-size: 0.85rem; }
	.friends-empty p { margin: 0.25rem 0 0; font-size: 0.72rem; line-height: 1.6; }
	.friends-empty code { color: var(--primary); font-size: 0.68rem; }
	.friends-note { display: flex; align-items: center; gap: 0.5rem; margin-top: 1.1rem; padding: 0.65rem 0.85rem; border: 1px solid color-mix(in srgb, var(--primary) 20%, transparent); border-radius: 0.8rem; color: color-mix(in srgb, var(--deep-text) 56%, transparent); background: color-mix(in srgb, var(--card-bg) 42%, transparent); font-size: 0.7rem; }
	.friends-note :global(svg) { flex: 0 0 auto; width: 1rem; height: 1rem; color: var(--primary); }
	@media (max-width: 767px) {
		.friends-heading { align-items: flex-start; }
		.friends-heading h1 { font-size: 2.35rem; }
		.friends-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.65rem; }
		.friend-card { padding: 0.9rem; }
		.friend-avatar { width: 3.1rem; border-radius: 0.9rem; }
		.friends-note { align-items: flex-start; }
	}
	@media (max-width: 460px) {
		.friends-heading { flex-direction: column; }
		.friends-count { justify-items: start; }
		.friends-grid { grid-template-columns: 1fr; }
	}
	@media (prefers-reduced-motion: reduce) {
		.friend-card, .friend-card-glow, .friend-avatar, .friend-arrow, .friend-visit :global(svg) { transition: none; }
	}
</style>
