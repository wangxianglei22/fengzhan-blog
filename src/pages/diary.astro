---
import { getCollection } from "astro:content";
import DiaryBoard from "../components/DiaryBoard.astro";
import MainGridLayout from "../layouts/MainGridLayout.astro";

const entries = await getCollection("diary", ({ data }) => !data.draft && data.hidden !== true);
---

<MainGridLayout title="日记" description="记录每天的心情和生活片段。">
    <DiaryBoard entries={entries} />
</MainGridLayout>
