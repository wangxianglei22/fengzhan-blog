/* utils */
white(a)
  rgba(255, 255, 255, a)

black(a)
  rgba(0, 0, 0, a)

rainbow-light = linear-gradient(to right, oklch(0.80 0.10 0), oklch(0.80 0.10 30), oklch(0.80 0.10 60), oklch(0.80 0.10 90), oklch(0.80 0.10 120), oklch(0.80 0.10 150), oklch(0.80 0.10 180), oklch(0.80 0.10 210), oklch(0.80 0.10 240), oklch(0.80 0.10 270), oklch(0.80 0.10 300), oklch(0.80 0.10 330), oklch(0.80 0.10 360))
rainbow-dark = linear-gradient(to right, oklch(0.70 0.10 0), oklch(0.70 0.10 30), oklch(0.70 0.10 60), oklch(0.70 0.10 90), oklch(0.70 0.10 120), oklch(0.70 0.10 150), oklch(0.70 0.10 180), oklch(0.70 0.10 210), oklch(0.70 0.10 240), oklch(0.70 0.10 270), oklch(0.70 0.10 300), oklch(0.70 0.10 330), oklch(0.70 0.10 360))

:root
  --radius-large 1rem
  --content-delay 150ms

/* An util to define variables that vary with light and dark mode */
define(vars)
  :root
    for key, value in vars
      {key}: value[0]
  :root.dark
    for key, value in vars
      if length(value) > 1
        {key}: value[1]

define({
  // 主色：墨蓝（钢青）。色相由 --hue 驱动（默认 252），用户可在外观设置里调整。
  // 亮色为深靛 #1d4f82，暗色提亮为钢蓝 #7da8d9。
  --primary: oklch(0.42 0.10 var(--hue)) oklch(0.72 0.085 var(--hue))
  // 页面底色：冷调石板白 / 近黑藏蓝。
  --page-bg: oklch(0.955 0.004 var(--hue)) oklch(0.18 0.020 var(--hue))
  // 卡片：亮色近白、暗色深蓝灰。
  --card-bg: oklch(0.985 0.003 var(--hue)) oklch(0.235 0.028 var(--hue))

  // 枫叶金：固定色相的暖色点缀，用于徽标、图标与局部强调。
  --accent: oklch(0.74 0.13 72) oklch(0.82 0.115 82)
  --accent-soft: oklch(0.95 0.038 82) oklch(0.28 0.045 82)
  --accent-border: oklch(0.86 0.07 82) oklch(0.45 0.065 82)
  --accent-contrast: oklch(0.22 0.035 82) oklch(0.95 0.02 82)

  --btn-content: oklch(0.38 0.085 var(--hue)) oklch(0.78 0.075 var(--hue))

  --btn-regular-bg: oklch(0.945 0.012 var(--hue)) oklch(0.30 0.024 var(--hue))
  --btn-regular-bg-hover: oklch(0.90 0.030 var(--hue)) oklch(0.35 0.028 var(--hue))
  --btn-regular-bg-active: oklch(0.855 0.045 var(--hue)) oklch(0.40 0.032 var(--hue))

  --btn-plain-bg-hover: oklch(0.945 0.012 var(--hue)) oklch(0.29 0.024 var(--hue))
  --btn-plain-bg-active: oklch(0.99 0.003 var(--hue)) oklch(0.26 0.022 var(--hue))

  --btn-card-bg-hover: oklch(0.985 0.003 var(--hue)) oklch(0.29 0.026 var(--hue))
  --btn-card-bg-active: oklch(0.90 0.022 var(--hue)) oklch(0.34 0.028 var(--hue))

  --enter-btn-bg: var(--btn-regular-bg)
  --enter-btn-bg-hover: var(--btn-regular-bg-hover)
  --enter-btn-bg-active: var(--btn-regular-bg-active)

  --deep-text: oklch(0.22 0.018 var(--hue)) oklch(0.92 0.012 var(--hue))

  --title-active: oklch(0.44 0.09 var(--hue)) oklch(0.86 0.07 var(--hue))

  --line-divider: black(0.10) white(0.08)

  --line-color: black(0.12) white(0.10)
  --meta-divider: black(0.22) white(0.20)

  --inline-code-bg: var(--btn-regular-bg)
  --inline-code-color: var(--btn-content)
  --selection-bg: oklch(0.86 0.045 var(--hue)) oklch(0.36 0.06 var(--hue))
  --codeblock-selection: oklch(0.36 0.06 var(--hue))
  --codeblock-bg: oklch(0.16 0.020 var(--hue)) oklch(0.20 0.024 var(--hue))
  --codeblock-topbar-bg: oklch(0.28 0.022 var(--hue)) oklch(0.27 0.026 var(--hue))

  --license-block-bg: black(0.03) var(--codeblock-bg)

  --link-underline: oklch(0.92 0.030 var(--hue)) oklch(0.40 0.06 var(--hue))
  --link-hover: oklch(0.945 0.012 var(--hue)) oklch(0.40 0.06 var(--hue))
  --link-active: oklch(0.88 0.040 var(--hue)) oklch(0.34 0.05 var(--hue))

  --float-panel-bg: oklch(0.99 0.003 var(--hue)) oklch(0.235 0.028 var(--hue))

  --scrollbar-bg-light: black(0.4)
  --scrollbar-bg-hover-light: black(0.5)
  --scrollbar-bg-active-light: black(0.6)

  --scrollbar-bg-dark: white(0.4)
  --scrollbar-bg-hover-dark: white(0.5)
  --scrollbar-bg-active-dark: white(0.6)

  --scrollbar-bg: var(--scrollbar-bg-light) var(--scrollbar-bg-dark)
  --scrollbar-bg-hover: var(--scrollbar-bg-hover-light) var(--scrollbar-bg-hover-dark)
  --scrollbar-bg-active: var(--scrollbar-bg-active-light) var(--scrollbar-bg-active-dark)

  --color-selection-bar: rainbow-light rainbow-dark

  --display-light-icon: 1 0
  --display-dark-icon: 0 1

  --admonitions-color-tip: oklch(0.60 0.10 172) oklch(0.74 0.11 172)
  --admonitions-color-note: oklch(0.46 0.10 252) oklch(0.76 0.09 252)
  --admonitions-color-important: oklch(0.46 0.12 300) oklch(0.76 0.10 300)
  --admonitions-color-warning: oklch(0.68 0.12 72) oklch(0.82 0.115 82)
  --admonitions-color-caution: oklch(0.52 0.16 25) oklch(0.68 0.15 25)

  --toc-badge-bg: oklch(0.90 0.030 var(--hue)) var(--btn-regular-bg)
  --toc-btn-hover: oklch(0.922 0.008 var(--hue)) oklch(0.31 0.024 var(--hue))
  --toc-btn-active: oklch(0.90 0.010 var(--hue)) oklch(0.35 0.028 var(--hue))
  --toc-width: calc((100vw - var(--page-width)) / 2 - 1rem)
  --toc-item-active: oklch(0.42 0.10 var(--hue)) oklch(0.72 0.085 var(--hue))
})
