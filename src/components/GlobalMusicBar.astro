---
import musicSource from "../data/music.md?raw";
import { parseMusic } from "../utils/music";
import MusicPlayer from "./MusicPlayer.astro";

const tracks = parseMusic(musicSource);
---

<!--
	全局悬浮音乐小球。
	这个节点被放在 Layout.astro 的 <body> 里、swup 容器（#page-shell / #toc）之外，
	所以切换页面时不会被替换，播放状态与控制条都能一直保留。
	小球首次访问时不显示；用户点过一次播放音乐后永久显示。
	点击小球展开出曲名与上一首/播放/下一首三个按钮。
-->
<div class="global-music-bar" data-global-music-bar>
	<button class="music-ball" data-music-ball type="button" aria-label="展开音乐控制" aria-expanded="false" title="音乐">
		<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18V5l10-2v13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><circle cx="6" cy="18" r="3" fill="currentColor"/><circle cx="16" cy="16" r="3" fill="currentColor"/></svg>
	</button>
	<div class="global-music-panel" data-music-panel>
		<MusicPlayer compact tracks={tracks} />
	</div>
</div>

<script>
	// 暂停后自动收起面板的延迟（毫秒）
	const HIDE_DELAY = 2500;
	// 是否已经点过播放（小球是否该显示），用 localStorage 跨刷新记住
	const REVEAL_KEY = "blog-music-revealed";

	class GlobalMusicBarController {
		private bar: HTMLElement;
		private ball: HTMLElement | null;
		private hideTimer: number | null = null;
		private expanded = false;

		constructor(bar: HTMLElement) {
			this.bar = bar;
			this.ball = bar.querySelector<HTMLElement>("[data-music-ball]");
			this.ball?.addEventListener("click", this.toggleExpanded);
			// 点击面板外部时收起（面板本身也在这棵树里，点它不触发收起）
			document.addEventListener("click", this.handleOutsideClick);
			// <audio id="blog-global-audio"> 同样在 body 里、swup 容器之外，切页不会丢
			const audio = document.getElementById("blog-global-audio");
			if (!(audio instanceof HTMLAudioElement)) return;
			audio.addEventListener("play", this.handlePlay);
			audio.addEventListener("pause", this.handlePause);
			audio.addEventListener("ended", this.handlePause);
			// 之前点过播放，或者刷新页面时本来就在播放中 → 小球直接显示
			let wasRevealed = false;
			try { wasRevealed = localStorage.getItem(REVEAL_KEY) === "1"; } catch { /* 忽略 */ }
			if (wasRevealed) this.reveal();
			if (!audio.paused) {
				this.reveal();
				this.bar.classList.add("is-playing");
			}
		}

		private toggleExpanded = () => {
			if (this.expanded) this.collapse();
			else this.expand();
		};

		private handleOutsideClick = (event: MouseEvent) => {
			if (!this.expanded || !this.bar.contains(event.target as Node)) this.collapse();
		};

		private handlePlay = () => {
			// 第一次点播放后，小球永久显示；展开交给 :hover，所以这里不再 constant 展开
			this.reveal();
			this.bar.classList.add("is-playing");
		};

		private handlePause = () => {
			this.bar.classList.remove("is-playing");
			this.clearTimer();
			this.hideTimer = window.setTimeout(() => {
				this.hideTimer = null;
				this.collapse();
			}, HIDE_DELAY);
		};

		/** 切页后重新对齐一次显隐状态 */
		sync() {
			const audio = document.getElementById("blog-global-audio");
			if (!(audio instanceof HTMLAudioElement) || audio.paused) return;
			this.reveal();
			this.bar.classList.add("is-playing");
		}

		private clearTimer() {
			if (this.hideTimer !== null) {
				window.clearTimeout(this.hideTimer);
				this.hideTimer = null;
			}
		}

		/** 显示小球本体（播放过一次后永久显示） */
		reveal() {
			this.bar.classList.add("is-revealed");
			try { localStorage.setItem(REVEAL_KEY, "1"); } catch { /* 忽略 */ }
		}

		expand() {
			this.clearTimer();
			this.expanded = true;
			this.bar.classList.add("is-expanded");
			this.ball?.setAttribute("aria-expanded", "true");
		}

		collapse() {
			this.clearTimer();
			this.expanded = false;
			this.bar.classList.remove("is-expanded", "is-playing");
			this.ball?.setAttribute("aria-expanded", "false");
		}
	}

	// swup 切页会重新执行页面里的脚本，用全局标记保证只初始化一次
	const musicWindow = window as Window & { __blogGlobalMusicBar?: GlobalMusicBarController };
	if (!musicWindow.__blogGlobalMusicBar) {
		const bar = document.querySelector<HTMLElement>("[data-global-music-bar]");
		if (bar) musicWindow.__blogGlobalMusicBar = new GlobalMusicBarController(bar);
	}
	document.addEventListener("astro:page-load", () => musicWindow.__blogGlobalMusicBar?.sync());
</script>

<style>
	.global-music-bar {
		position: fixed;
		right: 1rem;
		bottom: 1rem;
		z-index: 60;
		display: flex;
		/* row-reverse：小球始终贴住右下角，胶囊向左长出来，不会顶出视口 */
		flex-direction: row-reverse;
		align-items: center;
		gap: 0.45rem;
	}

	/* 小球本体：初始隐藏，播放过一次后（is-revealed）永久显示 */
	.music-ball {
		display: grid;
		place-items: center;
		width: 3rem;
		height: 3rem;
		border: 0;
		border-radius: 50%;
		color: var(--deep-text);
		background: color-mix(in srgb, var(--card-bg) 88%, transparent);
		box-shadow: 0 0.45rem 1.2rem color-mix(in srgb, var(--deep-text) 16%, transparent);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		cursor: pointer;
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transform: scale(0.8);
		transition: color 180ms ease, background 180ms ease, transform 180ms ease, opacity 200ms ease, visibility 0s linear 200ms;
	}
	.global-music-bar.is-revealed .music-ball {
		opacity: 1;
		visibility: visible;
		pointer-events: auto;
		transform: scale(1);
		transition: color 180ms ease, background 180ms ease, transform 180ms ease, opacity 200ms ease, visibility 0s;
	}
	.music-ball:hover { color: white; background: var(--primary); transform: scale(1.06); }
	.music-ball :global(svg) { width: 1.4rem; height: 1.4rem; }
	/* 播放中小球脉动 + 主色 */
	.global-music-bar.is-playing .music-ball {
		color: white;
		background: var(--primary);
		animation: music-ball-pulse 1.8s ease-in-out infinite;
	}
	@keyframes music-ball-pulse {
		0%, 100% { box-shadow: 0 0.45rem 1.2rem color-mix(in srgb, var(--deep-text) 16%, transparent), 0 0 0 0 color-mix(in srgb, var(--primary) 38%, transparent); }
		50% { box-shadow: 0 0.45rem 1.2rem color-mix(in srgb, var(--deep-text) 16%, transparent), 0 0 0 0.45rem color-mix(in srgb, var(--primary) 0%, transparent); }
	}

	/* 展开胶囊：平时宽度为 0，鼠标移到小球上（或点开）时向左长出来 */
	.global-music-panel {
		max-width: 0;
		min-width: 0;
		opacity: 0;
		overflow: hidden;
		pointer-events: none;
		transform-origin: right center;
		transform: scale(0.92);
		transition: max-width 240ms cubic-bezier(0.22, 1, 0.36, 1), opacity 160ms ease, transform 240ms ease;
	}
	.global-music-bar.is-revealed:hover .global-music-panel,
	.global-music-bar.is-expanded .global-music-panel {
		max-width: 12rem;
		opacity: 1;
		pointer-events: auto;
		transform: scale(1);
	}

	/* 胶囊内容：只有上一首 / 播放暂停 / 下一首，不放曲名 */
	:global(html .global-music-bar .mini-player-shell) {
		width: auto;
		grid-template-columns: repeat(3, auto);
		align-items: center;
		gap: 0.28rem;
		padding: 0.34rem 0.38rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--card-bg) 88%, transparent);
		box-shadow: 0 0.55rem 1.6rem color-mix(in srgb, var(--deep-text) 13%, transparent);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
	}
	:global(html .global-music-bar .mini-player-info),
	:global(html .global-music-bar .mini-player-disc),
	:global(html .global-music-bar .mini-player-volume),
	:global(html .global-music-bar .mini-player-seek) {
		display: none;
	}
	:global(html .global-music-bar .mini-player-control),
	:global(html .global-music-bar .mini-player-skip) {
		width: 2rem;
		height: 2rem;
		aspect-ratio: auto;
	}

	@media (prefers-reduced-motion: reduce) {
		.global-music-bar.is-playing .music-ball { animation: none; }
		.music-ball,
		.global-music-bar.is-revealed .music-ball,
		.global-music-panel,
		.global-music-bar.is-expanded .global-music-panel {
			transition: none;
		}
	}
</style>
