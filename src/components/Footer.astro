---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import { profileConfig } from "../config";
import { url } from "../utils/url-utils";
import ImageWrapper from "./misc/ImageWrapper.astro";

const currentYear = new Date().getFullYear();
const yearDays = new Date(currentYear, 1, 29).getDate() === 29 ? 366 : 365;
const yearDay = Math.floor((Date.now() - new Date(currentYear, 0, 1).getTime()) / 86400000) + 1;
const yearProgress = Math.min(100, Math.round((yearDay / yearDays) * 100));
const yearRemaining = Math.max(0, yearDays - yearDay);
const posts = await getCollection("posts", ({ data }) => !data.draft && data.hidden !== true);
const postCount = posts.length;
const tags = new Set(posts.flatMap(({ data }) => data.tags ?? []));
const links = profileConfig.links.filter((link) => !["twitter.com", "store.steampowered.com"].some((domain) => link.url.includes(domain)));
---

<div class="site-footer-wrap">
    <div class="site-footer-divider" aria-hidden="true">
        <span><Icon name="material-symbols:music-note-rounded" /><Icon name="fa6-brands:canadian-maple-leaf" /><Icon name="material-symbols:code-rounded" /></span>
    </div>

    <footer class="site-info-panel">
        <div class="site-info-topline">
            <span><Icon name="fa6-brands:canadian-maple-leaf" /> ABOUT THIS PLACE</span>
            <span>NO. 01 <i>/</i> ALWAYS IN PROGRESS</span>
        </div>

        <div class="site-info-cards">
            <article class="site-info-card site-info-about">
                <div class="site-info-card-heading">
                    <span class="site-info-label"><Icon name="material-symbols:music-note-rounded" /> 关于这里</span>
                    <span class="site-info-card-code">ABOUT</span>
                </div>
                <div class="site-profile-row">
                    <div class="site-profile-avatar"><ImageWrapper src={profileConfig.avatar || ""} alt={profileConfig.name} /></div>
                    <div><h2>{profileConfig.name}</h2><p>{profileConfig.bio || "记录生活、灵感与正在学习的东西。"}</p></div>
                </div>
                <nav class="site-info-socials" aria-label="社交链接">
                    {links.map((link) => <a href={link.url} target="_blank" rel="me noopener noreferrer" aria-label={link.name} title={link.name}><Icon name={link.icon} /></a>)}
                </nav>
                <div class="site-card-statline"><span>已写下 <strong>{postCount}</strong> 篇文章</span><span>共 <strong>{tags.size}</strong> 个标签</span></div>
            </article>

            <article class="site-info-card site-info-explore">
                <div class="site-info-card-heading">
                    <span class="site-info-label"><Icon name="material-symbols:explore-rounded" /> 探索这里</span>
                    <span class="site-info-card-code">EXPLORE</span>
                </div>
                <nav class="site-explore-grid" aria-label="站点导航">
                    <a href={url("/")}><Icon name="material-symbols:home-outline-rounded" /> 首页</a>
                    <a href={url("archive/")}><Icon name="material-symbols:inventory-2-outline-rounded" /> 文章总览</a>
                    <a href={url("diary/")}><Icon name="material-symbols:edit-calendar-rounded" /> 日记</a>
                    <a href={url("music/")}><Icon name="material-symbols:music-note-rounded" /> 音乐</a>
                    <a href={url("guestbook/")}><Icon name="material-symbols:mail-outline-rounded" /> 给我留言</a>
                    <a href={url("about/")}><Icon name="material-symbols:person-outline-rounded" /> 关于我</a>
                    <a href={url("archive/")}><Icon name="material-symbols:shuffle-rounded" /> 随便逛逛</a>
                </nav>
                <a class="site-random-link" href={url("archive/")}><Icon name="fa6-brands:canadian-maple-leaf" /> 看看最近写了什么 <Icon name="material-symbols:arrow-forward-rounded" /></a>
            </article>

            <article class="site-info-card site-info-now">
                <div class="site-info-card-heading">
                    <span class="site-info-label"><Icon name="material-symbols:schedule-outline-rounded" /> 此刻</span>
                    <span class="site-info-card-code">NOW</span>
                </div>
                <time class="site-clock" data-site-clock>--:--</time>
                <p class="site-date" data-site-date></p>
                <div class="site-year-label"><span>今年已经走过</span><strong>{yearProgress}%</strong></div>
                <div class="site-year-progress"><span style={`width:${yearProgress}%`}></span></div>
                <div class="site-now-stats"><span><b>剩余</b> {yearRemaining} 天</span><span><b>文章</b> {postCount} 篇</span></div>
                <p class="site-info-note">故事还在继续，欢迎常来看看。</p>
            </article>
        </div>

        <div class="site-info-bottom">
            <span class="site-copyright"><Icon name="material-symbols:music-note-rounded" /> &copy; {currentYear} {profileConfig.name} <i>·</i> Built with <Icon name="fa6-brands:canadian-maple-leaf" /> in China</span>
            <nav class="site-info-links" aria-label="其他链接">
                <a href={url("diary/")}><Icon name="material-symbols:edit-calendar-rounded" /> 日记</a>
                <a href={url("music/")}><Icon name="material-symbols:music-note-rounded" /> 音乐</a>
                <a href={url("guestbook/")}><Icon name="material-symbols:mail-outline-rounded" /> 留言</a>
            </nav>
            <span class="site-powered">Powered by <a href="https://astro.build" target="_blank" rel="noreferrer">Astro</a> &amp; <a href="https://github.com/saicaca/fuwari" target="_blank" rel="noreferrer">Fuwari</a></span>
        </div>
    </footer>
</div>

<style>
    .site-footer-wrap { margin: 2.6rem 0 1.35rem; }
    .site-footer-divider { display: flex; align-items: center; gap: 1rem; margin: 0 1rem 1.15rem; color: color-mix(in srgb, var(--primary) 64%, var(--deep-text)); }
    .site-footer-divider::before, .site-footer-divider::after { flex: 1; border-top: 1px dashed color-mix(in srgb, var(--deep-text) 15%, transparent); content: ""; }
    .site-footer-divider span { display: flex; align-items: center; gap: 0.55rem; }
    .site-footer-divider :global(svg) { width: 0.8rem; height: 0.8rem; }
    .site-info-panel { position: relative; isolation: isolate; overflow: hidden; padding: 1.35rem 1.5rem 1rem; border: 1px solid color-mix(in srgb, var(--deep-text) 12%, transparent); border-radius: 1.1rem; background: color-mix(in srgb, var(--card-bg) 74%, transparent); box-shadow: 0 0.7rem 2rem color-mix(in srgb, var(--deep-text) 5%, transparent); }
    .site-info-panel::before { position: absolute; z-index: -1; inset: 0; background-image: linear-gradient(color-mix(in srgb, var(--primary) 3%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in srgb, var(--primary) 3%, transparent) 1px, transparent 1px); background-size: 22px 22px; content: ""; mask-image: linear-gradient(120deg, black, transparent 72%); }
    .site-info-topline, .site-info-card-heading, .site-info-label, .site-year-label, .site-info-bottom, .site-copyright, .site-info-links { display: flex; align-items: center; }
    .site-info-topline { justify-content: space-between; padding-bottom: 0.8rem; border-bottom: 1px dashed color-mix(in srgb, var(--deep-text) 15%, transparent); color: color-mix(in srgb, var(--deep-text) 52%, transparent); font-size: 0.62rem; font-weight: 800; letter-spacing: 0.08em; }
    .site-info-topline span:first-child { display: flex; align-items: center; gap: 0.4rem; color: var(--primary); }
    .site-info-topline :global(svg) { width: 0.9rem; height: 0.9rem; }
    .site-info-topline i { margin: 0 0.2rem; font-style: normal; opacity: 0.55; }
    .site-info-cards { display: grid; grid-template-columns: 1.08fr 1.06fr 1fr; gap: 0.85rem; padding: 1rem 0; }
    .site-info-card { min-width: 0; min-height: 12.8rem; padding: 1rem; border: 1px solid color-mix(in srgb, var(--deep-text) 10%, transparent); border-radius: 1rem; background: color-mix(in srgb, var(--card-bg) 57%, transparent); box-shadow: 0 0.35rem 1rem color-mix(in srgb, var(--deep-text) 3%, transparent); }
    .site-info-card-heading { justify-content: space-between; margin-bottom: 0.8rem; }
    .site-info-label { gap: 0.4rem; color: var(--primary); font-size: 0.72rem; font-weight: 800; }
    .site-info-label :global(svg) { width: 0.95rem; height: 0.95rem; }
    .site-info-card-code { color: color-mix(in srgb, var(--deep-text) 42%, transparent); font-size: 0.58rem; font-weight: 800; letter-spacing: 0.12em; }
    .site-profile-row { display: flex; align-items: center; gap: 0.75rem; }
    .site-profile-avatar { flex: 0 0 auto; width: 3.2rem; aspect-ratio: 1; overflow: hidden; border: 2px solid color-mix(in srgb, var(--primary) 28%, white); border-radius: 50%; background: var(--btn-regular-bg); }
    .site-profile-avatar :global(> div), .site-profile-avatar :global(img) { width: 100%; height: 100%; }
    .site-profile-avatar :global(img) { object-fit: cover; }
    .site-info-about h2 { margin: 0; color: var(--deep-text); font-size: 1.08rem; }
    .site-info-about p, .site-info-now p { margin: 0.18rem 0 0; color: color-mix(in srgb, var(--deep-text) 60%, transparent); font-size: 0.72rem; line-height: 1.55; }
    .site-info-socials { display: flex; gap: 0.4rem; margin-top: 0.8rem; }
    .site-info-socials a, .site-info-links a { display: inline-flex; align-items: center; justify-content: center; gap: 0.35rem; color: color-mix(in srgb, var(--deep-text) 70%, transparent); text-decoration: none; }
    .site-info-socials a { width: 1.85rem; aspect-ratio: 1; border: 1px solid color-mix(in srgb, var(--deep-text) 12%, transparent); border-radius: 0.55rem; background: color-mix(in srgb, var(--card-bg) 80%, transparent); transition: transform 160ms ease, color 160ms ease, border-color 160ms ease; }
    .site-info-socials a:hover { transform: translateY(-2px); border-color: color-mix(in srgb, var(--primary) 38%, transparent); color: var(--primary); }
    .site-card-statline { display: flex; justify-content: space-between; gap: 0.4rem; margin-top: 1.1rem; padding-top: 0.6rem; border-top: 1px dashed color-mix(in srgb, var(--deep-text) 12%, transparent); color: color-mix(in srgb, var(--deep-text) 55%, transparent); font-size: 0.67rem; }
    .site-card-statline strong { color: var(--primary); }
    .site-explore-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 0.9rem; row-gap: 0.25rem; }
    .site-explore-grid a { display: flex; align-items: center; gap: 0.42rem; min-width: 0; padding: 0.22rem 0; color: color-mix(in srgb, var(--deep-text) 76%, transparent); font-size: 0.72rem; font-weight: 650; text-decoration: none; transition: color 160ms ease, transform 160ms ease; }
    .site-explore-grid a:hover { transform: translateX(2px); color: var(--primary); }
    .site-explore-grid :global(svg) { flex: 0 0 auto; width: 0.85rem; height: 0.85rem; color: color-mix(in srgb, var(--primary) 75%, var(--deep-text)); }
    .site-random-link { display: inline-flex; align-items: center; gap: 0.35rem; margin-top: 0.75rem; padding: 0.35rem 0.55rem; border: 1px dashed color-mix(in srgb, var(--primary) 35%, transparent); border-radius: 999px; color: color-mix(in srgb, var(--primary) 78%, var(--deep-text)); font-size: 0.66rem; font-weight: 750; text-decoration: none; }
    .site-random-link :global(svg) { width: 0.78rem; height: 0.78rem; }
    .site-random-link :global(svg:last-child) { margin-left: 0.1rem; }
    .site-clock { display: block; color: var(--deep-text); font-size: 2rem; font-weight: 800; line-height: 1.05; letter-spacing: 0; }
    .site-date { min-height: 1.2rem; }
    .site-year-label { justify-content: space-between; margin-top: 0.7rem; color: color-mix(in srgb, var(--deep-text) 58%, transparent); font-size: 0.67rem; }
    .site-year-label strong { color: var(--primary); }
    .site-year-progress { height: 0.35rem; margin-top: 0.35rem; overflow: hidden; border-radius: 999px; background: color-mix(in srgb, var(--primary) 12%, transparent); }
    .site-year-progress span { display: block; height: 100%; border-radius: inherit; background: color-mix(in srgb, var(--primary) 55%, white); }
    .site-now-stats { display: flex; gap: 1rem; margin-top: 0.75rem; padding-top: 0.55rem; border-top: 1px dashed color-mix(in srgb, var(--deep-text) 12%, transparent); color: color-mix(in srgb, var(--deep-text) 58%, transparent); font-size: 0.68rem; }
    .site-now-stats b { margin-right: 0.2rem; color: var(--primary); font-weight: 800; }
    .site-info-now .site-info-note { margin-top: 0.55rem; padding-top: 0.45rem; border-top: 1px dashed color-mix(in srgb, var(--deep-text) 12%, transparent); }
    .site-info-bottom { justify-content: space-between; flex-wrap: wrap; gap: 0.65rem 1rem; padding-top: 0.8rem; border-top: 1px dashed color-mix(in srgb, var(--deep-text) 15%, transparent); color: color-mix(in srgb, var(--deep-text) 55%, transparent); font-size: 0.66rem; }
    .site-copyright { gap: 0.3rem; }
    .site-copyright i { font-style: normal; opacity: 0.6; }
    .site-copyright :global(svg) { width: 0.75rem; height: 0.75rem; color: var(--primary); }
    .site-info-links { gap: 0.4rem; }
    .site-info-links a { padding: 0.35rem 0.55rem; border: 1px solid color-mix(in srgb, var(--deep-text) 12%, transparent); border-radius: 999px; background: color-mix(in srgb, var(--card-bg) 65%, transparent); transition: color 160ms ease, border-color 160ms ease, transform 160ms ease; }
    .site-info-links a:hover { transform: translateY(-1px); border-color: color-mix(in srgb, var(--primary) 36%, transparent); color: var(--primary); }
    .site-info-links :global(svg) { width: 0.8rem; height: 0.8rem; }
    .site-powered a { color: var(--primary); font-weight: 700; text-decoration: none; }
    @media (max-width: 767px) {
        .site-footer-wrap { margin-top: 1.8rem; }
        .site-footer-divider { margin: 0 0.5rem 0.9rem; }
        .site-info-panel { padding: 1rem 0.85rem 0.8rem; border-radius: 0.9rem; }
        .site-info-topline { align-items: flex-start; gap: 0.5rem; }
        .site-info-topline span:last-child { text-align: right; }
        .site-info-cards { grid-template-columns: 1fr; gap: 0.65rem; padding: 0.8rem 0; }
        .site-info-card { min-height: 0; padding: 0.9rem; }
        .site-info-bottom { justify-content: center; text-align: center; }
        .site-copyright, .site-powered { width: 100%; justify-content: center; }
    }
</style>
