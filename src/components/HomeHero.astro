---
import { Icon } from "astro-icon/components";
import { profileConfig } from "../config";
import musicSource from "../data/music.md?raw";
import { quoteItems } from "../data/quotes";
import { parseMusic } from "../utils/music";
import MusicPlayer from "./MusicPlayer.astro";
import ImageWrapper from "./misc/ImageWrapper.astro";

const musicTracks = parseMusic(musicSource);
const heroQuotes = quoteItems.map((quote) => quote.text);

const socialLinks = profileConfig.links.filter(
	(link) =>
		!["twitter.com", "store.steampowered.com"].some((domain) =>
			link.url.includes(domain),
		),
);
---

<section class="home-hero" aria-labelledby="hero-title">
	<div class="hero-decoration hero-note hero-note-one" aria-hidden="true">♫</div>
	<div class="hero-decoration hero-note hero-note-two" aria-hidden="true">♪</div>
	<div class="hero-decoration hero-spark hero-spark-one" aria-hidden="true">✧</div>
	<div class="hero-decoration hero-spark hero-spark-two" aria-hidden="true"><Icon name="fa6-brands:canadian-maple-leaf" /></div>

	<div class="hero-inner">
		<div class="hero-copy">
			<div class="hero-kicker"><Icon name="material-symbols:terminal-rounded" /> 写代码，也写生活</div>
			<h1 id="hero-title">Hi, I'm <span>{profileConfig.name}</span><Icon class="hero-mark" name="fa6-brands:canadian-maple-leaf" /></h1>
			<p class="hero-bio">{profileConfig.bio}</p>
			<div class="hero-tags" aria-label="兴趣标签">
				<span><Icon name="material-symbols:code-rounded" />折腾代码</span>
				<span><Icon name="material-symbols:school-rounded" />记录灵感</span>
				<span><Icon name="material-symbols:explore-rounded" />保持好奇</span>
			</div>
			{socialLinks.length > 0 && <nav class="hero-socials" aria-label="社交链接">
				{socialLinks.map((link) => <a class:list={["hero-social-link", `social-${link.name.toLowerCase()}`]} href={link.url} target="_blank" rel="me noopener noreferrer" aria-label={link.name} title={link.name}>
					<Icon name={link.icon} />
				</a>)}
			</nav>}
		</div>

		<div class="hero-portrait-wrap">
			<div class="portrait-spark portrait-spark-one" aria-hidden="true">✦</div>
			<div class="portrait-spark portrait-spark-two" aria-hidden="true"><Icon name="fa6-brands:canadian-maple-leaf" /></div>
			<div class="hero-portrait-frame">
				<div class="hero-portrait">
					<ImageWrapper src={profileConfig.avatar || ""} alt={`${profileConfig.name} 的头像`} />
				</div>
				<div class="portrait-caption">枫栈 · 记录与思考</div>
			</div>
			<MusicPlayer compact tracks={musicTracks} />
		</div>
	</div>

	<div class="hero-bottom">
		<home-hero-quote class="hero-quote">
			<Icon name="material-symbols:format-quote-rounded" />
			<span data-hero-quote-text aria-live="polite">「{heroQuotes[0]}」</span>
			<button type="button" data-hero-quote-refresh aria-label="换一句语录" title="换一句语录">
				<Icon name="material-symbols:refresh-rounded" />
			</button>
		</home-hero-quote>
		<a class="hero-scroll" href="#home-posts" aria-label="向下查看最近文章" title="向下查看最近文章">
			<Icon name="material-symbols:keyboard-arrow-down-rounded" />
		</a>
	</div>
</section>

<script is:inline define:vars={{ heroQuotes }}>
	class HomeHeroQuote extends HTMLElement {
		currentIndex = 0;

		connectedCallback() {
			if (this.dataset.ready === "true") return;
			this.dataset.ready = "true";
			this.addEventListener("click", this.handleClick);
		}

		handleClick = (event) => {
			const target = event.target;
			if (target instanceof Element && target.closest("[data-hero-quote-refresh]")) this.showNext();
		};

		showNext() {
			if (heroQuotes.length < 2) return;
			let nextIndex = this.currentIndex;
			while (nextIndex === this.currentIndex) nextIndex = Math.floor(Math.random() * heroQuotes.length);
			this.currentIndex = nextIndex;
			const text = this.querySelector("[data-hero-quote-text]");
			if (!text) return;
			this.classList.add("is-changing");
			window.setTimeout(() => {
				text.textContent = `「${heroQuotes[this.currentIndex]}」`;
				this.classList.remove("is-changing");
			}, 150);
		}
	}

	if (!customElements.get("home-hero-quote")) customElements.define("home-hero-quote", HomeHeroQuote);
</script>

<style>
	.home-hero {
		position: relative;
		isolation: isolate;
		display: flex;
		flex-direction: column;
		justify-content: center;
		width: 100vw;
		min-height: 100svh;
		margin-left: calc(50% - 50vw);
		overflow: hidden;
		color: var(--deep-text);
		background: transparent;
	}

	.hero-inner {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.85fr);
		align-items: center;
		gap: 4rem;
		width: min(100% - 3rem, 75rem);
		margin: 0 auto;
		padding: 7rem 2rem 5rem;
	}

	.hero-copy { position: relative; z-index: 1; }
	.hero-kicker {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		margin-bottom: 1rem;
		padding: 0.45rem 0.8rem;
		border: 1px dashed color-mix(in srgb, var(--primary) 45%, transparent);
		border-radius: 999px;
		color: var(--primary);
		background: color-mix(in srgb, var(--card-bg) 70%, transparent);
		font-size: 0.82rem;
		font-weight: 700;
	}

	.hero-kicker :global(svg) { width: 1rem; height: 1rem; }
	.hero-copy h1 {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.2em;
		margin: 0;
		color: var(--deep-text);
		font-size: 3.6rem;
		font-weight: 800;
		line-height: 1.1;
	}
	.hero-copy h1 span { color: var(--primary); }
	.hero-copy h1 span { display: inline-block; transform-origin: 50% 85%; transition: transform 220ms ease, text-shadow 220ms ease; }
	.hero-copy h1 span:hover { transform: translateY(-3px) rotate(-2deg); text-shadow: 0 0.35rem 1rem color-mix(in srgb, var(--primary) 28%, transparent); }
	.hero-copy h1 :global(.hero-mark) { width: 2.3rem; height: 2.3rem; color: var(--accent); }
	.hero-bio { margin: 1rem 0 1.25rem; color: color-mix(in srgb, var(--deep-text) 68%, transparent); font-size: 1.3rem; line-height: 1.7; }
	.hero-tags, .hero-socials { display: flex; flex-wrap: wrap; align-items: center; gap: 0.65rem; }
	.hero-tags span {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		min-height: 2rem;
		padding: 0.35rem 0.7rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--card-bg) 74%, transparent);
		color: color-mix(in srgb, var(--deep-text) 72%, transparent);
		font-size: 0.78rem;
		font-weight: 700;
	}
	.hero-tags :global(svg) { width: 0.95rem; height: 0.95rem; color: var(--primary); }
	.hero-socials { margin-top: 1.4rem; gap: 0.75rem; }
	.hero-socials .hero-social-link {
		display: grid;
		place-items: center;
		width: 2.8rem;
		aspect-ratio: 1;
		border: 1px solid color-mix(in srgb, var(--primary) 12%, transparent);
		border-radius: 50%;
		background: color-mix(in srgb, var(--card-bg) 76%, transparent);
		color: color-mix(in srgb, var(--deep-text) 78%, transparent);
		box-shadow: 0 0.4rem 1rem #36464c12;
		transition: transform 180ms ease, color 180ms ease, background 180ms ease;
	}
	.hero-socials .hero-social-link:hover { transform: translateY(-3px); color: var(--primary); background: var(--card-bg); }
	.hero-socials .social-bilibili { color: #1597d5; }
	.hero-socials .social-小红书 { color: #e4434d; }
	.hero-socials :global(svg) { width: 1.2rem; height: 1.2rem; }

	.hero-portrait-wrap { position: relative; justify-self: center; padding: 1rem; }
	/* 头像与徽标包在同一个相对定位容器里，徽标紧贴头像下缘，
	   不会再被下方正常流中的音乐播放器盖住。 */
	.hero-portrait-frame { position: relative; display: inline-block; }
	.hero-portrait {
		width: min(24rem, 38vw);
		aspect-ratio: 1;
		padding: 0.5rem;
		border: 0.45rem solid white;
		border-radius: 50%;
		background: white;
		box-shadow: 0 1.2rem 3.5rem #33434d24;
		transform: rotate(2deg);
		transition: transform 260ms ease, box-shadow 260ms ease;
	}
	.hero-portrait:hover { transform: rotate(0) scale(1.035); box-shadow: 0 1.5rem 3.8rem #33434d30; }
	:global(.hero-portrait > div) { width: 100%; height: 100%; border-radius: 50%; }
	.portrait-caption {
		position: absolute;
		bottom: 0.4rem;
		left: 0;
		padding: 0.45rem 0.85rem;
		border: 2px solid white;
		border-radius: 999px;
		background: #f4f6f8;
		color: var(--primary);
		font-size: 0.75rem;
		font-weight: 700;
		transform: rotate(-4deg);
	}
	/* 暗色主题下头像的白边与徽标底色改为深色，否则白框会刺眼、徽标文字看不清 */
	:global(.dark) .hero-portrait { border-color: #1b2634; background: #1b2634; box-shadow: 0 1.2rem 3.5rem #00000055; }
	:global(.dark) .portrait-caption { border-color: #1b2634; background: #1b2634; }
	.hero-portrait-wrap :global(.music-player-compact) { width: min(24rem, 80vw); margin-top: 1.1rem; }
	.portrait-spark, .hero-decoration { position: absolute; color: var(--primary); pointer-events: none; }
	.portrait-spark-one { top: 8%; right: -3%; font-size: 2rem; }
	.portrait-spark-two { right: 1%; bottom: 8%; font-size: 1.5rem; }
	.portrait-spark-two :global(svg), .hero-spark-two :global(svg) { width: 1.7rem; height: 1.7rem; color: var(--accent); }
	.hero-decoration { opacity: 0.32; }
	.hero-note { font-size: 2rem; }
	.hero-note-one { top: 18%; left: 14%; transform: rotate(-12deg); }
	.hero-note-two { top: 25%; left: 49%; font-size: 1.3rem; }
	.hero-spark { font-size: 2rem; }
	.hero-spark-one { top: 28%; right: 12%; }
	.hero-spark-two { bottom: 25%; left: 12%; }
	.hero-bottom { display: grid; justify-items: center; gap: 0.75rem; padding: 0 1rem 1.2rem; }
	.hero-quote {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		max-width: 100%;
		padding: 0.65rem 1rem;
		border: 1px dashed color-mix(in srgb, var(--primary) 30%, transparent);
		border-radius: 999px;
		background: color-mix(in srgb, var(--card-bg) 60%, transparent);
		color: color-mix(in srgb, var(--deep-text) 72%, transparent);
		font-size: 0.85rem;
		text-align: center;
		transition: opacity 160ms ease, transform 160ms ease;
	}
	.hero-quote.is-changing { opacity: 0.5; transform: translateY(-2px); }
	.hero-quote > :global(svg) { flex: 0 0 auto; color: var(--primary); }
	.hero-quote button { display: grid; flex: 0 0 auto; place-items: center; width: 1.45rem; aspect-ratio: 1; border: 1px solid color-mix(in srgb, var(--primary) 24%, transparent); border-radius: 50%; color: var(--primary); background: color-mix(in srgb, var(--primary) 7%, transparent); cursor: pointer; transition: transform 160ms ease, background 160ms ease; }
	.hero-quote button:hover { transform: rotate(25deg); background: color-mix(in srgb, var(--primary) 14%, transparent); }
	.hero-quote button :global(svg) { width: 0.78rem; height: 0.78rem; }
	.hero-scroll { display: grid; place-items: center; width: 2.6rem; aspect-ratio: 1; color: var(--primary); }
	.hero-scroll :global(svg) { width: 2rem; height: 2rem; }
	:global(.home-posts) { padding-top: 1rem; scroll-margin-top: 5.5rem; }
	:global(.home-posts-heading) { margin: 0 0 1rem; padding: 0.25rem 0.5rem; }
	:global(.home-posts-heading span) { color: color-mix(in srgb, var(--deep-text) 55%, transparent); font-size: 0.72rem; font-weight: 800; }
	:global(.home-posts-heading h2) { margin: 0.2rem 0 0; color: var(--deep-text); font-size: 1.45rem; }

	@media (max-width: 767px) {
		.home-hero { min-height: 100svh; }
		.hero-inner { grid-template-columns: 1fr; gap: 1.5rem; width: min(100% - 1.5rem, 36rem); padding: 6rem 0.5rem 1rem; text-align: center; }
		.hero-copy { order: 2; }
		.hero-portrait-wrap { order: 1; }
		.hero-portrait { width: min(15rem, 58vw); border-width: 0.35rem; padding: 0.35rem; }
		.hero-portrait-wrap :global(.music-player-compact) { width: min(19rem, 82vw); }
		.hero-copy h1 { justify-content: center; font-size: 2.5rem; }
		.hero-copy h1 :global(.hero-heart) { width: 1.7rem; height: 1.7rem; }
		.hero-bio { margin: 0.65rem 0 1rem; font-size: 1rem; }
		.hero-tags, .hero-socials { justify-content: center; }
		.hero-socials { margin-top: 1rem; }
		.hero-bottom { padding-bottom: 0.75rem; }
		.hero-note-one { left: 7%; top: 16%; }
		.hero-note-two { left: auto; right: 10%; top: 23%; }
		.hero-spark-one { right: 5%; top: 37%; }
		.hero-spark-two { left: 6%; bottom: 25%; }
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-socials .hero-social-link, .hero-portrait, .hero-copy h1 span, .hero-quote, .hero-quote button { transition: none; }
	}
</style>
