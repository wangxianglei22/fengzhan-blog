---
import { Icon } from "astro-icon/components";
import { navBarConfig, profileConfig, siteConfig } from "../config";
import { LinkPresets } from "../constants/link-presets";
import { LinkPreset, type NavBarLink } from "../types/config";
import { url } from "../utils/url-utils";
import LightDarkSwitch from "./LightDarkSwitch.svelte";
import Search from "./Search.svelte";
import DisplaySettings from "./widget/DisplaySettings.svelte";
import NavMenuPanel from "./widget/NavMenuPanel.astro";
import ImageWrapper from "./misc/ImageWrapper.astro";

const className = Astro.props.class;

let links: NavBarLink[] = navBarConfig.links.map(
	(item: NavBarLink | LinkPreset): NavBarLink => {
		if (typeof item === "number") {
			return LinkPresets[item];
		}
		return item;
	},
);
---
<div id="navbar" class="z-50 onload-animation">
    <div class:list={[className, "navbar-shell"]}>
        <a href={url('/')} class="navbar-pill navbar-brand" aria-label={`${siteConfig.title} 首页`}>
            <span class="navbar-avatar"><ImageWrapper src={profileConfig.avatar || ""} alt="" /></span>
            <span>{siteConfig.title}</span>
        </a>
        <nav class="navbar-pill navbar-links" aria-label="主导航">
            {links.map((l) => {
                return <a aria-label={l.name} href={l.external ? l.url : url(l.url)} target={l.external ? "_blank" : null}
                          rel={l.external ? "noopener noreferrer" : null}
                          class="navbar-link"
                >
                    <div class="flex items-center">
                        {l.name}
                        {l.external && <Icon name="fa6-solid:arrow-up-right-from-square" class="text-[0.875rem] transition -translate-y-[1px] ml-1 text-black/[0.2] dark:text-white/[0.2]"></Icon>}
                    </div>
                </a>;
            })}
        </nav>
        <div class="navbar-pill navbar-tools">
            <!--<SearchPanel client:load>-->
            <Search client:only="svelte"></Search>
            {!siteConfig.themeColor.fixed && (
                    <button aria-label="Display Settings" title="外观设置" class="navbar-tool" id="display-settings-switch">
                        <Icon name="material-symbols:palette-outline" class="text-[1.25rem]"></Icon>
                    </button>
            )}
            <LightDarkSwitch client:load></LightDarkSwitch>
            <button aria-label="菜单" title="菜单" name="Nav Menu" class="navbar-tool mobile-menu" id="nav-menu-switch">
                <Icon name="material-symbols:menu-rounded" class="text-[1.25rem]"></Icon>
            </button>
        </div>
        <NavMenuPanel links={links}></NavMenuPanel>
        <DisplaySettings client:load></DisplaySettings>
    </div>
</div>

<style>
    .navbar-shell {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        max-width: var(--page-width);
        min-height: 4.5rem;
        margin: 0 auto;
        padding: 0 1rem;
        border: 1px solid transparent;
        border-radius: 999px;
        transition: background 220ms ease, border-color 220ms ease, box-shadow 220ms ease, gap 220ms ease, padding 220ms ease;
    }
    .navbar-pill {
        display: flex;
        align-items: center;
        border: 1px solid color-mix(in srgb, var(--deep-text) 7%, transparent);
        border-radius: 999px;
        background: color-mix(in srgb, var(--card-bg) 78%, transparent);
        box-shadow: 0 0.45rem 1.5rem #26363d12;
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
    }
    .navbar-brand {
        flex: 0 0 auto;
        gap: 0.55rem;
        min-height: 3.25rem;
        padding: 0.35rem 1.1rem 0.35rem 0.72rem;
        color: var(--primary);
        font-size: 1rem;
        font-weight: 800;
        text-decoration: none;
        transition: transform 180ms ease, box-shadow 180ms ease;
    }
    .navbar-avatar {
        display: block;
        width: 2.35rem;
        aspect-ratio: 1;
        overflow: hidden;
        border: 2px solid color-mix(in srgb, white 90%, transparent);
        border-radius: 50%;
        background: var(--btn-regular-bg);
        transition: transform 220ms ease;
    }
    .navbar-avatar :global(> div) { width: 100%; height: 100%; }
    .navbar-avatar :global(img) { width: 100%; height: 100%; object-fit: cover; }
    .navbar-brand:hover, .navbar-brand:focus-visible { transform: translateY(-2px); box-shadow: 0 0.65rem 1.6rem #26363d1c; }
    .navbar-brand:hover .navbar-avatar, .navbar-brand:focus-visible .navbar-avatar { transform: rotate(-8deg) scale(1.06); }
    .navbar-links { justify-content: center; gap: 0.15rem; padding: 0.35rem; flex: 0 1 auto; min-width: 0; }
    .navbar-link {
        display: flex;
        align-items: center;
        min-height: 2.7rem;
        padding: 0 0.9rem;
        border-radius: 999px;
        color: var(--deep-text);
        font-size: 0.92rem;
        font-weight: 750;
        text-decoration: none;
        white-space: nowrap;
        transition: transform 160ms ease, color 160ms ease, background 160ms ease;
    }
    .navbar-link:hover, .navbar-link:focus-visible { transform: translateY(-2px); color: var(--primary); background: color-mix(in srgb, var(--primary) 10%, transparent); }
    .navbar-link:active { transform: scale(0.97); }
    /* 浮层面板（搜索/外观设置/菜单）以本容器为定位基准，
       否则会向上找到 #navbar-wrapper（fixed），在移动端被挤成窄条。 */
    .navbar-tools { position: relative; flex: 0 0 auto; gap: 0.1rem; min-height: 3.25rem; padding: 0.2rem 0.45rem; }
    .navbar-tool {
        display: grid;
        place-items: center;
        width: 2.6rem;
        aspect-ratio: 1;
        border: 0;
        border-radius: 50%;
        background: transparent;
        color: var(--deep-text);
        cursor: pointer;
        transition: transform 160ms ease, color 160ms ease, background 160ms ease;
    }
    .navbar-tool:hover, .navbar-tool:focus-visible { transform: translateY(-2px); color: var(--primary); background: color-mix(in srgb, var(--primary) 10%, transparent); }
    .navbar-tool:active { transform: scale(0.94); }
    .mobile-menu { display: none; }
    #navbar.navbar-scrolled .navbar-shell {
        gap: 0.35rem;
        padding: 0.35rem 0.65rem;
        border-color: color-mix(in srgb, var(--deep-text) 8%, transparent);
        background: var(--page-bg);
        box-shadow: 0 0.5rem 1.8rem #26363d1c;
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
    }
    #navbar.navbar-scrolled .navbar-pill {
        border-color: transparent;
        background: transparent;
        box-shadow: none;
        backdrop-filter: none;
        -webkit-backdrop-filter: none;
    }
    #navbar.navbar-scrolled .navbar-brand:hover,
    #navbar.navbar-scrolled .navbar-brand:focus-visible { box-shadow: none; }
    @media (max-width: 767px) {
        .navbar-shell { gap: 0.4rem; min-height: 4rem; padding: 0 0.5rem; }
        #navbar.navbar-scrolled .navbar-shell { gap: 0.2rem; min-height: 3.75rem; padding: 0.2rem 0.45rem; }
        .navbar-brand { min-height: 2.8rem; padding: 0.3rem 0.9rem 0.3rem 0.62rem; font-size: 0.9rem; }
        .navbar-avatar { width: 2rem; }
        .navbar-links { display: none; }
        .navbar-tools { min-height: 2.8rem; padding: 0.1rem 0.25rem; }
        .navbar-tool { width: 2.25rem; }
        .mobile-menu { display: grid; }
    }
    /* 平板与手机横屏：宽度够放下导航链接，但放不下完整字号，
       收窄间距与字号，避免链接文字被挤成竖排或换行。 */
    @media (min-width: 768px) and (max-width: 1279px) {
        .navbar-shell { gap: 0.5rem; padding: 0 0.65rem; }
        .navbar-links { gap: 0; padding: 0.25rem; }
        .navbar-link { min-height: 2.4rem; padding: 0 0.5rem; font-size: 0.8rem; }
        .navbar-brand { min-height: 2.9rem; padding: 0.3rem 0.75rem 0.3rem 0.55rem; font-size: 0.92rem; }
        .navbar-avatar { width: 2.05rem; }
        .navbar-tools { min-height: 2.9rem; padding: 0.15rem 0.3rem; }
        .navbar-tool { width: 2.3rem; }
    }
    @media (min-width: 768px) and (max-width: 1023px) {
        .navbar-link { font-size: 0.76rem; padding: 0 0.42rem; }
        .navbar-brand { font-size: 0.88rem; }
    }
    @media (prefers-reduced-motion: reduce) {
        .navbar-shell, .navbar-brand, .navbar-avatar, .navbar-link, .navbar-tool { transition: none; }
    }
</style>

<script>
// 注意：主题切换由 LightDarkSwitch.svelte 的 toggleScheme 负责。
// 这里不再重复监听 #scheme-switch，否则一次点击会被处理两次，表现为「点了没反应」。

// swup 切换页面时会重新执行页面里的所有 <script>，如果这里不加守卫，
// document 上的 click / scroll 监听器会一次次叠加：
// 点一次「外观设置」被 toggle 两次（打开又关上），看起来就是按钮失灵。
// 用 window 上的标记保证全局只绑定一次。
const navbarBoundKey = "__fengzhanNavbarBound";
const globalScope = window as typeof window & { __fengzhanNavbarBound?: boolean };
if (!globalScope[navbarBoundKey]) {
	globalScope[navbarBoundKey] = true;

	document.addEventListener("click", (event) => {
		if (!(event.target instanceof Element)) return;
		const target = event.target;

		const settingsButton = target.closest("#display-settings-switch");
		if (settingsButton) {
			event.stopPropagation();
			document.getElementById("display-setting")?.classList.toggle("float-panel-closed");
		}

		const menuButton = target.closest("#nav-menu-switch");
		if (menuButton) {
			event.stopPropagation();
			document.getElementById("nav-menu-panel")?.classList.toggle("float-panel-closed");
		}

		if (target.closest("#nav-menu-panel a")) {
			document.getElementById("nav-menu-panel")?.classList.add("float-panel-closed");
		}
		if (target.closest("#search-panel a")) {
			document.getElementById("search-panel")?.classList.add("float-panel-closed");
		}
	});

	function updateNavbarScrollState() {
		const navbar = document.getElementById("navbar");
		if (!navbar) return;
		// 取最可靠的滚动值：部分浏览器在旋转后会重置 window.scrollY，
		// 但 documentElement / body 上仍保留真实位置。
		const y = window.scrollY || document.documentElement.scrollTop || document.body.scrollTop || 0;
		navbar.classList.toggle("navbar-scrolled", y > 32);
	}

	updateNavbarScrollState();
	window.addEventListener("scroll", updateNavbarScrollState, { passive: true });
	document.addEventListener("scroll", updateNavbarScrollState, { passive: true });

	// 旋转屏幕 / 改变窗口尺寸后，滚动位置可能被浏览器钳制或恢复，
	// 却没有触发 scroll 事件，导致顶栏停留在「合并式」而回不到「分离式」。
	// 这里在 resize 与 orientationchange 后主动重算一次。
	window.addEventListener("resize", updateNavbarScrollState, { passive: true });
	window.addEventListener("orientationchange", () => {
		updateNavbarScrollState();
		setTimeout(updateNavbarScrollState, 120);
		setTimeout(updateNavbarScrollState, 400);
	}, { passive: true });

	// 旋转时收起所有浮层，避免手机端的搜索面板在横屏下继续悬浮遮挡页面。
	function closeFloatingPanels() {
		document.querySelectorAll(".float-panel").forEach((panel) => {
			panel.classList.add("float-panel-closed");
		});
	}
	window.addEventListener("orientationchange", () => {
		closeFloatingPanels();
	}, { passive: true });
}
</script>

{import.meta.env.PROD && <script is:inline define:vars={{scriptUrl: url('/pagefind/pagefind.js')}}>
async function loadPagefind() {
    try {
        const response = await fetch(scriptUrl, { method: 'HEAD' });
        if (!response.ok) {
            throw new Error(`Pagefind script not found: ${response.status}`);
        }

        const pagefind = await import(scriptUrl);

        await pagefind.options({
            excerptLength: 20
        });

        window.pagefind = pagefind;

        document.dispatchEvent(new CustomEvent('pagefindready'));
        console.log('Pagefind loaded and initialized successfully, event dispatched.');
    } catch (error) {
        console.error('Failed to load Pagefind:', error);
        window.pagefind = {
            search: () => Promise.resolve({ results: [] }),
            options: () => Promise.resolve(),
        };
        document.dispatchEvent(new CustomEvent('pagefindloaderror'));
        console.log('Pagefind load error, event dispatched.');
    }
}

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadPagefind);
} else {
    loadPagefind();
}
</script>}
