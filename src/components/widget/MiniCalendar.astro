---
import { Icon } from "astro-icon/components";
import { getSortedPostsList } from "../../utils/content-utils";

const today = new Date();
const monthLabel = `${today.getFullYear()} 年 ${today.getMonth() + 1} 月`;
const posts = await getSortedPostsList();
const postsThisMonth = posts.filter((post) => {
    const published = new Date(post.data.published);
    return published.getFullYear() === today.getFullYear() && published.getMonth() === today.getMonth();
}).length;
const nextNewYear = new Date(today.getFullYear() + 1, 0, 1);
const daysToNewYear = Math.max(0, Math.ceil((nextNewYear.getTime() - new Date(today.getFullYear(), today.getMonth(), today.getDate()).getTime()) / 86400000));
const weekdays = ["日", "一", "二", "三", "四", "五", "六"];
---

<mini-calendar class="calendar-widget card-base" aria-labelledby="calendar-title" data-posts-this-month={postsThisMonth}>
    <div class="widget-topline">
        <div class="widget-title"><span class="widget-icon"><Icon name="material-symbols:calendar-month-rounded" /></span><h2 id="calendar-title">日历</h2></div>
        <span class="widget-index"><i aria-hidden="true"></i><i aria-hidden="true"></i><i aria-hidden="true"></i><b>02</b></span>
    </div>
    <div class="calendar-heading"><button aria-label="上个月" data-calendar-prev type="button"><Icon name="material-symbols:chevron-left-rounded" /></button><strong data-calendar-label>{monthLabel}</strong><button aria-label="下个月" data-calendar-next type="button"><Icon name="material-symbols:chevron-right-rounded" /></button></div>
    <div class="calendar-grid calendar-weekdays" aria-hidden="true">{weekdays.map((day) => <span>{day}</span>)}</div>
    <div class="calendar-grid calendar-days" data-calendar-days></div>
    <div class="calendar-legend"><span><i class="legend-dot legend-today"></i>今天</span><span><i class="legend-dot legend-festival"></i>节日</span><span>农历 · 节日</span></div>
    <div class="calendar-footer"><span data-calendar-remaining>距离 元旦 还有 {daysToNewYear} 天</span><strong data-calendar-today>本月 {postsThisMonth} 篇</strong></div>
</mini-calendar>

<script is:inline>
    (() => {
        const lunarDayNames = ["", "初一", "初二", "初三", "初四", "初五", "初六", "初七", "初八", "初九", "初十", "十一", "十二", "十三", "十四", "十五", "十六", "十七", "十八", "十九", "二十", "廿一", "廿二", "廿三", "廿四", "廿五", "廿六", "廿七", "廿八", "廿九", "三十"];
        const solarFestivals = { "1-1": "元旦", "2-14": "情人节", "3-8": "妇女节", "4-5": "清明", "5-1": "劳动节", "5-4": "青年节", "6-1": "儿童节", "9-10": "教师节", "10-1": "国庆节", "12-25": "圣诞" };
        const lunarFestivals = { "1-1": "春节", "1-15": "元宵", "2-2": "龙抬头", "5-5": "端午", "7-7": "七夕", "7-15": "中元", "8-15": "中秋", "9-9": "重阳", "12-8": "腊八", "12-23": "小年" };
        const lunarFormatter = new Intl.DateTimeFormat("zh-CN-u-ca-chinese", { month: "numeric", day: "numeric" });

        const getLunar = (date) => {
            try {
                const parts = lunarFormatter.formatToParts(date);
                const month = Number(parts.find((part) => part.type === "month")?.value || 0);
                const day = Number(parts.find((part) => part.type === "day")?.value || 0);
                return { month, day, label: lunarDayNames[day] || `${day}日` };
            } catch {
                return { month: 0, day: 0, label: "" };
            }
        };

        const renderCalendar = (calendar, viewDate) => {
            const daysElement = calendar.querySelector("[data-calendar-days]");
            const labelElement = calendar.querySelector("[data-calendar-label]");
            const remainingElement = calendar.querySelector("[data-calendar-remaining]");
            const todayElement = calendar.querySelector("[data-calendar-today]");
            if (!daysElement || !labelElement) return;
            const year = viewDate.getFullYear();
            const month = viewDate.getMonth();
            const firstDay = new Date(year, month, 1).getDay();
            const daysInMonth = new Date(year, month + 1, 0).getDate();
            const current = new Date();
            const isCurrentMonth = current.getFullYear() === year && current.getMonth() === month;
            const cells = [];
            const previousMonthDays = new Date(year, month, 0).getDate();
            for (let index = firstDay - 1; index >= 0; index -= 1) {
                const day = previousMonthDays - index;
                cells.push({ day, date: new Date(year, month - 1, day), outside: true });
            }
            for (let day = 1; day <= daysInMonth; day += 1) {
                cells.push({ day, date: new Date(year, month, day), outside: false });
            }
            while (cells.length < 42) {
                const day = cells.length - firstDay - daysInMonth + 1;
                cells.push({ day, date: new Date(year, month + 1, day), outside: true });
            }

                    labelElement.textContent = `${year} 年 ${month + 1} 月`;
            daysElement.innerHTML = cells.map((cell) => {
                const { day, date, outside } = cell;
                const lunar = getLunar(date);
                const solarKey = `${date.getMonth() + 1}-${day}`;
                const lunarKey = `${lunar.month}-${lunar.day}`;
                const festival = solarFestivals[solarKey] || lunarFestivals[lunarKey] || "";
                const isToday = !outside && isCurrentMonth && day === current.getDate();
                const classes = `calendar-day${outside ? " outside" : ""}${isToday ? " today" : ""}${festival ? " has-festival" : ""}`;
                const label = `${date.getFullYear()}年${date.getMonth() + 1}月${day}日，${lunar.label}${festival ? `，${festival}` : ""}`;
                return `<span class="${classes}" aria-label="${label}"><b class="calendar-day-number">${day}</b><small class="calendar-day-lunar">${lunar.label}</small>${festival ? `<em class="calendar-day-festival">${festival}</em>` : ""}</span>`;
            }).join("");

                    const newYear = new Date(current.getFullYear() + 1, 0, 1);
                    const daysToNewYear = Math.max(0, Math.ceil((newYear.getTime() - new Date(current.getFullYear(), current.getMonth(), current.getDate()).getTime()) / 86400000));
                    if (remainingElement) remainingElement.textContent = `距离 元旦 还有 ${daysToNewYear} 天`;
                    if (todayElement) todayElement.textContent = `本月 ${calendar.dataset.postsThisMonth || "0"} 篇`;
        };

        const setupCalendar = () => {
            document.querySelectorAll("mini-calendar").forEach((calendar) => {
                const savedMonth = calendar.dataset.calendarMonth;
                const viewDate = savedMonth ? new Date(`${savedMonth}-01T00:00:00`) : new Date();
                calendar.dataset.calendarMonth = `${viewDate.getFullYear()}-${String(viewDate.getMonth() + 1).padStart(2, "0")}`;
                calendar.dataset.initialized = "true";
                renderCalendar(calendar, viewDate);
            });
        };

        if (!document.documentElement.dataset.calendarNavigation) {
            document.documentElement.dataset.calendarNavigation = "true";
            document.addEventListener("click", (event) => {
                const target = event.target instanceof Element ? event.target : null;
                const button = target?.closest("mini-calendar [data-calendar-prev], mini-calendar [data-calendar-next]");
                if (!button) return;
                const calendar = button.closest("mini-calendar");
                if (!calendar) return;
                const currentMonth = calendar.dataset.calendarMonth || new Date().toISOString().slice(0, 7);
                const viewDate = new Date(`${currentMonth}-01T00:00:00`);
                viewDate.setMonth(viewDate.getMonth() + (button.hasAttribute("data-calendar-prev") ? -1 : 1));
                calendar.dataset.calendarMonth = `${viewDate.getFullYear()}-${String(viewDate.getMonth() + 1).padStart(2, "0")}`;
                renderCalendar(calendar, viewDate);
            });
        }
        setupCalendar();
        document.addEventListener("astro:page-load", setupCalendar);
    })();
</script>

<style>
    .calendar-widget { padding: 1.1rem 1.05rem 0.85rem; border: 1px solid color-mix(in srgb, var(--deep-text) 12%, transparent); border-radius: 1.1rem; background: color-mix(in srgb, var(--card-bg) 88%, #eaf6fb); box-shadow: 0 0.8rem 2rem color-mix(in srgb, var(--deep-text) 4%, transparent); }
    .widget-topline, .widget-title { display: flex; align-items: center; }
    .widget-topline { justify-content: space-between; padding-bottom: 0.8rem; border-bottom: 1px dashed color-mix(in srgb, var(--deep-text) 15%, transparent); }
    .widget-title { gap: 0.7rem; }
    .widget-title h2 { margin: 0; color: var(--deep-text); font-size: 1.2rem; font-weight: 800; letter-spacing: 0.03em; }
    .widget-icon { display: grid; place-items: center; width: 2.15rem; aspect-ratio: 1; border: 1px solid color-mix(in srgb, var(--primary) 22%, transparent); border-radius: 0.65rem; color: var(--primary); background: color-mix(in srgb, var(--primary) 10%, transparent); }
    .widget-icon :global(svg) { width: 1.15rem; height: 1.15rem; }
    .widget-index { display: inline-flex; align-items: center; gap: 0.28rem; padding: 0; color: color-mix(in srgb, var(--primary) 65%, var(--deep-text)); }
    .widget-index i { display: block; width: 0.34rem; height: 0.34rem; border-radius: 50%; background: color-mix(in srgb, var(--primary) 30%, transparent); }
    .widget-index i:nth-child(2) { opacity: 0.75; }
    .widget-index i:nth-child(3) { opacity: 0.55; }
    .widget-index b { margin-left: 0.12rem; padding: 0.16rem 0.4rem; border: 1px solid color-mix(in srgb, var(--primary) 18%, transparent); border-radius: 0.42rem; color: color-mix(in srgb, var(--primary) 70%, var(--deep-text)); background: color-mix(in srgb, var(--primary) 7%, transparent); font-size: 0.65rem; font-weight: 750; }
    .calendar-heading { display: flex; align-items: center; justify-content: space-between; margin: 0.85rem 0 0.42rem; color: var(--deep-text); }
    .calendar-heading button { display: grid; place-items: center; width: 1.55rem; height: 1.55rem; border: 0; border-radius: 50%; color: color-mix(in srgb, var(--primary) 75%, var(--deep-text)); background: transparent; cursor: pointer; transition: background 150ms ease, transform 150ms ease; }
    .calendar-heading button:hover { background: color-mix(in srgb, var(--primary) 10%, transparent); transform: scale(1.08); }
    .calendar-heading :global(svg) { width: 0.95rem; height: 0.95rem; }
    .calendar-heading strong { display: inline-flex; align-items: center; color: color-mix(in srgb, var(--deep-text) 86%, var(--primary)); font-size: 0.96rem; font-weight: 800; letter-spacing: 0.03em; }
    .calendar-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 0.12rem 0.18rem; text-align: center; }
    .calendar-weekdays { margin-bottom: 0.25rem; color: color-mix(in srgb, var(--primary) 48%, var(--deep-text)); font-size: 0.61rem; font-weight: 700; line-height: 1.5; }
    :global(.calendar-days) { gap: 0.1rem 0.18rem; }
    :global(.calendar-day) { display: grid; place-items: center; align-content: center; min-width: 0; min-height: 2.55rem; padding: 0.12rem 0.05rem; border: 1px solid transparent; border-radius: 0.62rem; color: color-mix(in srgb, var(--deep-text) 78%, var(--primary)); cursor: default; transition: background 150ms ease, border-color 150ms ease, transform 150ms ease, color 150ms ease; }
    :global(.calendar-day:not(.outside):hover) { border-color: color-mix(in srgb, var(--primary) 25%, transparent); background: color-mix(in srgb, var(--primary) 7%, transparent); transform: translateY(-1px); }
    :global(.calendar-day.outside) { color: color-mix(in srgb, var(--deep-text) 25%, transparent); }
    :global(.calendar-day-number) { font-size: 0.75rem; font-weight: 750; line-height: 1.1; }
    :global(.calendar-day-lunar) { min-height: 0.68rem; overflow: hidden; color: color-mix(in srgb, var(--deep-text) 44%, transparent); font-size: 0.48rem; line-height: 1; white-space: nowrap; }
    :global(.calendar-day-festival) { max-width: 100%; overflow: hidden; color: color-mix(in srgb, var(--primary) 82%, var(--deep-text)); font-size: 0.46rem; font-style: normal; font-weight: 750; line-height: 1; text-overflow: ellipsis; white-space: nowrap; }
    :global(.calendar-day.today) { border-color: var(--primary); color: var(--primary); background: color-mix(in srgb, var(--primary) 8%, transparent); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--primary) 12%, transparent); }
    :global(.calendar-day.today .calendar-day-number) { font-weight: 850; }
    :global(.calendar-day.today .calendar-day-lunar) { color: color-mix(in srgb, var(--primary) 72%, var(--deep-text)); }
    :global(.calendar-day.has-festival .calendar-day-number) { color: color-mix(in srgb, var(--primary) 82%, var(--deep-text)); }
    .calendar-legend { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 0.65rem; margin-top: 0.5rem; color: color-mix(in srgb, var(--deep-text) 46%, transparent); font-size: 0.57rem; }
    .calendar-legend span { display: inline-flex; align-items: center; gap: 0.2rem; }
    .legend-dot { width: 0.4rem; aspect-ratio: 1; border-radius: 50%; }
    .legend-today { background: var(--primary); }
    .legend-festival { background: color-mix(in srgb, var(--primary) 58%, white); }
    .calendar-footer { display: flex; align-items: center; justify-content: space-between; gap: 0.4rem; margin-top: 0.6rem; padding-top: 0.62rem; border-top: 1px dashed color-mix(in srgb, var(--deep-text) 15%, transparent); color: color-mix(in srgb, var(--deep-text) 58%, transparent); font-size: 0.64rem; }
    .calendar-footer strong { padding: 0.28rem 0.48rem; border-radius: 0.5rem; color: color-mix(in srgb, var(--primary) 82%, var(--deep-text)); background: color-mix(in srgb, var(--primary) 10%, transparent); font-size: 0.63rem; font-weight: 750; white-space: nowrap; }
    @media (max-width: 767px) {
        .calendar-widget { padding-inline: 0.9rem; }
        :global(.calendar-day) { min-height: 2.42rem; }
        :global(.calendar-day-lunar) { font-size: 0.45rem; }
        :global(.calendar-day-festival) { font-size: 0.42rem; }
    }
</style>
