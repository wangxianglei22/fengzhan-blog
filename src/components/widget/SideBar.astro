---
import type { MarkdownHeading } from "astro";
import Categories from "./Categories.astro";
import DailyNotebook from "./DailyNotebook.astro";
import MiniCalendar from "./MiniCalendar.astro";
import Profile from "./Profile.astro";
import SiteStats from "./SiteStats.astro";
import Tag from "./Tags.astro";

interface Props {
	class?: string;
	headings?: MarkdownHeading[];
	homeHero?: boolean;
}

const { class: className, homeHero = false } = Astro.props;
---
<div id="sidebar" class:list={[className, "flex w-full flex-col gap-4"]}>
    {!homeHero && <Profile></Profile>}
    {homeHero && <DailyNotebook />}
    {homeHero && <MiniCalendar />}
    <div id="sidebar-sticky" class="transition-all duration-700 flex flex-col w-full gap-4 top-4 sticky">
        <Categories class="onload-animation" style="animation-delay: 150ms"></Categories>
        <Tag class="onload-animation" style="animation-delay: 200ms"></Tag>
        {homeHero && <SiteStats />}
    </div>
</div>
