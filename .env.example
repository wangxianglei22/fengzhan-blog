# 前台没有必填环境变量。
# 后台通过 Cloudflare Pages Functions 的服务端变量运行。
# 在 Cloudflare 控制台配置以下变量，敏感值保存为 Secret。
# 不要使用 PUBLIC_ 或 VITE_ 前缀暴露服务端密钥。
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# 可选，仅用于管理员信息展示。
ADMIN_EMAIL=

# ---- 站点统计（Cloudflare Web Analytics）----
# PUBLIC_ 前缀的变量会打进前端构建产物，仅用于公开标识，不要放密钥。
# PUBLIC_CF_BEACON_TOKEN：Web Analytics 的站点 token，可在 Pages → Metrics → Web Analytics 面板拿到。
# 不填则不注入统计脚本，前台「站点统计」只显示文章数等本地数据。
PUBLIC_CF_BEACON_TOKEN=

# 下面三个是服务端变量，供 functions/api/stats.ts 调 Cloudflare GraphQL API 使用。
# CF_ACCOUNT_ID：账号 ID。
# CF_API_TOKEN：API Token，权限需要包含 Account → Account Analytics → Read。
# CF_SITE_TAG：Web Analytics 的站点 tag，在面板 URL 里可以看到。
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_SITE_TAG=
